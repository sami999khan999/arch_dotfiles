// Omarchy classic waybar (v3.8), omarchy-* actions swapped for plain tools
{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 27,
  "margin-top": 4,
  "margin-left": 4,
  "margin-right": 4,
  "modules-left": [
    "custom/logo",
    "custom/wsbar",
    "group/wsbuttons",
    "custom/window"
  ],
  "modules-center": [
    "mpris",
    "clock",
    "custom/idle-indicator",
    "custom/notification-silencing-indicator"
  ],
  "modules-right": [
    "custom/wsgroups",
    "custom/codesync",
    "custom/keys",
    "group/tray-expander",
    "bluetooth",
    "network",
    "pulseaudio",
    "group/stats",
    "custom/power"
  ],
  "group/stats": {
    "orientation": "inherit",
    "modules": [
      "cpu",
      "memory",
      "temperature",
      "battery"
    ]
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "System menu (Super + Escape)",
    "on-click": "~/.config/hypr/scripts/power-menu.sh"
  },
  // workspace buttons: hyprland/workspaces' click sends a legacy dispatch the Lua config rejects,
  // so each button is a custom module that reads its state from wsbar.py and dispatches in Lua
  // code backup (~/code -> HDD): status icon, details on hover, panel on click
  "custom/codesync": {
    "exec": "~/.local/bin/codesync bar",
    "return-type": "json",
    "interval": 20,
    "signal": 11,
    "on-click": "~/.config/hypr/scripts/tui.sh ~/.config/hypr/scripts/syncpanel.py",
    "on-click-right": "~/.local/bin/codesync now",
    "on-click-middle": "~/.local/bin/codesync toggle"
  },
  "custom/wsbar": {
    "exec": "~/.config/hypr/scripts/wsbar.py",
    "tooltip": false
  },
  "group/wsbuttons": {
    "orientation": "inherit",
    "modules": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10"]
  },
  "custom/ws1": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/1.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"1\" })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws2": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/2.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"2\" })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws3": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/3.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"3\" })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws4": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/4.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"4\" })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws5": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/5.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"5\" })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws6": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/6.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"6\" })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws7": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/7.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"7\" })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws8": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/8.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"8\" })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws9": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/9.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"9\" })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws10": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/10.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"10\" })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/window": {
    "exec": "~/.config/hypr/scripts/wintitle.py",
    "return-type": "json",
    "escape": true
  },
  "mpris": {
    "format": "{status_icon}",
    "tooltip-format": "{title}\n{artist}\n\n{player} · {status}\nclick: play/pause · scroll: next/prev",
    "format-stopped": "",
    "status-icons": {
      "playing": "󰏤",
      "paused": "󰐊"
    },
    "max-length": 40,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "memory": {
    "interval": 5,
    "format": "󰘚 {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
    "on-click": "~/.config/hypr/scripts/tui.sh ~/.config/hypr/scripts/sysmon.py"
  },
  "temperature": {
    "interval": 5,
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "󰔏 {temperatureC}°",
    "tooltip-format": "CPU package {temperatureC}°C"
  },
  "cpu": {
    "interval": 5,
    "format": "󰍛 {usage}%",
    "states": {
      "critical": 90
    },
    "on-click": "~/.config/hypr/scripts/tui.sh ~/.config/hypr/scripts/sysmon.py"
  },
  "clock": {
    "format": "<span color='#565f89'>{:L%a %d %b</span>  <b>%H:%M</b>}",
    "format-alt": "{:L%A %d %B %Y  W%V}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "months": "<span color='#c0caf5'><b>{}</b></span>",
        "weekdays": "<span color='#565f89'>{}</span>",
        "weeks": "<span color='#3b4261'>{}</span>",
        "today": "<span color='#6b8fe0'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_down",
      "on-scroll-down": "shift_up"
    }
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)",
    "tooltip-format-ethernet": "Connected",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "~/.config/hypr/scripts/tui.sh nmtui"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "~/.config/hypr/scripts/power-menu.sh",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "~/.config/hypr/scripts/tui.sh bluetui"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "on-click": "~/.config/hypr/scripts/tui.sh wiremix",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "tray"
    ]
  },
  "custom/wsgroups": {
    "exec": "~/.local/bin/wsgroups bar",
    "return-type": "json",
    "escape": true,
    "on-click": "~/.config/hypr/scripts/tui.sh ~/.local/bin/wsgroups"
  },
  "custom/keys": {
    "format": "",
    "tooltip-format": "Shortcuts (Super + K)",
    "on-click": "~/.config/hypr/scripts/tui.sh ~/.config/hypr/scripts/keys.py"
  },
  "custom/expand-icon": {
    "format": "",
    "tooltip": false,
    "on-scroll-up": "",
    "on-scroll-down": "",
    "on-scroll-left": "",
    "on-scroll-right": ""
  },
  "custom/idle-indicator": {
    "on-click": "~/.config/hypr/scripts/toggle.sh idle",
    "exec": "~/.config/hypr/scripts/indicator.sh idle",
    "signal": 9,
    "interval": 10,
    "return-type": "json"
  },
  "custom/notification-silencing-indicator": {
    "on-click": "~/.config/hypr/scripts/toggle.sh notifications",
    "exec": "~/.config/hypr/scripts/indicator.sh notifications",
    "signal": 10,
    "interval": 10,
    "return-type": "json"
  },
  "tray": {
    "icon-size": 12,
    "spacing": 17
  },
  "custom/logo": {
    "format": "",
    "on-click": "walker",
    "on-click-right": "~/.config/hypr/scripts/power-menu.sh",
    "tooltip-format": "Apps: Super + Space\nSystem: Super + Escape"
  }
}
