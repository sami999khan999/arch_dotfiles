#!/usr/bin/env bash
# Sync ~/dotfiles with GitHub: save local changes, pull the other PC's, push, relink.
#   dotsync                 # commit message: "sync from <host> <date>"
#   dotsync "what changed"  # your own message
set -euo pipefail
cd "$HOME/dotfiles"

# commit as the repo owner even on a fresh machine with no git identity
git config user.name  >/dev/null || git config user.name  "sami"
git config user.email >/dev/null || git config user.email "sami999khan999@gmail.com"

git add -A
if ! git diff --cached --quiet; then
  git commit -q -m "${1:-sync from $(uname -n) $(date '+%Y-%m-%d %H:%M')}"
  echo "saved local changes"
fi

if ! git pull --rebase -q; then
  echo "Both PCs changed the same lines. Fix the files git lists above, then run:"
  echo "  cd ~/dotfiles && git add -A && git rebase --continue && dotsync"
  exit 1
fi
git push -q
./setup/install.sh | grep -Ev '^  ok|^$|^==|^Done\.|^\(Without' || true   # link anything new
hyprctl reload >/dev/null 2>&1 || true
echo "dotfiles synced with GitHub"
