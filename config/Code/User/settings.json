{
  // ─── Appearance ───────────────────────────────────────────────────────────
  "workbench.colorTheme": "Tokyo Night",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.preferredHighContrastColorTheme": "Learn with Sumit - Peace of the eye",
  "window.menuBarVisibility": "classic",
  "workbench.sideBar.location": "right",
  "workbench.panel.defaultLocation": "left",
  "workbench.experimental.modernUI": true,

  // ─── Flat single-surface look ─────────────────────────────────────────────
  // Tokyo Night paints the editor #1a1b26 but every piece of chrome #16161e,
  // which is the seam between the code space and the sidebars. This drops the
  // editor onto the chrome colour and blanks the structural borders so the
  // window reads as one surface. Popup/notification borders are deliberately
  // left alone — without them those widgets float with no edge.
  // Scoped to Tokyo Night so other themes are untouched.
  "workbench.colorCustomizations": {
    "[Tokyo Night]": {
      "editor.background": "#16161e",
      "editorPane.background": "#16161e",
      "notebook.editorBackground": "#16161e",
      "multiDiffEditor.background": "#16161e",
      "multiDiffEditor.headerBackground": "#16161e",
      "multiDiffEditor.border": "#16161e",

      "editorGroup.border": "#16161e",
      "editorGroupHeader.border": "#16161e",
      "editorGroupHeader.tabsBorder": "#16161e",
      "tab.border": "#16161e",
      "sideBar.border": "#16161e",
      "sideBarSectionHeader.border": "#16161e",
      "panel.border": "#16161e",
      "statusBar.border": "#16161e",
      "titleBar.border": "#16161e",

      // Inside the terminal panel: the divider beside the tab list and
      // between split panes. The theme leaves these unset, so they fell
      // back to a default instead of following panel.border.
      "terminal.border": "#16161e",
      "panelSection.border": "#16161e",
      "panelSectionHeader.border": "#16161e",
      "panelInput.border": "#16161e",

      // Not a border: VS Code paints this translucent black along the
      // edge of a scrolled region, which reads as a dark band where the
      // editor meets the left-docked panel. Fully transparent kills it.
      "scrollbar.shadow": "#00000000",
      "widget.shadow": "#00000000",

      "editorGroup.emptyBackground": "#16161e",
      "panel.dropBorder": "#16161e",

      // The overview ruler sits at the editor's right edge and draws a
      // dark rule down its left side. With the minimap off that strip is
      // fully exposed, which is the line against the sidebar.
      "editorOverviewRuler.border": "#16161e",
      "editorOverviewRuler.background": "#16161e",
      "editorGutter.background": "#16161e",
    },
  },

  // ─── Editor ───────────────────────────────────────────────────────────────
  "editor.fontSize": 18,
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorWidth": 2,

  // ─── Formatting ───────────────────────────────────────────────────────────
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,

  // ─── Files ────────────────────────────────────────────────────────────────
  "files.autoSave": "onFocusChange",

  // ─── Terminal ─────────────────────────────────────────────────────────────
  // Profiles are auto-detected; the old hand-written list only re-declared them.
  "terminal.integrated.defaultProfile.windows": "Windows PowerShell",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorStyleInactive": "line",
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.stickyScroll.maxLineCount": 1,

  // ─── Explorer ─────────────────────────────────────────────────────────────
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  // ─── Git ──────────────────────────────────────────────────────────────────
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "never",

  // ─── Language-specific ────────────────────────────────────────────────────
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
  },
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma",
    "editor.formatOnSave": true,
  },
  "python.terminal.activateEnvironment": false,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.autoSearchPaths": false,
  "C_Cpp.formatting": "vcFormat",

  // ─── Extensions ───────────────────────────────────────────────────────────
  "codeium.enableConfig": {
    "*": true,
    "properties": true,
    "pip-requirements": true,
    "ignore": true,
  },
  "database-client.autoSync": true,
  "quokka.darkTheme.system.decorationAttachmentRenderOptions": {
    "color": "rgb(153, 153, 153)",
    "margin": "1.2em",
  },

  // ─── Misc ─────────────────────────────────────────────────────────────────
  "update.mode": "none",
  "claudeCode.preferredLocation": "panel",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
      "path": "C:\\Users\\waywi\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShell_8wekyb3d8bbwe\\pwsh.exe",
    },
    "Command Prompt": {
      "path": "C:\\WINDOWS\\System32\\cmd.exe",
      "args": [],
      "icon": "terminal-cmd",
    },
    "Git Bash": {
      "source": "Git Bash",
      "icon": "terminal-git-bash",
    },
    "Windows PowerShell": {
      "path": "C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
    },
  },
  "terminal.integrated.fontFamily": "'JetBrainsMono NF', 'CascadiaCode', monospace",
  "git.ignoreRebaseWarning": true,
  "editor.accessibilitySupport": "off",
  "terminal.integrated.tabs.location": "left",

  // Keybindings VS Code handles itself instead of forwarding to the shell.
  //
  // When the terminal has focus, VS Code sends most chords straight through to the
  // shell; only command IDs on this list are intercepted. The list is ADDITIVE to
  // VS Code's built-in defaults (prefix an entry with "-" to drop a default one).
  //
  // Without `workbench.view.explorer` here, ctrl+shift+e from a focused terminal went
  // to PowerShell, which does nothing with it — so the key appeared dead. `runCommands`
  // is what the ctrl+alt+z focus-mode binding dispatches through, and it needs the same
  // treatment for the same reason.
  "terminal.integrated.commandsToSkipShell": [
    "workbench.view.explorer",
    "workbench.action.toggleSidebarVisibility",
    "workbench.action.togglePanel",
    "workbench.action.terminal.toggleTerminal",
    "workbench.action.terminal.focus",
    "runCommands",
    // Same reason: alt+p from a focused terminal was being typed into the shell
    // instead of reaching Audio Cursor's play/pause command.
    "audioCursor.togglePlaybackTerminal",
    "audioCursor.readTerminalSelection",
    // And alt+shift+p (stop): focus is still in the terminal right after alt+p
    // starts reading it, which is exactly when you want to stop.
    "audioCursor.stop",
  ],
  // Lets Audio Cursor mirror terminal selections into its player preview the
  // way editor selections already appear. Side effect: selecting text in a
  // terminal also copies it to the clipboard.
  "terminal.integrated.copyOnSelection": true,
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.md": "markdown-preview-enhanced",
  },
  "audioCursor.voice": "en-US-JennyNeural",
  "audioCursor.highlightWord": true,
  "audioCursor.followCursor": false,
  "audioCursor.rate": 1.1,
  "audioCursor.pitch": 1,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.enableImages": true,
  "claudeCode.hideOnboarding": true,
  "terminal.integrated.initialHint": false,
  "vscodeBrowser.shortcutsUpdated": 1790679526441,
}

