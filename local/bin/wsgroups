#!/usr/bin/env python3
"""wsgroups — one workspace per kind of app, every window full-size (monocle), Alt + N to switch.

  wsgroups                    open (or close) the manager window (Super + Ctrl + G, or click it in waybar)
  wsgroups tui                the same manager in the terminal
  wsgroups focus N            focus window N (1-10) of the current workspace, in the order opened
  wsgroups go N               go to workspace N; launch its apps if none are open there yet
  wsgroups new                open another window of the current workspace's app (Super + N)
  wsgroups launch N|all [-f]  launch a group's programs (-f: even if some are already open;
                              --background: return to the current workspace afterwards)
  wsgroups tidy               move already-open windows to their group's workspace
  wsgroups list               show the groups and the numbered windows in each
  wsgroups bar                waybar module: follows Hyprland events, prints JSON lines

Groups are stored in ~/.config/hypr/workspaces.conf.
"""
import json, os, re, shlex, socket, subprocess, sys, time

CONF = os.path.expanduser("~/.config/hypr/workspaces.conf")
ICON = "\U000f0570"  # nf-md-view_carousel


# ---- hyprland ----------------------------------------------------------------------------------
def hypr(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def query(what):
    try:
        return json.loads(hypr(what, "-j") or "null")
    except json.JSONDecodeError:
        return None


def dispatch(lua):
    hypr("dispatch", lua)


def notify(msg):
    subprocess.run(["notify-send", "-t", "1500", "Workspaces", msg], capture_output=True)


POPUPS = ("TUI.float", "panels.")   # popup panels (and the backdrop behind one)


def windows(ws, clients=None):
    """Windows on workspace ws, oldest first — that order is what Alt + N counts."""
    clients = query("clients") if clients is None else clients
    wins = [c for c in clients or [] if c["workspace"]["id"] == ws and c["mapped"]
            and not c["class"].startswith(POPUPS + ("code-term-",))]
    # popups, panel windows and the kitty beside each VS Code window (codepair.lua) don't count
    return sorted(wins, key=lambda c: c.get("stableId", 0))


def focused(clients=None):
    """The focused window's address (None on an empty workspace); while a popup (a panel, its
    backdrop, a TUI popup) has the focus, the window it opened over, so the bar doesn't change
    under a popup."""
    active = query("activewindow") or {}
    if not active.get("class", "").startswith(POPUPS):
        return active.get("address")
    clients = query("clients") if clients is None else clients
    recent = sorted((c for c in clients or [] if c.get("focusHistoryID", -1) >= 0),
                    key=lambda c: c["focusHistoryID"])
    ws = active["workspace"]["id"]
    return next((c["address"] for c in recent
                 if not c["class"].startswith(POPUPS) and c["workspace"]["id"] == ws), None)


def matches(win, cls):
    try:
        return re.fullmatch(cls, win["class"]) is not None
    except re.error:
        return False


# ---- workspaces.conf ---------------------------------------------------------------------------
def read_conf():
    """(header lines, {ws: {"name", "cls", "launch": [cmd], "new": cmd}})"""
    header, groups = [], {}
    try:
        lines = open(CONF).read().splitlines()
    except OSError:
        return header, groups
    body = False
    for line in lines:
        s = line.strip()
        parts = [p.strip() for p in s.split("|", 4)]
        if s and not s.startswith("#") and len(parts) >= 3 and parts[0].isdigit():
            body = True
            launch = [c.strip() for c in parts[3].split(";")] if len(parts) > 3 else []
            # several apps are "a, b" in the file (| separates its columns) and the regex a|b here
            cls = "|".join(c.strip() for c in parts[2].split(",") if c.strip())
            groups[int(parts[0])] = {"name": parts[1], "cls": cls, "launch": [c for c in launch if c],
                                     "new": parts[4] if len(parts) > 4 else ""}
        elif not body:
            header.append(line)
    return header, groups


def groups():
    return read_conf()[1]


def write_conf(groups_):
    header, _ = read_conf()
    while header and not header[-1].strip():
        header.pop()
    rows = []
    for ws in sorted(groups_):
        g = groups_[ws]
        cls = ", ".join(g["cls"].split("|"))
        row = f"{ws} | {g['name']:<8} | {cls:<13} | {' ; '.join(g['launch'])}"
        rows.append((row + f" | {g['new']}" if g.get("new") else row).rstrip())
    with open(CONF, "w") as f:           # write in place: the file is a symlink into ~/dotfiles
        f.write("\n".join(header) + "\n\n" + "\n".join(rows) + "\n")
    hypr("reload")


# ---- actions -----------------------------------------------------------------------------------
def focus(n):
    ws = query("activeworkspace")["id"]
    wins = windows(ws)
    if n > len(wins):
        notify(f"No window {n} here ({len(wins)} open)")
        return
    target = wins[n - 1]
    dispatch(f'hl.dsp.focus({{ window = "address:{target["address"]}" }})')


def launch(ws, force=False):
    g = groups().get(ws)
    if not g or not g["launch"]:
        return False
    if not force and any(matches(w, g["cls"]) for w in windows(ws)):
        return False
    for i, cmd in enumerate(g["launch"]):
        if i:
            time.sleep(0.8)  # keep the opening order = the Alt + N order
        spawn(cmd)
    return True


def spawn(cmd):
    argv = [os.path.expanduser(a) for a in shlex.split(cmd)]
    subprocess.Popen(["uwsm", "app", "--", *argv], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def new_window():
    """Another window of this workspace's app. Its class rule keeps it on this workspace."""
    ws = (query("activeworkspace") or {}).get("id", 0)
    g = groups().get(ws)
    if not g:
        notify(f"Workspace {ws % 10} has no app yet (Super + Ctrl + G to add one)")
        return
    cmd = g.get("new") or (g["launch"][0] if g["launch"] else "")
    if cmd in ("", "-"):
        notify(f"{g['name']} has no new-window command")
        return
    spawn(cmd)


def wait_for(ws, timeout=10):
    """Wait until one of the group's windows has opened on ws."""
    g = groups().get(ws)
    end = time.time() + timeout
    while g and time.time() < end:
        if any(matches(w, g["cls"]) for w in windows(ws)):
            return True
        time.sleep(0.25)
    return False


def go(ws):
    dispatch(f'hl.dsp.focus({{ workspace = "{ws}" }})')
    launch(ws)


def tidy():
    moved = 0
    gs = groups()
    for win in query("clients") or []:
        for ws, g in gs.items():
            if matches(win, g["cls"]) and win["workspace"]["id"] != ws and win["workspace"]["id"] > 0:
                dispatch(f'hl.dsp.window.move({{ workspace = "{ws}", follow = false, '
                         f'window = "address:{win["address"]}" }})')
                moved += 1
                break
    return moved


def show():
    gs = groups()
    clients = query("clients")
    active = query("activeworkspace")["id"]
    for ws in sorted(set(gs) | {active}):
        g = gs.get(ws, {"name": "(no group)", "cls": "-", "launch": []})
        mark = "*" if ws == active else " "
        print(f"{mark}{ws:>2}  {g['name']:<10} class: {g['cls']}")
        for i, w in enumerate(windows(ws, clients), 1):
            state = " [max]" if w.get("fullscreen") else ""
            print(f"      Alt+{i % 10}  {w['class']}: {w['title'][:50]}{state}")


def guess_launch(cls, pid=None):
    """The app's command from its .desktop entry (matched by StartupWMClass or file name)."""
    dirs = [os.path.expanduser("~/.local/share/applications"), "/usr/share/applications"]
    for d in dirs:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            if not n.endswith(".desktop"):
                continue
            try:
                text = open(os.path.join(d, n), errors="ignore").read()
            except OSError:
                continue
            wm = re.search(r"^StartupWMClass=(.+)$", text, re.M)
            exe = re.search(r"^Exec=(.+)$", text, re.M)
            if exe and ((wm and wm.group(1).strip().lower() == cls.lower())
                        or n[:-8].lower() == cls.lower()):
                cmd = re.sub(r"\s*%[a-zA-Z]", "", exe.group(1)).strip()
                return os.path.basename(cmd.split()[0]) + cmd[len(cmd.split()[0]):]
    try:
        return os.path.basename(os.readlink(f"/proc/{pid}/exe"))
    except (OSError, TypeError):
        return cls.lower()


def assign(groups_, ws, cls, pid=None):
    """Put window class cls on workspace ws (in groups_, not saved); a class belongs to one
    workspace only. Returns an error message, or None."""
    try:
        re.compile(cls)
    except re.error:
        return f"not a valid class pattern: {cls}"
    for other, g in list(groups_.items()):
        if other == ws:
            continue
        parts = [p for p in g["cls"].split("|") if p != cls]
        if len(parts) != len(g["cls"].split("|")):
            if parts:
                g["cls"] = "|".join(parts)
            else:
                del groups_[other]
    g = groups_.get(ws)
    if g:
        if cls not in g["cls"].split("|"):
            g["cls"] = f"{g['cls']}|{cls}"
    else:
        name = cls.split(".")[-1].split("-")[-1].capitalize()
        groups_[ws] = {"name": name, "cls": cls, "launch": [guess_launch(cls, pid)]}
    return None


# ---- waybar module -----------------------------------------------------------------------------
def bar_status():
    ws = (query("activeworkspace") or {}).get("id", 0)
    g = groups().get(ws)
    clients = query("clients")
    wins = windows(ws, clients)
    active = focused(clients)
    pos = next((i for i, w in enumerate(wins, 1) if w["address"] == active), 0)
    lines = [f"Alt+{i % 10}  {w['class']}: {w['title'][:40]}" for i, w in enumerate(wins, 1)]
    tip = (f"{g['name']} · workspace {ws}" if g else f"Workspace {ws} (no group)")
    tip += "\n" + ("\n".join(lines) if lines else "no windows") + "\n\nClick: manage groups"
    text = f"{ICON} {pos}/{len(wins)}" if wins else ICON  # the group's name is in the tooltip
    # "empty": just the icon (no count, no title beside it), so the bar centres it
    return {"text": text, "tooltip": tip, "class": ["group" if g else "none"] + ([] if wins else ["empty"])}


def bar():
    sock = os.path.join(os.environ.get("XDG_RUNTIME_DIR", ""), "hypr",
                        os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""), ".socket2.sock")
    wanted = ("workspace>>", "activewindow>>", "openwindow>>", "closewindow>>",
              "movewindow>>", "focusedmon>>", "configreloaded>>")
    last = None
    def emit():
        nonlocal last
        out = json.dumps(bar_status(), ensure_ascii=False)
        if out != last:
            print(out, flush=True)
            last = out
    while True:
        emit()
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(sock)
            buf = b""
            while True:
                data = s.recv(4096)
                if not data:
                    break
                buf += data
                *events, buf = buf.split(b"\n")
                if any(e.decode(errors="ignore").startswith(wanted) for e in events):
                    time.sleep(0.05)  # let hyprland settle
                    emit()
        except OSError:
            time.sleep(2)


# ---- manager UI --------------------------------------------------------------------------------
sys.path.insert(0, os.path.expanduser("~/.local/lib/panels"))  # shared Control Center look
from panelkit import (Panel, run, CARD, FG, DIM, ACCENT, KEY, TRACK, GREEN as GOOD, RED as BAD, BOLD, RESET,
                      fit, frame, card, spread, header, section, hints, highlight)


class UI(Panel):
    interval = 2.0  # keep the window counts current

    def __init__(self):
        self.msg = ""
        self.mode = "main"            # main | pick
        self.pick_sel = 0
        self.ask = None               # a question on the footer row: {label, value, yesno, done}
        self.sel = (query("activeworkspace") or {}).get("id", 1)
        if not 1 <= self.sel <= 10:
            self.sel = 1

    # -- data --
    def tick(self):
        self.load()

    def load(self):
        self.groups = groups()
        self.clients = query("clients") or []
        self.active_ws = (query("activeworkspace") or {}).get("id", 1)

    def apps(self):
        """Open apps, one row per class, with the workspace they're on."""
        seen = {}
        for c in sorted(self.clients, key=lambda c: c["class"].lower()):
            if c["class"] and c["workspace"]["id"] > 0 and c["class"] not in seen:
                seen[c["class"]] = c
        return list(seen.values())

    # -- drawing --
    def paint(self, body, footer):
        """Card header, body, then the last action's result or the key hints on the bottom row."""
        cols, rows, w, pad = frame(92)
        head = header(ICON, "Workspaces", "Alt + 1…0 switches windows", w)
        if self.ask and self.ask["yesno"]:
            foot = f"{BAD}{self.ask['label']}{RESET}  " + hints([("y", "yes"), ("n", "no")], w)
        elif self.ask:
            field = f"{ACCENT}{self.ask['label']}{RESET} {FG}{self.ask['value']}▏{RESET}"
            foot = spread(field, hints([("enter", "ok"), ("esc", "cancel")], 24), w)
        elif self.msg:
            foot = f"{GOOD}{fit(self.msg, w)}{RESET}"
        else:
            foot = hints(footer, w)
        return card(head, body, foot, rows, pad)

    def draw(self, w, h):
        return self.draw_pick() if self.mode == "pick" else self.draw_main()

    def group_rows(self, w):
        cw = max(w - 30, 6)  # class column: whatever the other columns leave
        lines = []
        for ws in range(1, 11):
            g = self.groups.get(ws)
            n = len(windows(ws, self.clients))
            here = f"{ACCENT}●{RESET}" if ws == self.active_ws else " "
            num = f"{ACCENT if g else DIM}{ws % 10}{RESET}"
            name = f"{FG}{BOLD}{fit(g['name'], 10):<10}{RESET}" if g else f"{DIM}{'—':<10}{RESET}"
            cls = f"{KEY}{fit(g['cls'], cw)}{RESET}" if g else f"{DIM}unassigned{RESET}"
            count = f"{GOOD}{'●' * min(n, 4)}{RESET} {DIM}{n}{RESET}" if n else f"{TRACK}○{RESET}"
            row = spread(f"{here} {num}  {name}  {cls}", count + " ", w)
            lines.append(highlight(row, w) if ws == self.sel else row)
        return lines

    def detail_rows(self, w):
        g = self.groups.get(self.sel)
        wins = windows(self.sel, self.clients)
        title = f"Workspace {self.sel % 10}" + (f" · {g['name']}" if g else "")
        lines = [section(title, w, f"{len(wins)} open" if wins else "")]
        if not g:
            return lines + [f"{DIM}No app yet. Press {RESET}{KEY}a{RESET}{DIM} to put an open one here.{RESET}"]
        for i, cmd in enumerate(g["launch"] or ["(nothing)"]):
            lines.append(f"{DIM}{'launch' if i == 0 else '':<8}{RESET}{FG}{fit(cmd, w - 8)}{RESET}")
        new = g.get("new") or (g["launch"][0] if g["launch"] else "-")
        lines.append(f"{DIM}{'Super+N':<8}{RESET}" + (f"{DIM}nothing{RESET}" if new == "-" else f"{FG}{fit(new, w - 8)}{RESET}"))
        lines.append("")
        for i, win in enumerate(wins, 1):
            cls = fit(win["class"], 16)
            lines.append(f"{KEY}{'Alt+' + str(i % 10):<8}{RESET}{FG}{cls}{RESET}  "
                         f"{DIM}{fit(win['title'], max(w - 10 - len(cls), 4))}{RESET}")
        if not wins:
            lines.append(f"{DIM}{'':<8}no windows open{RESET}")
        return lines

    def draw_main(self):
        w = frame(92)[2]
        if w >= 90:  # wide card: the list and the selected workspace side by side
            gap = 4
            lw = (w - gap) // 2
            left, right = self.group_rows(lw), self.detail_rows(w - lw - gap)[:10]
            right += [""] * (len(left) - len(right))
            lines = [l + " " * gap + r for l, r in zip(left, right)]
        else:
            lines = self.group_rows(w) + [""] + self.detail_rows(w)
        return self.paint(lines, [("↑↓", "select"), ("a", "add app"), ("e", "edit"), ("d", "delete"),
                           ("l", "launch"), ("g", "go"), ("t", "tidy")] + ([] if CARD else [("esc", "close")]))

    def draw_pick(self):
        w = frame(92)[2]
        tw = max(w - 44, 6)
        apps = self.apps()
        lines = [section(f"Pick an open app for workspace {self.sel % 10}", w)]
        for i, c in enumerate(apps):
            owner = next((ws for ws, g in self.groups.items() if matches(c, g["cls"])), None)
            where = f"{ACCENT}group {owner}{RESET}" if owner else f"{DIM}on {c['workspace']['id']}{RESET}"
            row = spread(f"{KEY}{fit(c['class'], 24):<24}{RESET}  {DIM}{fit(c['title'], tw)}{RESET}", where + " ", w)
            lines.append(highlight(row, w) if i == self.pick_sel else row)
        lines += ["", f"{DIM}or press {RESET}{KEY}c{RESET}{DIM} to type a class yourself{RESET}"]
        return self.paint(lines, [("↑↓", "select"), ("enter", "add"), ("c", "type class"), ("esc", "back")])

    # -- input --
    def prompt(self, label, value, done):
        """Ask for a line of text on the footer row; done(text) runs on Enter."""
        self.ask = {"label": label, "value": value, "yesno": False, "done": done}

    def confirm(self, question, done):
        self.ask = {"label": question, "value": "", "yesno": True, "done": done}

    def answer(self, k):
        ask = self.ask
        if ask["yesno"]:
            self.ask = None
            if k in ("y", "Y"):
                ask["done"]("")
        elif k == "ESC":
            self.ask = None
        elif k == "ENTER":
            self.ask = None
            ask["done"](ask["value"].strip())
        elif k == "BACKSPACE":
            ask["value"] = ask["value"][:-1]
        elif k == "\x15":
            ask["value"] = ""
        elif isinstance(k, str) and len(k) == 1 and k.isprintable():
            ask["value"] += k

    def save(self, msg):
        write_conf(self.groups)
        self.msg = msg

    def add_class(self, cls, pid=None):
        err = assign(self.groups, self.sel, cls, pid)
        if err:
            self.msg = err
        else:
            self.save(f"{cls} now opens on workspace {self.sel % 10}")

    def edit(self):
        g = self.groups.get(self.sel, {"name": "", "cls": "", "launch": [], "new": ""})
        new = {}

        def got_name(v):
            new["name"] = v
            self.prompt("Window class (regex, a|b for several):", g["cls"], got_cls)

        def got_cls(v):
            new["cls"] = v
            self.prompt("Launch (commands separated by ;):", " ; ".join(g["launch"]), got_launch)

        def got_launch(v):
            if not new["name"] or not new["cls"]:
                self.msg = "name and class are required"
                return
            self.groups[self.sel] = {"name": new["name"], "cls": new["cls"], "new": g.get("new", ""),
                                     "launch": [c.strip() for c in v.split(";") if c.strip()]}
            self.save(f"saved workspace {self.sel % 10}")

        self.prompt("Name:", g["name"], got_name)

    def key(self, k):
        if self.ask:
            self.answer(k)
            return
        if not isinstance(k, str):  # mouse clicks
            return
        k = {"WHEELUP": "UP", "WHEELDOWN": "DOWN"}.get(k, k)
        self.load()
        if self.mode == "pick":
            apps = self.apps()
            if k == "ESC":                       self.mode = "main"
            elif k in ("UP", "k"):               self.pick_sel = max(self.pick_sel - 1, 0)
            elif k in ("DOWN", "j"):             self.pick_sel = min(self.pick_sel + 1, len(apps) - 1)
            elif k == "ENTER" and apps:
                c = apps[self.pick_sel]
                self.add_class(c["class"], c.get("pid")); self.mode = "main"
            elif k == "c":
                self.mode = "main"
                self.prompt("Window class:", "", lambda cls: cls and self.add_class(cls))
            return
        self.msg = ""
        if k in ("ESC", "q"):                    return "quit"
        elif k in ("UP", "k"):                   self.sel = (self.sel - 2) % 10 + 1
        elif k in ("DOWN", "j"):                 self.sel = self.sel % 10 + 1
        elif k.isdigit():                        self.sel = int(k) or 10
        elif k == "a":                           self.mode, self.pick_sel = "pick", 0
        elif k in ("e", "ENTER"):                self.edit()
        elif k == "d" and self.sel in self.groups:
            def remove(_):
                del self.groups[self.sel]
                self.save(f"removed group from workspace {self.sel % 10}")
            self.confirm(f"Remove the {self.groups[self.sel]['name']} group?", remove)
        elif k == "l":
            self.msg = "launched" if launch(self.sel, force=True) else "nothing to launch"
        elif k == "g":
            go(self.sel)
            return "quit"
        elif k == "t":
            self.msg = f"moved {tidy()} window(s) to their workspaces"
        self.load()


def ui():
    import wsgui  # the GTK window, in ~/.local/lib/panels next to panelkit
    wsgui.main(sys.modules[__name__])


# ---- entry -------------------------------------------------------------------------------------
def main(argv):
    if not argv or argv[0] == "ui":
        ui()
        return
    if argv[0] == "tui":
        run(UI())
        return
    if argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, rest = argv[0], argv[1:]
    force = "-f" in rest or "--force" in rest
    background = "--background" in rest
    rest = [a for a in rest if a not in ("-f", "--force", "--background")]
    if cmd == "focus" and rest:
        focus(int(rest[0]))
    elif cmd == "new":
        new_window()
    elif cmd == "go" and rest:
        go(int(rest[0]))
    elif cmd == "launch" and rest:
        targets = sorted(groups()) if rest[0] == "all" else [int(rest[0])]
        home = (query("activeworkspace") or {}).get("id")
        for ws in targets:
            started = launch(ws, force)
            print(f"workspace {ws}: {'launched' if started else 'already open (use -f)'}")
            if started and background:
                wait_for(ws)
        if background and home:   # the group rules follow new windows; go back to where we were
            dispatch(f'hl.dsp.focus({{ workspace = "{home}" }})')
    elif cmd == "tidy":
        print(f"moved {tidy()} window(s)")
    elif cmd == "list":
        show()
    elif cmd == "bar":
        bar()
    else:
        print(__doc__.strip())
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv[1:])
