# Control Center (workspace 6): the waybar tools in one kitty window.
# Launched by `wsgroups launch 6` (see ~/.config/hypr/workspaces.conf). Quitting a tool restarts it.
#
# "splits" layout: every border belongs to one split, so dragging it (or ctrl+shift+r)
# resizes only the two panes next to it.
#
#   ┌──────────────┬─────────────┐
#   │ Groups       │ System      │
#   │              │             │
#   ├──────────────┤             │
#   │ Audio        ├─────────────┤
#   │              │ Shortcuts   │
#   │              ├─────────────┤
#   │              │ Network     │
#   └──────────────┴─────────────┘
layout splits
launch --title Groups    --var panel=groups                                sh -c "exec ~/.config/hypr/scripts/panel.sh ~/.local/bin/wsgroups"
launch --title System    --var panel=system    --location=vsplit --bias=50 sh -c "exec ~/.config/hypr/scripts/panel.sh ~/.config/hypr/scripts/sysmon.py"
launch --title Shortcuts --var panel=shortcuts --location=hsplit --bias=60 sh -c "exec ~/.config/hypr/scripts/panel.sh ~/.config/hypr/scripts/keys.py"
launch --title Network   --var panel=network   --location=hsplit --bias=50 sh -c "exec ~/.config/hypr/scripts/panel.sh ~/.config/hypr/scripts/netpanel.py"
focus_matching_window var:panel=groups
launch --title Audio     --var panel=audio     --location=hsplit --bias=50 sh -c "exec ~/.config/hypr/scripts/panel.sh wiremix -v output"
focus_matching_window var:panel=groups
