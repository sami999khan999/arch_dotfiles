# Omarchy mako — Tokyo Night
text-color=#a9b1d6
border-color=#414868
background-color=#1a1b26

anchor=top-right
group-by=app-name,summary,body
default-timeout=5000
# every notification goes into the panel's log (scripts/notifications.py, local/lib/panels/notifgui.py)
on-notify=exec ~/.config/hypr/scripts/notifications.py log "$id"
max-history=50
width=420
outer-margin=20
padding=10,15
border-size=2
max-icon-size=32
font=JetBrainsMono Nerd Font 11

[app-name=Spotify]
invisible=1

[mode=do-not-disturb]
invisible=true

[mode=do-not-disturb app-name=notify-send]
invisible=false

