#!/usr/bin/env python3
# agentmux — the command; what it does is in local/lib/agentmux/cli.py (`agentmux help`). Only a
# launcher: Python caches a module's compiled code but compiles a script on every run, and compiling
# all of cli.py was 20 ms of each hook call (Claude Code waits for one after every tool call).
import os, sys

sys.path.insert(0, os.path.expanduser("~/.local/lib/agentmux"))
import cli

cli.main(sys.argv)
