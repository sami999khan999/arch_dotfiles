#!/usr/bin/env python3
"""projects — the list of every project in ~/code and its git remotes, to get them all back anywhere.

  projects             status: one line per project (here / not cloned / no remote, changes, ahead/behind)
  projects clone [<list url>] [path…]
                       the one command on a new PC: fetch the list if it isn't here yet (from <list url>,
                       else <your GitHub user>/code-projects), then clone every listed project that's
                       missing, into its folder, with a local branch for each remote branch. When it
                       fetches the list it first arranges what's already in ~/code (see arrange).
  projects arrange [-n]
                       put what's in ~/code where the list says: a repo whose remote is listed moves to
                       that entry's folder; any other project (a repo the list doesn't have, a local-only
                       folder it doesn't name) moves to unsorted/, and the scan after it records them.
                       A folder already taken stays put (reported). -n: only show what would move.
  projects scan [-n]   record what's in ~/code now (commit + push the list if it changed); -n: only show
                       what would change. Runs at login and whenever the Projects panel opens.
  projects new <folder>/<name> [--template <t>] [--github <owner>] [--public]
                       a new project: git init + a first commit (from templates/<t> if given), a GitHub
                       repo under <owner> (private unless --public), and record it
  projects add <url> [path]
                       clone a repo into ~/code/<path> (default <repo name>) and record it
  projects pin <path> / unpin <path>
                       pin a project (first in the Projects panel; pins are in the list, every PC has them)
  projects mark <path> <status>
                       set a project's status (idea, planned, active, in-progress, testing, paused, blocked,
                       done; none clears it): the Projects panel shows it and sorts by it; in the list
  projects sync [path…] [-n]
                       bring every project (or those) up to date with GitHub: fetch, a local branch for
                       every branch there, fast-forward the ones only behind. Never merges, pushes or
                       touches a folder with uncommitted changes; diverged branches are only reported.
                       -n: only say what it would do
  projects forget <path>…
                       drop projects from the list
  projects move <path> <new path>
                       move a project inside ~/code (its HDD backup copy with it: codesync move) and
                       record it; refused while something runs in it
  projects delete-git <path> [-y]
                       remove its .git (it stays, as a local-only project)
  projects delete-github <path> [-y]
                       delete its repo on GitHub (if gh may: admin on it, the delete_repo scope) and drop
                       that remote; the folder stays, local-only
  projects delete <path> [-y]
                       delete its folder and drop it from the list (codesync's trash keeps the backup
                       copy for a while). Both say what only this copy has and ask first, unless -y
  projects init        once: create the private repo that holds the list, and record ~/code into it
  projects env [status] | push [path…] | pull [path…] | passphrase
                       the projects' .env files, kept encrypted in the list repo (gpg, AES-256, a passphrase
                       you type once per PC: kept in the keyring) so the other PC has them too. status: each
                       file, synced / changed here / newer on the other PC / both changed / not synced / only
                       there, and the keys its .env.example has that it lacks. push: the ones changed here
                       (and never synced) go up; pull: the ones newer there (or missing here) come down — a
                       file changed on both PCs is left alone (the .env panel asks). clone pulls them too.
  projects up <path>   start the project: its docker compose services (up -d), each dev command in an
                       agentmux terminal named "▶ <name>", agentmux on the project, VS Code on it
  projects down <path> stop it: Ctrl+C to its ▶ terminals (closed after), docker compose stop
  projects running [path…]
                       what's up: the compose services and ▶ terminals of each (JSON with -j)
  projects run-setup <path> [--json '<setup>' | --reset]
                       what up starts (printed): found by itself (compose files up to two folders down;
                       package.json's dev script with its lockfile's runner, a Makefile's dev target,
                       manage.py runserver), or the setup saved in the list for every PC (--json sets
                       it, --reset goes back to the found one). The Projects panel's Run setup edits it.

The list is ~/code/.projects/projects.json, a git repo of its own (private on GitHub: it names private
and organisation repos, so it never goes in the public dotfiles). Two copies: GitHub, and the HDD
(codesync backs up ~/code, .projects/ included). The Projects panel (Super + Ctrl + P) uses this file's
functions.

Scan rules: a folder with a .git is a project (its insides aren't searched); a folder with files of its
own and no git is a "local only" project (no remote: only the SSD and the HDD have it); a folder with
only folders in it is a group (potherbazar/: one project's frontend and backend repos) and is searched, and
so is one with a repo right inside it (files of its own next to them, a docker-compose.yml for both, don't
make it local only: that hid its repos). A listed project whose
folder is gone stays listed (maybe just not cloned on this PC), unless its URL turned up somewhere
else: then it moved. inbox/ is scratch and isn't recorded.

Each PC remembers where it last saw every repo (~/.local/state/projects/seen.json, not shared). A repo
still where this PC last saw it while the list has it elsewhere was moved on another PC: the scan moves
the folder to the list's place (not while something runs in it) instead of recording the old place over
the other PC's move. Moved on this PC since its last scan: the scan records the new place. The list's
"version" is the format: a projects older than the list doesn't write it (it would drop what it doesn't
know), and keys it doesn't use are kept.

The list repo syncs by itself: every change is committed and pushed, after pulling what the other PC
pushed; a scan with nothing to record still pulls, and pushes a commit an earlier push left behind
(offline).
PROJECTS_ROOT / PROJECTS_DIR / PROJECTS_STATE point it somewhere else (tests).
"""
import json, os, re, shutil, subprocess, sys, tempfile, threading, time
from concurrent.futures import ThreadPoolExecutor

ROOT = os.path.expanduser(os.environ.get("PROJECTS_ROOT", "~/code"))
DIR = os.path.expanduser(os.environ.get("PROJECTS_DIR", f"{ROOT}/.projects"))
LIST = f"{DIR}/projects.json"
SEEN = os.path.expanduser(os.environ.get("PROJECTS_STATE", "~/.local/state/projects")) + "/seen.json"
VERSION = 2                   # the list's format: 2 = statuses, ~/code flat
REPO_NAME = "code-projects"   # <GitHub user>/code-projects, private
SKIP = {"node_modules", "dist", "build", ".next", "target", ".venv", "venv", "vendor", "__pycache__"}
# not copied from a template: git, dependencies, build output and caches (the codesync ignore list's kind)
TEMPLATE_SKIP = SKIP | {".git", ".turbo", ".output", ".svelte-kit", ".expo", ".wrangler", ".vercel",
                        ".pnpm-store", ".nuxt", ".parcel-cache"}
NOT_RECORDED = {"inbox"}      # top-level folders that are scratch
UNSORTED = "unsorted"         # arrange: projects the list doesn't have go here (and get recorded)
MAX_DEPTH = 4
JOBS = 4                      # status checks at once
# clones at once: GitHub gives each connection only ~0.2 MB/s from here (the line does 19 MB/s), and
# connections add up (1 clone 0.17 MB/s, 4 at once 0.83), so a restore runs many side by side
CLONE_JOBS = 12
# a project's status (mark; the Projects panel's dropdown), in the order the panel sorts by: under way first
STATUSES = ["in-progress", "active", "testing", "blocked", "planned", "idea", "paused", "done"]

DIM, RED, GREEN, AMBER, BOLD, RESET = "\033[2m", "\033[31m", "\033[32m", "\033[33m", "\033[1m", "\033[0m"
if not sys.stdout.isatty():
    DIM = RED = GREEN = AMBER = BOLD = RESET = ""


def git(path, *args, timeout=60):
    """git in path: (ok, stdout). Never prompts (a private repo without access fails instead of hanging)."""
    # no optional locks: a status check (the panel looks often) never takes index.lock from a git you run
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_OPTIONAL_LOCKS="0")
    try:
        r = subprocess.run(["git", "-C", path, *args], capture_output=True, text=True, timeout=timeout, env=env)
    except subprocess.TimeoutExpired:
        return False, "timed out"
    return r.returncode == 0, (r.stdout if r.returncode == 0 else r.stderr).strip()


def last_line(text, default=""):
    lines = [l for l in text.splitlines() if l.strip()]
    return lines[-1].strip() if lines else default


# ---- the list -----------------------------------------------------------------------------------
def load():
    try:
        data = json.load(open(LIST))
    except (OSError, ValueError):
        data = {}
    # keys this version doesn't use stay as they are (save writes them back)
    return {**data, "version": data.get("version", 1), "projects": data.get("projects", []),
            "local_only": data.get("local_only", []), "pinned": data.get("pinned", []),
            "status": data.get("status", {}), "ai_model": data.get("ai_model", "")}


def too_new():
    """A problem if the list on disk is a newer format than this projects writes, else "". Writing it
    would drop what this version doesn't know (a PC's login scan ran before its dotfiles were pulled and
    wiped every status)."""
    v = load()["version"]
    return f"the list is format {v}, this projects writes {VERSION}: update the dotfiles (dotsync) first" \
        if v > VERSION else ""


def save(data):
    if too_new():
        raise SystemExit(too_new())
    data["version"] = VERSION
    data["projects"].sort(key=lambda p: p["path"])
    data["local_only"].sort(key=lambda p: p["path"])
    os.makedirs(DIR, exist_ok=True)
    with open(LIST, "w") as f:
        json.dump(data, f, indent=1)
        f.write("\n")


def commit(message, files=("projects.json",)):
    """Commit the list (or other files of its repo: the Setups panel's setups.json) and push it. Returns a
    problem to report, or ""."""
    if not os.path.isdir(f"{DIR}/.git"):
        return f"{DIR} isn't a git repo yet (projects init)"
    git(DIR, "add", *files)
    ok, out = git(DIR, "commit", "-q", "-m", message)
    if not ok and "nothing to commit" not in out:
        return out
    return list_push()


def list_pull():
    """What the other PC pushed, before this one changes the list (a scan's first step). Returns a
    problem, or "". Both PCs editing the list at once can clash: the rebase is undone and said so."""
    if not os.path.isdir(f"{DIR}/.git") or not git(DIR, "remote")[1]:
        return ""
    ok, out = git(DIR, "pull", "-q", "--rebase", timeout=60)
    if ok:
        return ""
    if os.path.isdir(f"{DIR}/.git/rebase-merge") or os.path.isdir(f"{DIR}/.git/rebase-apply"):
        git(DIR, "rebase", "--abort")
        return f"the list changed on both PCs: merge it by hand in {DIR}"
    return "not pulled (offline?)" + (": " + last_line(out) if out else "")


def list_push():
    """Push the list's commits, pulling first if the other PC pushed in between."""
    if not git(DIR, "remote")[1]:
        return ""
    ok, out = git(DIR, "push", "-q", timeout=60)
    if not ok and ("rejected" in out or "fetch first" in out or "non-fast-forward" in out):
        problem = list_pull()
        if problem:
            return problem
        ok, out = git(DIR, "push", "-q", timeout=60)
    if ok:
        return ""
    return "not pushed (offline?)" + (": " + last_line(out) if out else "")


def list_unpushed():
    """True if the list has commits its remote doesn't (a push that failed earlier)."""
    ok, out = git(DIR, "rev-list", "--count", "@{u}..HEAD")
    return ok and out.strip() not in ("", "0")


def gh_login():
    """The GitHub user gh is logged in as ("" if it isn't)."""
    try:
        r = subprocess.run(["gh", "api", "user", "-q", ".login"], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return r.stdout.strip() if r.returncode == 0 else ""


def gh_owners():
    """Where a new GitHub repo can go: the user, then their organisations."""
    user = gh_login()
    if not user:
        return []
    r = subprocess.run(["gh", "api", "user/orgs", "-q", ".[].login"], capture_output=True, text=True, timeout=20)
    return [user] + (r.stdout.split() if r.returncode == 0 else [])


def list_url():
    """https URL of <user>/code-projects if that repo exists ("" if not, or gh isn't logged in)."""
    user = gh_login()
    if not user:
        return ""
    r = subprocess.run(["gh", "repo", "view", f"{user}/{REPO_NAME}", "--json", "url", "-q", ".url"],
                       capture_output=True, text=True, timeout=20)
    return r.stdout.strip() if r.returncode == 0 else ""


def get_list(url=""):
    """Clone the list repo into DIR (url, else <gh user>/code-projects). Returns a problem, or ""."""
    if os.path.exists(LIST):
        return ""
    if os.path.isdir(DIR) and os.listdir(DIR):
        return f"{DIR} already has files but no projects.json"
    url = url or list_url()
    if not url:
        return "no list repo found: give its URL, or start a new list (projects init)"
    os.makedirs(ROOT, exist_ok=True)
    ok, out = git(ROOT, "clone", "-q", url, DIR, timeout=300)
    if not ok:
        return last_line(out, "clone failed")
    if not os.path.exists(LIST):
        return "that repo has no projects.json"
    return ""


# ---- one project --------------------------------------------------------------------------------
def is_repo(path):
    return os.path.exists(os.path.join(path, ".git"))


def remotes(path):
    """{name: url} from the repo's config: read from .git/config itself (a scan at login asked git once
    per repo); through git when the file is anything but plain (an include, a worktree's .git file)."""
    found = read_remotes(os.path.join(path, ".git", "config"))
    if found is not None:
        return found
    ok, out = git(path, "config", "--get-regexp", r"^remote\..*\.url$")
    found = {}
    for line in out.splitlines() if ok else []:
        key, _, url = line.partition(" ")
        found[key[len("remote."):-len(".url")]] = url
    return found


def read_remotes(config):
    """{name: url} of a plain .git/config, None if it isn't one this reads (no file, an include)."""
    try:
        text = open(config).read()
    except OSError:
        return None
    found, remote = {}, None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("["):
            m = re.fullmatch(r'\[\s*remote\s+"((?:[^"\\]|\\.)*)"\s*\]', line)
            if line.lower().startswith(("[include", "[includeif")) or (line.lower().startswith("[remote") and not m):
                return None
            remote = m.group(1).replace('\\"', '"').replace("\\\\", "\\") if m else None
        elif remote is not None and re.match(r"url\s*=", line, re.I):
            value = line.split("=", 1)[1].strip()
            if value.startswith('"') or "\\" in value or ";" in value or "#" in value:
                return None   # quoting, escapes or a comment after it: git reads that one
            found.setdefault(remote, value)
    return found


def current_branch(path):
    """The checked-out branch ("" if detached or unreadable), from .git/HEAD."""
    try:
        head = open(os.path.join(path, ".git", "HEAD")).read().strip()
    except OSError:
        return ""
    return head[16:] if head.startswith("ref: refs/heads/") else ""


def entry(rel):
    """What the list records for the repo at ROOT/rel (None: no remote)."""
    path = f"{ROOT}/{rel}"
    rs = remotes(path)
    if not rs:
        return None
    name = "origin" if "origin" in rs else sorted(rs)[0]
    e = {"path": rel, "url": rs.pop(name)}
    if name != "origin":
        e["remote"] = name
    if rs:
        e["remotes"] = rs
    branch = current_branch(path)
    if branch:
        e["branch"] = branch
    return e


def fetched_ago(path):
    """Seconds since the repo last fetched (None: never)."""
    try:
        return time.time() - os.path.getmtime(os.path.join(path, ".git", "FETCH_HEAD"))
    except OSError:
        return None


def branch_states(path):
    """Every branch, local and remote side by side: dicts with name, head, local, upstream, ahead, behind,
    gone (the upstream was deleted), date; remote-only branches have local False. Newest first."""
    sep = "\x1f"
    fmt = sep.join(["%(refname)", "%(refname:short)", "%(upstream:short)", "%(upstream:track)",
                    "%(committerdate:relative)", "%(HEAD)", "%(committerdate:unix)"])
    ok, out = git(path, "for-each-ref", f"--format={fmt}", "refs/heads", "refs/remotes")
    rows = [(l.split(sep) + [""] * 7)[:7] for l in out.splitlines()] if ok else []
    tracked = {r[2] for r in rows if r[0].startswith("refs/heads/") and r[2]}
    local_names = {r[1] for r in rows if r[0].startswith("refs/heads/")}
    out = []
    for full, short, upstream, track, when, head, unix in rows:
        if full.startswith("refs/heads/"):
            ahead = int(m.group(1)) if (m := re.search(r"ahead (\d+)", track)) else 0
            behind = int(m.group(1)) if (m := re.search(r"behind (\d+)", track)) else 0
            out.append({"name": short, "head": head == "*", "local": True, "upstream": upstream,
                        "ahead": ahead, "behind": behind, "gone": "gone" in track, "date": when,
                        "unix": int(unix or 0)})
        elif not full.endswith("/HEAD") and short not in tracked and short.partition("/")[2] not in local_names:
            out.append({"name": short, "head": False, "local": False, "upstream": short, "ahead": 0,
                        "behind": 0, "gone": False, "date": when, "unix": int(unix or 0)})
    return sorted(out, key=lambda b: (not b["head"], -b["unix"]))


def pull_ff(path, branch):
    """Fast-forward branch to its upstream (fetching it). (ok, message)."""
    if branch == current_branch(path):
        ok, out = git(path, "pull", "-q", "--ff-only", timeout=300)
        return ok, "pulled" if ok else last_line(out, "pull failed")
    ok, up = git(path, "rev-parse", "--abbrev-ref", f"{branch}@{{u}}")
    if not ok:
        return False, f"{branch} has no upstream"
    remote, _, rbranch = up.partition("/")
    ok, out = git(path, "fetch", "-q", remote, f"{rbranch}:{branch}", timeout=300)
    return ok, f"{branch} fast-forwarded" if ok else last_line(out, "fetch failed")


# ---- syncing with GitHub (the Projects panel's Sync / Sync all) ---------------------------------------
# Brings GitHub's side down and nothing else: never merges, rebases, pushes, forces or stashes, and
# never touches a folder with uncommitted changes. A branch only moves when it's strictly behind (a
# fast-forward); one that has diverged is left as it is and reported, with the files that would clash.
def _branches(path):
    """[(name, upstream, track, sha)] of the local branches."""
    sep = "\x1f"
    ok, out = git(path, "for-each-ref", f"--format=%(refname:short){sep}%(upstream){sep}%(upstream:track){sep}%(objectname)",
                  "refs/heads")
    return [tuple((l.split(sep) + ["", "", ""])[:4]) for l in out.splitlines()] if ok else []


def _counts(track):
    ahead = int(m.group(1)) if (m := re.search(r"ahead (\d+)", track)) else 0
    behind = int(m.group(1)) if (m := re.search(r"behind (\d+)", track)) else 0
    return ahead, behind


def clash_files(path, a, b):
    """The files merging b into a would conflict in ([] if it would merge cleanly). Read-only:
    git merge-tree builds the result in memory."""
    r = subprocess.run(["git", "-C", path, "merge-tree", "--write-tree", "--name-only", "--no-messages", a, b],
                       capture_output=True, text=True, env=dict(os.environ, GIT_TERMINAL_PROMPT="0"))
    return [l for l in r.stdout.splitlines()[1:] if l.strip()] if r.returncode == 1 else []


def unmerged_files(path):
    """Files left with merge conflicts in the folder (by a merge or pull you started)."""
    ok, out = git(path, "diff", "--name-only", "--diff-filter=U")
    return out.splitlines() if ok and out else []


def sync(rel, dry=False):
    """Bring the repo at ROOT/rel up to date with GitHub: fetch; a local branch for every branch on
    origin; fast-forward the branches that are only behind (the checked-out one only with no
    uncommitted changes); delete a local branch whose GitHub branch was deleted, only when all its
    commits are in main. dry: only say what it would do. Returns {updated, created, deleted,
    skipped: [(branch, why)], diverged: [(branch, clash files)], error}."""
    path = f"{ROOT}/{rel.strip('/')}"
    rep = {"updated": [], "created": [], "deleted": [], "skipped": [], "diverged": [], "error": ""}
    ok, out = git(path, "fetch", "--all", "--prune", "-q", timeout=300)
    if not ok:
        rep["error"] = last_line(out, "fetch failed")
        return rep
    head = current_branch(path)
    main = default_branch(path)
    local = _branches(path)
    have = {n for n, *_ in local}
    ok, remote = git(path, "for-each-ref", "--format=%(refname:short)", "refs/remotes/origin")
    for ref in remote.split() if ok else []:   # every branch on GitHub, locally too
        name = ref.partition("/")[2]
        if name and name != "HEAD" and name not in have:
            if dry or git(path, "branch", "-q", "--track", name, ref)[0]:
                rep["created"].append(name)
    dirty = bool(git(path, "status", "--porcelain", "--untracked-files=no")[1])
    for name, upstream, track, sha in local:
        if not upstream:
            continue   # never pushed: nothing to bring down
        if "gone" in track:   # deleted on GitHub: its local copy goes only if main has all of it
            if name != head and main and git(path, "merge-base", "--is-ancestor", sha, f"refs/remotes/origin/{main}")[0]:
                if dry or git(path, "update-ref", "-d", f"refs/heads/{name}", sha)[0]:
                    rep["deleted"].append(name)
            continue
        ahead, behind = _counts(track)
        if not behind:
            continue
        if ahead:   # both sides have new commits: you merge it (VS Code); here it's only reported
            rep["diverged"].append((name, clash_files(path, f"refs/heads/{name}", upstream)))
            continue
        if name == head:
            if dirty:
                rep["skipped"].append((name, "uncommitted changes: commit them, then sync"))
                continue
            if not dry:
                ok, out = git(path, "merge", "-q", "--ff-only", "@{u}", timeout=300)
                if not ok:
                    rep["skipped"].append((name, last_line(out, "git refused to update the files")))
                    continue
        elif not dry:
            ok, new = git(path, "rev-parse", upstream)
            if not (ok and git(path, "update-ref", f"refs/heads/{name}", new, sha)[0]):   # only from where it was
                rep["skipped"].append((name, "it moved while syncing: sync again"))
                continue
        rep["updated"].append(name)
    return rep


def conflicts(rel):
    """What needs merging by hand: {unmerged: [files with conflicts in the folder], diverged:
    [(branch, ahead, behind, clash files)]} (a diverged branch with no clash files would merge cleanly)."""
    path = f"{ROOT}/{rel.strip('/')}"
    out = {"unmerged": unmerged_files(path), "diverged": []}
    for name, upstream, track, _ in _branches(path):
        ahead, behind = _counts(track)
        if upstream and ahead and behind:
            out["diverged"].append((name, ahead, behind, clash_files(path, f"refs/heads/{name}", upstream)))
    return out


# The free models, through opencode (its free tier only works from within opencode, so `opencode run`):
# a commit message from a diff, and the Ask chat (asklib.py). opencode is an agent with tools, so it runs
# in a bubblewrap sandbox: the system read-only, a throwaway empty home, only the prompt's files mounted
# (read-only), network for the model, nothing else of this PC. Whatever the model tries, it can't read
# ~/code or a credential, or change anything; its own server is private (--standalone) and dies with it.
# The model is picked in the Commit popup and kept in the list (every PC the same); PROJECTS_AI_MODEL wins.
AI_MODEL = "opencode/mimo-v2.6-flash-free"
AI_DIFF_MAX = 24000   # characters of diff sent at most (the rest is summarised as file names)
AI_PROMPT = ("Write the git commit message for the attached changes. Reply with only the message: a subject line "
             "under 72 characters in the style of the recent commits, then (if useful) a blank line and a short "
             "body saying what changed and why. No quotes, no code fences, no commentary. Don't use any tools.")


def ai_model():
    """The model that writes commit messages."""
    return os.environ.get("PROJECTS_AI_MODEL") or load()["ai_model"] or AI_MODEL


def _agentlib():
    """sysagentlib (local/lib/panels): asking opencode for its models is done in one place."""
    sys.path.insert(0, os.path.expanduser("~/.local/lib/panels"))
    import sysagentlib
    return sysagentlib


def ai_models():
    """The models opencode offers (its free ones without an account), or [] when it can't say."""
    return _agentlib().models()


def ai_models_cached():
    """The models opencode offered last time, at once (a dropdown's first frame), or []."""
    return _agentlib().cached_models()


def set_ai_model(model):
    """Keep the model that writes commit messages, in the list. Returns a problem, or ""."""
    data = load()
    if data["ai_model"] == model:
        return ""
    data["ai_model"] = model
    save(data)
    return commit(f"commit messages by {model}")


def ask_model(prompt, files, model=None, timeout=120, stop=None):
    """One answer from model (default ai_model()) to prompt, with files ({name: text}) attached, from
    opencode in the sandbox. stop: a threading.Event; set, the run is killed (the Ask chat deleted while it
    answers). (ok, the reply's text or what went wrong)."""
    if not shutil.which("opencode") or not shutil.which("bwrap"):
        return False, "opencode or bubblewrap isn't installed (setup/packages.txt)"
    tmp = tempfile.mkdtemp(prefix="projects-ai-")
    box = "/home/sandbox"
    try:
        for name, text in files.items():
            with open(os.path.join(tmp, name), "w") as f:
                f.write(text)
        etc = [a for f in ("resolv.conf", "hosts", "nsswitch.conf", "passwd", "ssl", "ca-certificates", "localtime")
               for a in ("--ro-bind-try", f"/etc/{f}", f"/etc/{f}")]
        argv = ["bwrap", "--ro-bind", "/usr", "/usr", "--symlink", "usr/lib", "/lib", "--symlink", "usr/lib64", "/lib64",
                "--symlink", "usr/bin", "/bin", "--symlink", "usr/sbin", "/sbin", *etc,
                "--proc", "/proc", "--dev", "/dev", "--tmpfs", "/tmp", "--tmpfs", box, "--ro-bind", tmp, f"{box}/in",
                "--chdir", box, "--unshare-all", "--share-net", "--die-with-parent", "--new-session", "--clearenv",
                "--setenv", "HOME", box, "--setenv", "PWD", box, "--setenv", "PATH", "/usr/bin",
                "opencode", "run", "--standalone", "--format", "json", "-m", model or ai_model(),
                *[a for name in files for a in ("-f", f"{box}/in/{name}")], prompt]
        proc = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                                stdin=subprocess.DEVNULL)
        deadline = time.time() + timeout
        while True:   # half a second at a time: a stop or the timeout kills the sandbox (--die-with-parent)
            try:
                out, err = proc.communicate(timeout=0.5)
                break
            except subprocess.TimeoutExpired:
                if (stop and stop.is_set()) or time.time() > deadline:
                    proc.kill()
                    proc.communicate()
                    return False, "stopped" if stop and stop.is_set() else \
                        f"the model didn't answer in {timeout // 60} minutes"
        r = subprocess.CompletedProcess(argv, proc.returncode, out, err)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    texts = []
    for line in r.stdout.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") == "text" and e.get("part", {}).get("text"):
            texts.append(e["part"]["text"])
    if not texts:
        return False, last_line(r.stderr, "no answer from the model")
    return True, texts[-1].strip()


def ai_message(rel, paths=None, model=None):
    """A commit message for the project's changes (paths: only those) from model (default ai_model()).
    (ok, message or what went wrong)."""
    path = f"{ROOT}/{rel.strip('/')}"
    which = ["--", *paths] if paths else []
    ok, diff = git(path, "diff", "HEAD", "--stat", "--patch", *which)
    ok2, new = git(path, "ls-files", "--others", "--exclude-standard", *which)
    for f in (new.splitlines() if ok2 else [])[:20]:   # new files: git diff doesn't show them
        try:
            with open(os.path.join(path, f), errors="replace") as fh:
                diff += f"\n\n--- new file {f}\n" + fh.read(2000)
        except OSError:
            diff += f"\n\n--- new file {f}"
    if not diff.strip():
        return False, "nothing to describe"
    if len(diff) > AI_DIFF_MAX:
        diff = diff[:AI_DIFF_MAX] + "\n\n[cut: the rest of the diff is longer]"
    _, log = git(path, "log", "--format=%s", "-12")
    ok, message = ask_model(AI_PROMPT, {"changes.txt": f"Recent commit subjects (match their style):\n{log}\n\n"
                                                       f"The changes:\n{diff}"}, model)
    if not ok:
        return False, message
    message = re.sub(r"^(text|markdown)?\n", "", message.strip("`").strip()).strip().strip('"').strip()
    return (True, message) if message else (False, "an empty answer from the model")


def commit_changes(rel, message, paths=None, push_after=False):
    """Commit the project's changes (paths: only those; default everything, new files too), as git
    commit does it: the project's hooks run. Then push the branch if asked. (ok, message)."""
    path = f"{ROOT}/{rel.strip('/')}"
    if not message.strip():
        return False, "write a message first"
    ok, out = git(path, "add", "-A", "--", *(paths or ["."]))
    if not ok:
        return False, last_line(out, "git add failed")
    args = ["commit", "-q", "-m", message]
    if paths:
        args += ["--", *paths]
    ok, out = git(path, *args, timeout=600)
    if not ok:
        return False, last_line(out, "commit failed (a hook may have stopped it)")
    ok, short = git(path, "rev-parse", "--short", "HEAD")
    msg = f"committed {short}"
    if push_after:
        ok, out = push(path)
        msg += ", pushed" if ok else f"; push failed: {out}"
    return ok, msg


def discard_changes(rel, paths):
    """Throw away the changes to paths (new files too; a rename as git status shows it, "old -> new") — into
    a stash, not into nothing: a click too many is undone with git stash pop. (ok, message)."""
    path = f"{ROOT}/{rel.strip('/')}"
    if not paths:
        return False, "nothing picked"
    n, files = len(paths), [p for shown in paths for p in shown.split(" -> ")]
    # unstaged first: stash's pathspec must match the index or an untracked file, and a staged rename's old
    # name is in neither (the stash failed, an empty one left behind)
    ok, out = git(path, "reset", "-q", "--", *files)
    if ok:
        ok, out = git(path, "stash", "push", "-q", "--include-untracked",
                      "-m", f"discarded in Commit: {n} file{'s' * (n != 1)}", "--", *files)
    if not ok:
        return False, last_line(out, "git stash failed")
    return True, f"discarded {n} file{'s' * (n != 1)} (git stash pop brings {'them' if n != 1 else 'it'} back)"


def push(path):
    """Push the checked-out branch (setting its upstream the first time). (ok, message)."""
    ok, _ = git(path, "rev-parse", "--abbrev-ref", "@{u}")
    ok, out = git(path, *(["push", "-q"] if ok else ["push", "-q", "-u", "origin", "HEAD"]), timeout=300)
    return ok, "pushed" if ok else last_line(out, "push failed")


def has_files(path):
    try:
        return any(e.is_file() and not e.name.startswith(".") for e in os.scandir(path))
    except OSError:
        return False


def holds_repo(path):
    try:
        return any(e.is_dir(follow_symlinks=False) and is_repo(e.path) for e in os.scandir(path))
    except OSError:
        return False


def is_group(path):
    """A folder searched for projects, not one itself (the scan rules in the header)."""
    return not is_repo(path) and (not has_files(path) or holds_repo(path))


def walk():
    """(repos, local_only): paths relative to ROOT, by the scan rules in the header."""
    repos, local = [], []
    todo = [("", 0)]
    while todo:
        rel, depth = todo.pop()
        try:
            names = sorted(e.name for e in os.scandir(f"{ROOT}/{rel}" if rel else ROOT)
                           if e.is_dir(follow_symlinks=False))
        except OSError:
            continue
        for name in names:
            if name.startswith(".") or name in SKIP or (not rel and name in NOT_RECORDED):
                continue
            sub = f"{rel}/{name}" if rel else name
            path = f"{ROOT}/{sub}"
            if is_repo(path):
                repos.append(sub)
            elif not is_group(path):
                local.append(sub)
            elif depth + 1 < MAX_DEPTH:
                todo.append((sub, depth + 1))
    return repos, local


def groups():
    """Every group folder in ROOT (folders holding only folders), relative paths, sorted."""
    out, todo = [], [("", 0)]
    while todo:
        rel, depth = todo.pop()
        try:
            names = [e.name for e in os.scandir(f"{ROOT}/{rel}" if rel else ROOT) if e.is_dir(follow_symlinks=False)]
        except OSError:
            continue
        for name in names:
            sub = f"{rel}/{name}" if rel else name
            if name.startswith(".") or name in SKIP or not is_group(f"{ROOT}/{sub}"):
                continue
            out.append(sub)
            if depth + 1 < MAX_DEPTH:
                todo.append((sub, depth + 1))
    return sorted(out)


# ---- commands -----------------------------------------------------------------------------------
def scan(dry=False, quiet=False):
    if not dry and not os.path.isdir(f"{DIR}/.git"):
        # no list on this PC yet: writing one here would hide the real one (the panel's setup page and
        # `projects clone` fetch it), so wait for it
        if not quiet:
            print("no list here yet: projects clone (fetch yours) or projects init (start one)")
        return []
    problem = "" if dry else list_pull()
    if problem and not quiet:
        print(f"{AMBER}{problem}{RESET}")
    if too_new():
        if not quiet:
            print(f"{AMBER}{too_new()}{RESET}")
        return []
    old = load()
    repos, local = walk()
    found = {}
    for rel in repos:
        e = entry(rel)
        if e:
            found[rel] = e
        else:
            local.append(rel)
    followed = follow_list(old, found, dry)
    urls = {e["url"]: rel for rel, e in found.items()}
    kept, moved = [], []
    for e in old["projects"]:
        if e["path"] in found or os.path.isdir(f"{ROOT}/{e['path']}"):
            continue                                  # on disk: what's there now counts
        if e["url"] in urls:
            moved.append((e["path"], urls[e["url"]]))  # the same repo, somewhere else now
        else:
            kept.append(e)                            # not on this PC: still listed
    new = {**old, "projects": list(found.values()) + kept,
           "local_only": [{"path": p, "git": is_repo(f"{ROOT}/{p}")} for p in local]}
    # pins follow a project that moved, and go with one that's no longer listed
    to = dict(moved)
    listed = {e["path"] for e in new["projects"]} | {e["path"] for e in new["local_only"]}
    new["pinned"] = [r for r in (to.get(r, r) for r in old["pinned"]) if r in listed]
    new["status"] = {to.get(r, r): st for r, st in old["status"].items() if to.get(r, r) in listed}
    new["ai_model"] = old["ai_model"]
    before = {e["path"]: e for e in old["projects"]}
    after = {e["path"]: e for e in new["projects"]}
    moved_to = {b for _, b in moved}
    added = [p for p in after if p not in before and p not in moved_to]
    gone = [p for p in before if p not in after and p not in {a for a, _ in moved}]
    changed = [p for p in after if p in before and after[p] != before[p]]
    lo_before = {e["path"] for e in old["local_only"]}
    lo_after = {e["path"] for e in new["local_only"]}
    lines = (followed + [f"{GREEN}+ {p}{RESET}  {after[p]['url']}" for p in sorted(added)]
             + [f"{AMBER}→ {a} → {b}{RESET}" for a, b in moved]
             + [f"{AMBER}~ {p}{RESET}" for p in sorted(changed)]
             + [f"{RED}- {p}{RESET}" for p in sorted(gone)]
             + [f"{DIM}+ {p} (local only){RESET}" for p in sorted(lo_after - lo_before)]
             + [f"{DIM}- {p} (local only){RESET}" for p in sorted(lo_before - lo_after)]
             + ([f"{DIM}pins: {', '.join(new['pinned']) or 'none'}{RESET}"] if new["pinned"] != old["pinned"] else []))
    if not quiet:
        print("\n".join(lines) if lines else "no changes")
        print(f"{DIM}{len(new['projects'])} projects listed ({len(kept)} not on this PC), "
              f"{len(new['local_only'])} local only{RESET}")
    if dry:
        return lines
    save_seen(found)
    if not lines:
        if list_unpushed():   # an earlier push didn't go through: now it does
            problem = list_push()
            if problem and not quiet:
                print(f"{AMBER}{problem}{RESET}")
        return lines
    save(new)
    parts = [f"+{len(added)}" if added else "", f"→{len(moved)}" if moved else "",
             f"~{len(changed)}" if changed else "", f"-{len(gone)}" if gone else ""]
    problem = commit("scan: " + (" ".join(p for p in parts if p) or "local-only folders"))
    if problem and not quiet:
        print(f"{AMBER}{problem}{RESET}")
    return lines


def load_seen():
    """{remote URL: path} of where this PC saw each repo at its last scan ({} before its first)."""
    try:
        return json.load(open(SEEN))
    except (OSError, ValueError):
        return {}


def save_seen(found):
    os.makedirs(os.path.dirname(SEEN), exist_ok=True)
    with open(SEEN, "w") as f:
        json.dump({norm_url(e["url"]): rel for rel, e in found.items()}, f, indent=1)


def follow_list(old, found, dry):
    """Repos the list moved on another PC (still where this PC last saw them, or this PC has no memory of
    them, and the list's place is free): move the folder there, so the scan doesn't record the old place
    over that move. found is updated to match. Returns the lines to report."""
    seen = load_seen()
    home = {norm_url(e["url"]): e["path"] for e in old["projects"]}
    lines = []
    for rel, e in sorted(found.items()):
        u = norm_url(e["url"])
        dst = home.get(u)
        if not dst or dst == rel or seen.get(u, rel) != rel or os.path.exists(f"{ROOT}/{dst}") \
                or (dst + "/").startswith(rel + "/"):
            continue   # where the list has it, moved on this PC since (recorded below), or the place is taken
        busy = busy_in(rel)
        if busy:
            # left where it is and not recorded there either: the next scan tries again
            lines.append(f"{AMBER}{rel} stays (the list has it at {dst}): {', '.join(busy)} running in it{RESET}")
            found.pop(rel)
            continue
        if not dry:
            move_project(rel, dst)
        found[dst] = {**found.pop(rel), "path": dst}
        lines.append(f"{AMBER}{rel} → {dst}{RESET}  {DIM}(moved on another PC){RESET}")
    return lines


def track_all_branches(path):
    """A local branch for every remote branch of origin that doesn't have one yet."""
    ok, out = git(path, "for-each-ref", "--format=%(refname:short)", "refs/remotes/origin")
    have = set(git(path, "for-each-ref", "--format=%(refname:short)", "refs/heads")[1].split())
    made = 0
    for ref in out.split() if ok else []:
        name = ref.partition("/")[2]
        if name and name != "HEAD" and name not in have:
            made += git(path, "branch", "-q", "--track", name, ref)[0]
    return made


def clone_one(e):
    """Clone a listed project into its folder. (ok, "N branches" or what went wrong)."""
    path = f"{ROOT}/{e['path']}"
    os.makedirs(os.path.dirname(path), exist_ok=True)
    ok, out = git(ROOT, "clone", "-q", "--origin", e.get("remote", "origin"), e["url"], path, timeout=1800)
    if not ok:
        return False, last_line(out, "clone failed")
    for name, url in e.get("remotes", {}).items():
        git(path, "remote", "add", name, url)
        git(path, "fetch", "-q", name, timeout=600)
    made = track_all_branches(path)
    if e.get("branch") and current_branch(path) != e["branch"]:
        git(path, "checkout", "-q", e["branch"])
    return True, f"{made + 1} branches"


def missing(paths=()):
    """Listed projects that aren't on disk (only those in paths, if given)."""
    return [e for e in load()["projects"]
            if not os.path.exists(f"{ROOT}/{e['path']}") and (not paths or e["path"] in paths)]


def clone_all(todo, report, stop=None):
    """Clone each entry, CLONE_JOBS at a time. report(entry, state, detail) with state started / ok / failed /
    skipped, from the worker threads. stop: a threading.Event; once set, the rest are skipped.
    Returns the number that failed."""
    fails = [0]
    lock = threading.Lock()

    def one(e):
        if stop is not None and stop.is_set():
            report(e, "skipped", "")
            return
        report(e, "started", "")
        ok, detail = clone_one(e)
        with lock:
            fails[0] += not ok
        report(e, "ok" if ok else "failed", detail)
    with ThreadPoolExecutor(CLONE_JOBS) as pool:
        list(pool.map(one, todo))
    if passphrase():   # their .env files come with them (projects env)
        env_pull([e["path"] for e in todo])
    return fails[0]


def norm_url(url):
    """A remote URL in one spelling, to compare: git@host:o/r, ssh://git@host/o/r, https://host/o/r(.git)
    are the same repo."""
    u = url.strip().rstrip("/")
    u = re.sub(r"\.git$", "", u)
    m = re.match(r"^(?:ssh://)?git@([^:/]+)[:/](.+)$", u)
    if m:
        u = f"https://{m[1]}/{m[2]}"
    u = re.sub(r"^https?://[^@/]+@", "https://", u)   # credentials in the URL
    return u.lower()


def free_path(rel):
    """rel, or rel-2, rel-3… if that's taken."""
    out, n = rel, 2
    while os.path.exists(f"{ROOT}/{out}"):
        out, n = f"{rel}-{n}", n + 1
    return out


def move_project(src, dst):
    """ROOT/src to ROOT/dst; the groups src leaves empty go too. Through codesync when ROOT is what it
    backs up: the backup copy moves with it (else the next sync would copy it all again and trash the
    old copy)."""
    a, b = f"{ROOT}/{src}", f"{ROOT}/{dst}"
    r = subprocess.run(["codesync", "move", a, b], capture_output=True, text=True) if shutil.which("codesync") else None
    if r is None or r.returncode != 0 or os.path.exists(a):   # not codesync's folder (or no codesync)
        os.makedirs(os.path.dirname(b), exist_ok=True)
        shutil.move(a, b)
    drop_empty_parents(src)


def drop_empty_parents(rel):
    """The group folders above ROOT/rel that are empty now."""
    parent = os.path.dirname(f"{ROOT}/{rel}")
    while parent != ROOT and parent.startswith(ROOT + "/"):
        try:
            os.rmdir(parent)   # only if empty
        except OSError:
            break
        parent = os.path.dirname(parent)


# ---- moving and deleting a project (the panel's Move…, Delete git, Delete folder) ----------------------
def busy_in(rel):
    """Programs running inside ROOT/rel (their working folder is in it): a shell, a dev server, an agent.
    Moving or deleting the folder under them would break them."""
    path, found = os.path.realpath(f"{ROOT}/{rel}"), set()
    for pid in os.listdir("/proc"):
        if pid.isdigit():
            try:
                cwd = os.readlink(f"/proc/{pid}/cwd")
                if cwd == path or cwd.startswith(path + "/"):
                    found.add(open(f"/proc/{pid}/comm").read().strip())
            except OSError:
                pass
    return sorted(found)


def at_risk(rel):
    """What only this copy of the repo has, as phrases ([] if nothing): uncommitted changes, commits on
    no remote, stashes. Deleting the folder or its .git loses them."""
    path, out = f"{ROOT}/{rel}", []
    if not is_repo(path):
        return out
    ok, st = git(path, "status", "--porcelain")
    if ok and st:
        out.append(f"{len(st.splitlines())} uncommitted change{'s' * (len(st.splitlines()) > 1)}")
    ok, n = git(path, "rev-list", "--count", "--branches", "--not", "--remotes")
    if ok and n.strip() not in ("", "0"):
        out.append(f"{n.strip()} commit{'s' * (n.strip() != '1')} on no remote")
    ok, st = git(path, "stash", "list")
    if ok and st:
        out.append(f"{len(st.splitlines())} stash{'es' * (len(st.splitlines()) > 1)}")
    return out


def move(rel, new):
    """Move a project inside ROOT and record it (the scan sees it moved). (ok, message)."""
    rel, new = rel.strip("/"), new.strip("/")
    if not new or new.startswith("..") or os.path.isabs(new):
        return False, f"give a folder inside {ROOT}"
    if new == rel:
        return False, "that's where it is"
    if os.path.exists(f"{ROOT}/{new}") or (new + "/").startswith(rel + "/"):
        return False, f"{new} already exists, or is inside the project"
    busy = busy_in(rel)
    if busy:
        return False, f"{', '.join(busy)} running in it: close {'them' if len(busy) > 1 else 'it'} first"
    move_project(rel, new)
    data = load()
    # a local-only project's move isn't seen as one by the scan: its pin and status follow it here
    if rel in data["pinned"] or rel in data["status"]:
        data["pinned"] = [new if r == rel else r for r in data["pinned"]]
        if rel in data["status"]:
            data["status"][new] = data["status"].pop(rel)
        save(data)
    scan(quiet=True)
    return True, f"moved to {new}"


def github_repo(url):
    """owner/name of a GitHub URL (https or ssh spelling, its own case), or None."""
    m = re.match(r"^(?:https?://(?:[^@/]+@)?github\.com/|(?:ssh://)?git@github\.com[:/])([^/]+)/([^/]+?)(?:\.git)?/?$",
                 url.strip())
    return f"{m[1]}/{m[2]}" if m else None


def can_delete_on_github(url):
    """True if gh's account may delete that repo (admin on it). Asks GitHub: a few hundred ms."""
    repo = github_repo(url)
    if not repo or not shutil.which("gh"):
        return False
    try:
        r = subprocess.run(["gh", "api", f"repos/{repo}", "--jq", ".permissions.admin"],
                           capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0 and r.stdout.strip() == "true"


def delete_on_github(rel):
    """Delete the project's origin repo on GitHub, then drop that remote here: the folder stays, a
    local-only project (or one with its other remotes). (ok, message, needs_scope): needs_scope when
    gh's token can't delete repos yet (`gh auth refresh -s delete_repo` grants it)."""
    rel = rel.strip("/")
    path = f"{ROOT}/{rel}"
    rs = remotes(path)
    name = "origin" if "origin" in rs else (sorted(rs)[0] if rs else None)
    repo = github_repo(rs[name]) if name else None
    if not repo:
        return False, "no GitHub remote", False
    r = subprocess.run(["gh", "repo", "delete", repo, "--yes"], capture_output=True, text=True, timeout=60)
    if r.returncode:
        err = last_line(r.stderr, "gh failed")
        return False, err, "delete_repo" in r.stderr
    git(path, "remote", "remove", name)
    scan(quiet=True)
    return True, f"{repo} deleted on GitHub (GitHub can restore it for 90 days); the folder stays, local-only", False


def pin(rel, on=True):
    """Pin a project (the Projects panel shows it first) or unpin it. Pins are in the list, so every
    PC has them. Returns a problem, or ""."""
    rel, data = rel.strip("/"), load()
    if on and rel not in {e["path"] for e in data["projects"]} | {e["path"] for e in data["local_only"]}:
        return f"not listed: {rel}"
    pins = [r for r in data["pinned"] if r != rel] + ([rel] if on else [])
    if pins == data["pinned"]:
        return ""
    data["pinned"] = pins
    save(data)
    return commit(f"{'pin' if on else 'unpin'} {rel}")


# ---- running a project (projects up / down; the Projects panel's Start) -------------------------
COMPOSE_NAMES = ("compose.yaml", "compose.yml", "docker-compose.yaml", "docker-compose.yml")
AGENTMUX = os.path.expanduser("~/.local/bin/agentmux")
SHELLS = {"fish", "bash", "zsh", "sh"}


def detect_run(path):
    """What up starts, found in the folder: {"compose": [files], "env_file", "commands": [{"name", "cmd",
    "dir"}], "code": True}, paths relative to the project. Compose files up to two folders down (a
    docker/ folder's), the project's .env passed to them when theirs has none (as its own scripts do)."""
    compose = []
    for d, dirs, files in os.walk(path):
        depth = os.path.relpath(d, path).count(os.sep) + (d != path)
        dirs[:] = [x for x in sorted(dirs) if x not in SKIP and not x.startswith(".")] if depth < 2 else []
        name = next((n for n in COMPOSE_NAMES if n in files), None)
        if name:
            compose.append(os.path.relpath(os.path.join(d, name), path))
    # a compose file in a subfolder with no .env of its own reads the project's (compose looks next to the file);
    # an example counts as the .env to be (Run setup offers to make it)
    sub = [os.path.dirname(c) for c in compose if os.path.dirname(c)]
    wants = lambda d: os.path.isfile(f"{d}/.env") or any(f.startswith(".env") and f.endswith(EXAMPLES)
                                                         for f in os.listdir(d))
    env_file = ".env" if sub and wants(path) and not any(wants(os.path.join(path, d)) for d in sub) else ""
    commands = []
    try:
        scripts = json.load(open(f"{path}/package.json")).get("scripts") or {}
    except (OSError, ValueError):
        scripts = {}
    if "dev" in scripts:
        runner = next((r for lock, r in (("pnpm-lock.yaml", "pnpm"), ("bun.lockb", "bun"), ("bun.lock", "bun"),
                                         ("yarn.lock", "yarn")) if os.path.isfile(f"{path}/{lock}")), "npm")
        commands.append({"name": "dev", "cmd": f"{runner} run dev", "dir": ""})
    elif os.path.isfile(f"{path}/Makefile") and re.search(r"^dev:", open(f"{path}/Makefile").read(), re.M):
        commands.append({"name": "dev", "cmd": "make dev", "dir": ""})
    elif os.path.isfile(f"{path}/manage.py"):
        commands.append({"name": "server", "cmd": "python manage.py runserver", "dir": ""})
    return {"compose": compose, "env_file": env_file, "commands": commands, "code": True}


def run_setup(rel):
    """The setup up uses: the one saved in the list (every PC), else the one found. "saved": which."""
    rel = rel.strip("/")
    saved = load().get("run", {}).get(rel)
    return {**saved, "saved": True} if saved else {**detect_run(f"{ROOT}/{rel}"), "saved": False}


def set_run_setup(rel, setup):
    """Save the project's setup in the list (None: forget it, up finds one again). Returns a problem."""
    rel, data = rel.strip("/"), load()
    runs = data.setdefault("run", {})
    if setup is None:
        if runs.pop(rel, None) is None:
            return ""
    else:
        runs[rel] = {"compose": list(setup.get("compose", [])), "env_file": setup.get("env_file", ""),
                     "commands": [{"name": c["name"], "cmd": c["cmd"], "dir": c.get("dir", "")}
                                  for c in setup.get("commands", []) if c.get("name") and c.get("cmd")],
                     "code": bool(setup.get("code", True))}
    save(data)
    return commit(f"{rel}: run setup {'saved' if setup is not None else 'reset'}")


def compose_cmd(rel, setup, *args):
    path = f"{ROOT}/{rel}"
    env = ["--env-file", f"{path}/{setup['env_file']}"] if setup.get("env_file") else []
    return ["docker", "compose", *env, *[a for c in setup["compose"] for a in ("-f", f"{path}/{c}")], *args]


def running(rel):
    """{"compose": [running service names], "commands": [▶ terminal names]} of the project."""
    rel = rel.strip("/")
    setup = run_setup(rel)
    out = {"compose": [], "commands": []}
    if setup["compose"]:
        try:
            r = subprocess.run(compose_cmd(rel, setup, "ps", "--status", "running", "--services"),
                               capture_output=True, text=True, timeout=15)
            out["compose"] = r.stdout.split() if r.returncode == 0 else []
        except (OSError, subprocess.TimeoutExpired):
            pass
    out["commands"] = sorted(_agentmux_lib_windows(f"{ROOT}/{rel}"))
    return out


def _agentmux_lib_windows(path):
    """agentmux's ▶ terminals of the project (its tmux server; nothing started to look)."""
    sys.path.insert(0, os.path.expanduser("~/.local/lib/agentmux"))
    import lib as amlib
    name = f"{amlib.session_base(path)}{amlib.SEP}terms"
    rc, out = amlib.agents("list-windows", "-t", f"={name}", "-F", "#{window_name}")
    return [n[2:] for n in out.splitlines() if n.startswith("▶ ")] if rc == 0 else []


def running_all():
    """{rel: {"compose": bool, "commands": [▶ names]}} of every project running something, in two calls
    (docker compose ls, one tmux listing): the Projects panel's ▶ in its list."""
    out = {}
    rels = {f"{ROOT}/{e['path']}": e["path"] for e in load()["projects"] + load()["local_only"]}

    def owner(path):
        path = os.path.realpath(path)
        while path.startswith(ROOT + "/"):
            if path in rels:
                return rels[path]
            path = os.path.dirname(path)
        return None
    try:
        r = subprocess.run(["docker", "compose", "ls", "--format", "json"], capture_output=True, text=True, timeout=10)
        stacks = json.loads(r.stdout or "[]") if r.returncode == 0 else []
    except (OSError, ValueError, subprocess.TimeoutExpired):
        stacks = []
    for st in stacks:
        if st.get("Status", "").startswith("running"):
            for f in st.get("ConfigFiles", "").split(","):
                if (rel := owner(f)):
                    out.setdefault(rel, {"compose": False, "commands": []})["compose"] = True
    try:
        r = subprocess.run(["tmux", "-L", "agents", "list-windows", "-a", "-F", "#{session_path}\t#{window_name}"],
                           capture_output=True, text=True, timeout=5)
        windows = [l.split("\t", 1) for l in r.stdout.splitlines() if "\t" in l] if r.returncode == 0 else []
    except (OSError, subprocess.TimeoutExpired):
        windows = []
    for path, name in windows:
        if name.startswith("▶ ") and (rel := owner(path)):
            out.setdefault(rel, {"compose": False, "commands": []})["commands"].append(name[2:])
    return out


def up(rel, report=print):
    """Start the project: compose up -d, its commands in agentmux terminals, VS Code. (ok, message)."""
    rel = rel.strip("/")
    path = f"{ROOT}/{rel}"
    if not os.path.isdir(path):
        return False, f"no folder {rel}"
    setup = run_setup(rel)
    if not setup["compose"] and not setup["commands"]:
        return False, f"{rel}: nothing to start (no compose file, no dev script: Run setup in the Projects panel)"
    done = []
    if setup["compose"]:
        report("docker compose up…")
        r = subprocess.run(compose_cmd(rel, setup, "up", "-d"), capture_output=True, text=True)
        if r.returncode:
            return False, f"docker compose up failed: {last_line(r.stderr, 'error')}"
        done.append("its services")
    for c in setup["commands"]:
        subprocess.run([AGENTMUX, "run", os.path.join(path, c.get("dir", "")).rstrip("/"), c["name"], c["cmd"]],
                       capture_output=True, timeout=30)
        done.append(c["name"])
    if setup.get("code", True):
        subprocess.Popen(["uwsm", "app", "--", "code", path], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    lacks = [n["file"] for n in env_needs(rel)]
    return True, f"{rel}: started {', '.join(done)}" + (
        f" — but no {', '.join(lacks)} here (Run setup makes it from the example or pulls it)" if lacks else "")


def down(rel, report=print):
    """Stop the project: its ▶ terminals, then compose stop (containers kept). (ok, message)."""
    rel = rel.strip("/")
    path = f"{ROOT}/{rel}"
    setup = run_setup(rel)
    for c in setup["commands"]:
        subprocess.run([AGENTMUX, "stop-run", os.path.join(path, c.get("dir", "")).rstrip("/")],
                       capture_output=True, timeout=30)
    subprocess.run([AGENTMUX, "stop-run", path], capture_output=True, timeout=30)
    if setup["compose"]:
        report("docker compose stop…")
        r = subprocess.run(compose_cmd(rel, setup, "stop"), capture_output=True, text=True)
        if r.returncode:
            return False, f"docker compose stop failed: {last_line(r.stderr, 'error')}"
    return True, f"{rel}: stopped"


# ---- .env files: encrypted in the list repo (projects env; the .env panel, envgui.py) --------------
ENV_DIR = f"{DIR}/env"                 # <project>/<file>.gpg, and index.json: what each copy holds
ENV_SEEN = os.path.join(os.path.dirname(SEEN), "env-seen.json")   # this PC: what it last synced, per file
EXAMPLES = (".example", ".sample", ".template", ".dist", ".defaults")
KEYRING = ["app", "projects-env"]      # the passphrase, in the keyring (secret-tool)


def env_files(path):
    """A project's .env files (.env, .env.local, .env.production…; not the examples), relative to it: in
    the project and its subfolders two deep (a monorepo's apps), never in node_modules."""
    out = []
    for d, dirs, files in os.walk(path):
        depth = os.path.relpath(d, path).count(os.sep) + (d != path)
        dirs[:] = [x for x in sorted(dirs) if x not in SKIP and not x.startswith(".")] if depth < 2 else []
        out += [os.path.relpath(os.path.join(d, f), path) for f in sorted(files)
                if (f == ".env" or f.startswith(".env.")) and not f.endswith(EXAMPLES)]
    return out


def env_examples(path):
    """The examples (.env.example…) with no .env next to them: a file the project wants and this PC lacks."""
    out = []
    for d, dirs, files in os.walk(path):
        depth = os.path.relpath(d, path).count(os.sep) + (d != path)
        dirs[:] = [x for x in sorted(dirs) if x not in SKIP and not x.startswith(".")] if depth < 2 else []
        if ".env" not in files:
            out += [os.path.relpath(os.path.join(d, f), path) for f in sorted(files)
                    if f.startswith(".env") and f.endswith(EXAMPLES)][:1]
    return out


def env_needs(rel):
    """The .env files the project wants and this PC lacks: [{"file", "example" (the one beside it, or None),
    "there" (the other PC's encrypted copy is in the repo)}]. Run setup offers to make or pull each; up warns."""
    rel = rel.strip("/")
    path = f"{ROOT}/{rel}"
    if not os.path.isdir(path):
        return []
    there = {k[len(rel) + 1:] for k in _env_index() if k.startswith(rel + "/")}
    out = {}
    for ex in env_examples(path):
        f = os.path.join(os.path.dirname(ex), ".env")
        out[f] = {"file": f, "example": ex, "there": f in there}
    for f in sorted(there):
        if f not in out and not os.path.isfile(os.path.join(path, f)):
            out[f] = {"file": f, "example": None, "there": True}
    return list(out.values())


def example_of(path, rel_file):
    """The example a .env file follows (.env.example beside it, else <file>.example…), or None."""
    d, name = os.path.split(os.path.join(path, rel_file))
    for cand in [f"{name}{e}" for e in EXAMPLES] + [f".env{e}" for e in EXAMPLES]:
        if os.path.isfile(os.path.join(d, cand)):
            return os.path.join(d, cand)
    return None


def env_keys(text):
    """{KEY: value} of a .env's lines (export KEY=…, quotes kept as written), in order."""
    out = {}
    for line in text.splitlines():
        m = re.match(r"\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_.]*)\s*=(.*)$", line)
        if m:
            out[m.group(1)] = m.group(2).strip()
    return out


def env_missing(path, rel_file):
    """The keys the file's example has that the file doesn't."""
    ex = example_of(path, rel_file)
    if not ex:
        return []
    have = env_keys(open(os.path.join(path, rel_file), errors="replace").read())
    return [k for k in env_keys(open(ex, errors="replace").read()) if k not in have]


def env_set(path, rel_file, key, value):
    """Set one key in a .env, in place: its line rewritten where it is, or added at the end."""
    full = os.path.join(path, rel_file)
    lines = open(full, errors="replace").read().splitlines() if os.path.exists(full) else []
    pat = re.compile(r"\s*(?:export\s+)?" + re.escape(key) + r"\s*=")
    for i, line in enumerate(lines):
        if pat.match(line):
            lines[i] = f"{key}={value}"
            break
    else:
        lines.append(f"{key}={value}")
    with open(full, "w") as f:   # in place: a symlinked .env stays a link
        f.write("\n".join(lines) + "\n")


def passphrase():
    try:
        return subprocess.run(["secret-tool", "lookup", *KEYRING], capture_output=True, text=True,
                              timeout=10).stdout.rstrip("\n")
    except (OSError, subprocess.TimeoutExpired):
        return ""


def set_passphrase(phrase):
    """Keep the passphrase in the keyring, after checking it opens a copy already there (a wrong one would
    write copies the other PC can't open). Returns a problem, or ""."""
    copies = [os.path.join(d, f) for d, _, fs in os.walk(ENV_DIR) for f in fs if f.endswith(".gpg")]
    if copies and _gpg(["--decrypt", copies[0]], phrase) is None:
        return "that passphrase doesn't open the copies already there"
    r = subprocess.run(["secret-tool", "store", "--label", "projects: .env passphrase", *KEYRING],
                       input=phrase, capture_output=True, text=True, timeout=10)
    return "" if r.returncode == 0 else "couldn't save it in the keyring: " + r.stderr.strip()


def _gpg(args, phrase, data=None):
    """gpg with the passphrase on a pipe of its own (never on the command line): its output, or None."""
    rfd, wfd = os.pipe()
    os.write(wfd, phrase.encode() + b"\n")
    os.close(wfd)
    try:
        r = subprocess.run(["gpg", "--batch", "--quiet", "--yes", "--no-symkey-cache", "--pinentry-mode", "loopback",
                            "--passphrase-fd", str(rfd), *args], input=data, capture_output=True, pass_fds=(rfd,),
                           timeout=30)
    finally:
        os.close(rfd)
    return r.stdout if r.returncode == 0 else None


def _env_mac(phrase, data):
    import hashlib, hmac
    return hmac.new(phrase.encode(), data, hashlib.sha256).hexdigest()[:32]


def _env_index():
    try:
        return json.load(open(f"{ENV_DIR}/index.json"))
    except (OSError, ValueError):
        return {}


def _env_seen():
    try:
        return json.load(open(ENV_SEEN))
    except (OSError, ValueError):
        return {}


def _env_save_seen(seen):
    os.makedirs(os.path.dirname(ENV_SEEN), exist_ok=True)
    with open(ENV_SEEN, "w") as f:
        json.dump(seen, f, indent=1)


def env_status(rels=None):
    """[{project, file, key ("<project>/<file>"), state, missing}] for every .env here or in the repo.
    state: synced, changed here, newer there, both changed, not synced, only there; "" without a passphrase.
    The copies are told apart by a keyed hash of their content (index.json): nothing readable in the repo."""
    phrase, index, seen = passphrase(), _env_index(), _env_seen()
    rels = rels or [e["path"] for e in load()["projects"] + load()["local_only"]]
    out = []
    for rel in rels:
        path = f"{ROOT}/{rel}"
        files = env_files(path) if os.path.isdir(path) else []
        there = sorted(k[len(rel) + 1:] for k in index if k.startswith(rel + "/") and k[len(rel) + 1:] not in files)
        for f in files + there:
            key = f"{rel}/{f}"
            here = os.path.isfile(os.path.join(path, f))
            mac = _env_mac(phrase, open(os.path.join(path, f), "rb").read()) if here and phrase else None
            remote, last = index.get(key, {}).get("mac"), seen.get(key)
            if not phrase:
                state = ""
            elif not here:
                state = "only there"
            elif remote is None:
                state = "not synced"
            elif mac == remote:
                state = "synced"
            elif remote == last:
                state = "changed here"
            elif mac == last:
                state = "newer there"
            else:
                state = "both changed"
            out.append({"project": rel, "file": f, "key": key, "state": state,
                        "missing": env_missing(path, f) if here else []})
    return out


def env_push(rels=None, keys=None, force=False):
    """Encrypt the files changed here (or never synced) into the repo, commit and push. keys: only those;
    force: also the ones changed on both PCs (this PC's wins). (ok, message)."""
    phrase = passphrase()
    if not phrase:
        return False, "no passphrase yet: projects env passphrase"
    list_pull()
    index, seen, done = _env_index(), _env_seen(), []
    for st in env_status(rels):
        if keys and st["key"] not in keys:
            continue
        if st["state"] not in ("changed here", "not synced") + (("both changed",) if force else ()):
            continue
        data = open(f"{ROOT}/{st['key']}", "rb").read()
        blob = _gpg(["--symmetric", "--cipher-algo", "AES256", "--output", "-"], phrase, data)
        if blob is None:
            return False, f"gpg couldn't encrypt {st['key']}"
        dest = f"{ENV_DIR}/{st['key']}.gpg"
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with open(dest, "wb") as f:
            f.write(blob)
        index[st["key"]] = {"mac": _env_mac(phrase, data), "at": int(time.time())}
        seen[st["key"]] = index[st["key"]]["mac"]
        done.append(st["key"])
    if not done:
        return True, "nothing to push: every .env is synced"
    os.makedirs(ENV_DIR, exist_ok=True)
    with open(f"{ENV_DIR}/index.json", "w") as f:
        json.dump(index, f, indent=1, sort_keys=True)
        f.write("\n")
    _env_save_seen(seen)
    if os.path.isdir(f"{DIR}/.git"):
        git(DIR, "add", "env")
        ok, out = git(DIR, "commit", "-q", "-m", f"env: {len(done)} file{'s' * (len(done) != 1)}")
        problem = list_push() if ok or "nothing to commit" in out else out
        if problem:
            return True, f"encrypted {len(done)}, but {problem}"
    return True, f"pushed {len(done)}: {', '.join(done)}"


def env_pull(rels=None, keys=None, force=False):
    """Decrypt the files newer there (or missing here) into their projects. keys: only those; force: also
    the ones changed on both PCs (the other PC's wins). Never writes into a project that isn't here. (ok, message)."""
    phrase = passphrase()
    if not phrase:
        return False, "no passphrase yet: projects env passphrase"
    list_pull()
    seen, done = _env_seen(), []
    index = _env_index()
    for st in env_status(rels):
        if keys and st["key"] not in keys:
            continue
        if st["state"] not in ("newer there", "only there") + (("both changed",) if force else ()):
            continue
        if not os.path.isdir(f"{ROOT}/{st['project']}"):
            continue
        data = _gpg(["--decrypt", f"{ENV_DIR}/{st['key']}.gpg"], phrase)
        if data is None:
            return False, f"couldn't decrypt {st['key']} (a different passphrase on the other PC?)"
        dest = f"{ROOT}/{st['key']}"
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with open(dest, "wb") as f:   # in place
            f.write(data)
        os.chmod(dest, 0o600)
        seen[st["key"]] = index[st["key"]]["mac"]
        done.append(st["key"])
    _env_save_seen(seen)
    return True, f"pulled {len(done)}: {', '.join(done)}" if done else "nothing to pull"


def mark(rel, status):
    """Set a project's status (one of STATUSES; "" or none clears it). In the list, so every PC has it.
    Returns a problem, or ""."""
    rel, data = rel.strip("/"), load()
    status = "" if status == "none" else status
    if status and status not in STATUSES:
        return f"no status {status}: {', '.join(STATUSES)} or none"
    if rel not in {e["path"] for e in data["projects"]} | {e["path"] for e in data["local_only"]}:
        return f"not listed: {rel}"
    if data["status"].get(rel, "") == status:
        return ""
    if status:
        data["status"][rel] = status
    else:
        data["status"].pop(rel)
    save(data)
    return commit(f"{rel}: {status or 'no status'}")


def delete_git(rel):
    """Remove the project's .git: its files stay, as a local-only project. (ok, message)."""
    path = f"{ROOT}/{rel.strip('/')}"
    if not is_repo(path):
        return False, "not a git repo"
    shutil.rmtree(f"{path}/.git")
    scan(quiet=True)
    return True, "git removed: it's a local-only project now"


def delete(rel):
    """Delete the project's folder and drop it from the list. (ok, message). The HDD backup keeps it
    in its trash for a while (codesync)."""
    rel = rel.strip("/")
    busy = busy_in(rel)
    if busy:
        return False, f"{', '.join(busy)} running in it: close {'them' if len(busy) > 1 else 'it'} first"
    shutil.rmtree(f"{ROOT}/{rel}")
    drop_empty_parents(rel)
    data = load()
    data["projects"] = [e for e in data["projects"] if e["path"] != rel]
    data["local_only"] = [e for e in data["local_only"] if e["path"] != rel]
    data["pinned"] = [r for r in data["pinned"] if r != rel]
    data["status"].pop(rel, None)
    save(data)
    problem = commit(f"delete {rel}")
    return True, f"deleted {rel}" + (f" ({problem})" if problem else "")


def arrange(dry=False, report=print):
    """The folder structure is the list's: what's already in ROOT goes where the list says (the restore's
    first step, before the missing projects are cloned). A repo with a listed remote moves to that
    entry's path; a project the list doesn't have moves to unsorted/<name> (the scan after the restore
    records it there). A listed path that's taken by a listed project stays as it is and is reported.
    Returns [(from, to)] of the moves."""
    data = load()
    # a project's own URL first: another one's extra remote (a fork's upstream) can be that URL too
    by_url = {norm_url(e["url"]): e["path"] for e in data["projects"]}
    for e in data["projects"]:
        for url in e.get("remotes", {}).values():
            by_url.setdefault(norm_url(url), e["path"])
    listed = {e["path"] for e in data["projects"]} | {e["path"] for e in data["local_only"]}
    repos, local = walk()
    want = {}   # rel -> where it belongs
    for rel in repos:
        rs = remotes(f"{ROOT}/{rel}")
        urls = [rs.pop("origin")] + list(rs.values()) if "origin" in rs else list(rs.values())   # its origin first
        home = next((by_url[norm_url(u)] for u in urls if norm_url(u) in by_url), None)
        if home:
            want[rel] = home
        elif not rel.startswith(UNSORTED + "/"):
            want[rel] = None   # not in the list
    for rel in local:
        if rel not in listed and not rel.startswith(UNSORTED + "/"):
            want[rel] = None
    moves = []
    # the unlisted first: one may sit at a listed project's path, which the listed one then gets
    for rel in sorted((r for r, h in want.items() if h is None), key=len, reverse=True):
        dst = free_path(f"{UNSORTED}/{os.path.basename(rel)}")
        moves.append((rel, dst))
        if not dry:
            move_project(rel, dst)
        report(f"{rel} → {dst}  (not in the list)")
    for rel, home in sorted(want.items()):
        if not home or rel == home:
            continue
        if os.path.exists(f"{ROOT}/{home}") and (not dry or home not in {src for src, _ in moves}):
            report(f"{rel} stays: {home} is taken")
            continue
        moves.append((rel, home))
        if not dry:
            move_project(rel, home)
        report(f"{rel} → {home}")
    return moves


def clone(args):
    url = args.pop(0) if args and re.match(r"^(https?://|git@|ssh://|file://)", args[0]) else ""
    if not os.path.exists(LIST):
        print("getting the list" + (f" from {url}" if url else "") + f" → {DIR}")
        problem = get_list(url)
        if problem:
            sys.exit(problem)
        arrange()          # what's already here goes where the list says first,
        scan(quiet=True)   # and what the list doesn't have is recorded (unsorted/) and pushed
    else:
        list_pull()
    todo = missing([a.strip("/") for a in args])
    if not todo:
        print("every listed project is already here")
        return
    print(f"cloning {len(todo)} project(s) into {ROOT}")

    def report(e, state, detail):
        if state == "ok":
            print(f"{GREEN}✓ {e['path']}{RESET}  {DIM}{detail}{RESET}", flush=True)
        elif state == "failed":
            print(f"{RED}✗ {e['path']}{RESET}  {detail}", flush=True)
    fails = clone_all(todo, report)
    print(f"done: {len(todo) - fails} cloned" + (f", {RED}{fails} failed{RESET}" if fails else ""))
    sys.exit(1 if fails else 0)


def default_branch(path):
    """The repo's main branch: what origin's HEAD points at (main, master…), else a local main / master."""
    ok, out = git(path, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    if ok and "/" in out:
        return out.split("/", 1)[1]
    return next((b for b in ("main", "master") if git(path, "show-ref", "--verify", "-q", f"refs/heads/{b}")[0]), "")


def health(rel):
    """How the repo at ROOT/rel stands, as of the last fetch: {dirty: changed files, unpushed: commits on
    no remote, main: its main branch, behind: how far main is behind origin's, out_of_date: what Sync
    would bring (branches behind + branches on GitHub not here yet), diverged: branches with new commits
    on both sides, unmerged: files left with conflicts in the folder; to_sync: commits behind in all,
    behind_branches: {branch: commits behind}, new_branches: on GitHub, not here yet}."""
    path = f"{ROOT}/{rel}"
    ok, st = git(path, "status", "--porcelain")
    dirty = len(st.splitlines()) if ok and st else 0
    ok, n = git(path, "rev-list", "--count", "--branches", "--not", "--remotes")
    unpushed = int(n) if ok and n.isdigit() else 0
    main, behind = default_branch(path), 0
    if main:
        ok, n = git(path, "rev-list", "--count", f"refs/heads/{main}..refs/remotes/origin/{main}")
        behind = int(n) if ok and n.isdigit() else 0
    local = _branches(path)
    have = {name for name, *_ in local}
    ok, remote = git(path, "for-each-ref", "--format=%(refname:short)", "refs/remotes/origin")
    new = sum(1 for r in (remote.split() if ok else []) if r.partition("/")[2] not in have | {"HEAD", ""})
    counts = {name: _counts(track) for name, up, track, _ in local if up and "gone" not in track}
    behind_branches = {name: b for name, (a, b) in counts.items() if b and not a}
    return {"dirty": dirty, "unpushed": unpushed, "main": main, "behind": behind,
            "out_of_date": len(behind_branches) + new,   # branches Sync would update or create
            "to_sync": sum(behind_branches.values()),   # commits Sync would bring down, all branches
            "behind_branches": behind_branches, "new_branches": new,
            "diverged": sum(1 for a, b in counts.values() if a and b), "unmerged": len(unmerged_files(path))}


def state(rel):
    """(changed files, ahead, behind) of the repo at ROOT/rel; ahead/behind None without an upstream."""
    path = f"{ROOT}/{rel}"
    ok, out = git(path, "status", "--porcelain")
    dirty = len(out.splitlines()) if ok else 0
    ok, out = git(path, "rev-list", "--left-right", "--count", "HEAD...@{u}")
    ahead, behind = (int(n) for n in out.split()) if ok else (None, None)
    return dirty, ahead, behind


def status():
    data = load()
    if not data["projects"] and not data["local_only"]:
        sys.exit("no list yet: projects init (first time) or projects clone (new PC)")
    here = [e for e in data["projects"] if is_repo(f"{ROOT}/{e['path']}")]
    with ThreadPoolExecutor(JOBS * 2) as pool:
        states = dict(zip((e["path"] for e in here), pool.map(state, (e["path"] for e in here))))
    width = max(len(e["path"]) for e in data["projects"] + data["local_only"])
    for e in data["projects"]:
        p = e["path"]
        if p not in states:
            print(f"{DIM}{p:<{width}}  not cloned{RESET}")
            continue
        dirty, ahead, behind = states[p]
        bits = []
        if dirty:
            bits.append(f"{AMBER}{dirty} changed{RESET}")
        if ahead:
            bits.append(f"{AMBER}↑{ahead}{RESET}")
        if behind:
            bits.append(f"↓{behind}")
        if ahead is None:
            bits.append(f"{DIM}no upstream{RESET}")
        print(f"{p:<{width}}  {current_branch(f'{ROOT}/{p}') or '-':<12} {' '.join(bits)}")
    for e in data["local_only"]:
        what = "git, no remote" if e["git"] else "no git"
        print(f"{AMBER}{e['path']:<{width}}  local only ({what}){RESET}")


def repo_name(url):
    return re.sub(r"\.git$", "", url.rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1])


def kebab(name):
    """my_App Name -> my-app-name: how folders and new repos are named."""
    return re.sub(r"[^a-z0-9.]+", "-", name.strip().lower()).strip("-.")


def add(url, rel=None):
    rel = rel or kebab(repo_name(url))
    if os.path.exists(f"{ROOT}/{rel}"):
        sys.exit(f"{ROOT}/{rel} already exists")
    ok, detail = clone_one({"path": rel, "url": url})
    print(f"{GREEN}✓ {rel}{RESET}  {DIM}{detail}{RESET}" if ok else f"{RED}✗ {rel}{RESET}  {detail}")
    if ok:
        scan(quiet=True)


def new_project(rel, template="", owner="", private=True, say=lambda msg: None):
    """A new project at ROOT/rel: from templates/<template> (copied without git, dependencies and build
    output) or a README, git init + a first commit, a GitHub repo under owner (if given, pushed), then
    recorded in the list. say(msg) reports progress. (ok, message)."""
    rel = rel.strip("/")
    path, name = f"{ROOT}/{rel}", os.path.basename(rel)
    if not name or os.path.exists(path):
        return False, f"{rel} already exists" if name else "no name"
    say("creating the folder…")
    if template:
        src = f"{ROOT}/templates/{template}"
        if not os.path.isdir(src):
            return False, f"no template {template}"
        shutil.copytree(src, path, symlinks=True, ignore=lambda _d, names: [n for n in names if n in TEMPLATE_SKIP])
    else:
        os.makedirs(path)
        with open(f"{path}/README.md", "w") as f:
            f.write(f"# {name}\n")
    for step in (["init", "-q", "-b", "main"], ["add", "-A"],
                 ["commit", "-q", "-m", "first commit" + (f" (from the {template} template)" if template else "")]):
        ok, out = git(path, *step)
        if not ok:
            return False, f"git {step[0]}: {last_line(out)}"
    if owner:
        say(f"creating {owner}/{name} on GitHub…")
        r = subprocess.run(["gh", "repo", "create", f"{owner}/{name}", "--private" if private else "--public",
                            "--source", path, "--push"], capture_output=True, text=True, timeout=300)
        if r.returncode:
            return False, "GitHub: " + last_line(r.stderr, "gh repo create failed") + " (the folder is made)"
    say("recording it…")
    scan(quiet=True)
    where = f"{owner}/{name} ({'private' if private else 'public'})" if owner else "no remote yet: local only"
    return True, f"created {rel}, {where}"


def forget(*rels):
    """Drop projects from the list, one commit for all of them."""
    data = load()
    rels = [r.strip("/") for r in rels]
    gone = [e["path"] for e in data["projects"] if e["path"] in rels]
    if not gone:
        sys.exit(f"not listed: {' '.join(rels)}")
    data["projects"] = [e for e in data["projects"] if e["path"] not in gone]
    data["pinned"] = [r for r in data["pinned"] if r not in gone]
    data["status"] = {r: st for r, st in data["status"].items() if r not in gone}
    save(data)
    problem = commit("forget " + ", ".join(gone))
    print("forgot " + ", ".join(gone) + (f"  {AMBER}{problem}{RESET}" if problem else ""))


def init_list():
    """Create the list: DIR as a git repo, the first scan, the private GitHub repo. (ok, message)."""
    if os.path.isdir(f"{DIR}/.git"):
        return False, f"{DIR} is already set up"
    user = gh_login()
    if not user:
        return False, "gh isn't logged in: run  gh auth login"
    os.makedirs(DIR, exist_ok=True)
    with open(f"{DIR}/README.md", "w") as f:
        f.write("# code-projects\n\nEvery project in ~/code and its git remotes, kept by `projects` "
                "(sami's dotfiles). Private: it names private and organisation repos.\n\n"
                "New PC: `gh auth login`, then `projects clone`.\n")
    git(DIR, "init", "-q", "-b", "main")
    scan(quiet=True)
    if not os.path.exists(LIST):
        save(load())   # an empty ~/code: an empty list
    git(DIR, "add", "-A")
    git(DIR, "commit", "-q", "-m", "first scan")
    r = subprocess.run(["gh", "repo", "create", f"{user}/{REPO_NAME}", "--private", "--source", DIR, "--push",
                        "--description", "Every project in ~/code (projects)"], capture_output=True, text=True)
    if r.returncode:
        return False, "couldn't create the GitHub repo (the list is saved locally): " + last_line(r.stderr)
    return True, f"list: {LIST}  (private: github.com/{user}/{REPO_NAME})"


def main():
    args = sys.argv[1:]
    cmd = args.pop(0) if args else "status"
    if cmd == "status":
        status()
    elif cmd == "scan":
        scan(dry="-n" in args)
    elif cmd in ("clone", "pull"):
        clone(args)
    elif cmd == "arrange":
        if not os.path.exists(LIST):
            sys.exit("no list here yet: projects clone (fetch yours) or projects init (start one)")
        if not arrange(dry="-n" in args):
            print("everything is where the list says")
        elif "-n" not in args:
            scan()
    elif cmd == "new" and args:
        rel, opts = args[0], args[1:]

        def opt(flag):
            return opts[opts.index(flag) + 1] if flag in opts and opts.index(flag) + 1 < len(opts) else ""
        ok, msg = new_project(rel, opt("--template"), opt("--github"), "--public" not in opts, say=print)
        print(msg) if ok else sys.exit(msg)
    elif cmd == "add" and args:
        add(*args[:2])
    elif cmd == "forget" and args:
        forget(*args)
    elif cmd == "sync":
        dry = "-n" in args
        rels = [a.strip("/") for a in args if a != "-n"] or [e["path"] for e in load()["projects"]
                                                              if is_repo(f"{ROOT}/{e['path']}")]
        for rel in rels:
            r = sync(rel, dry)
            bits = [f"{k} {', '.join(r[k])}" for k in ("updated", "created", "deleted") if r[k]]
            bits += [f"{AMBER}skipped {b}: {why}{RESET}" for b, why in r["skipped"]]
            bits += [f"{RED}diverged {b}" + (f" (would clash: {', '.join(f)})" if f else "") + RESET for b, f in r["diverged"]]
            if r["error"]:
                bits = [f"{RED}{r['error']}{RESET}"]
            if bits:
                print(f"{rel}: " + "; ".join(bits))
        if dry:
            print(f"{DIM}(nothing changed: -n){RESET}")
    elif cmd in ("pin", "unpin") and args:
        problem = pin(args[0], cmd == "pin")
        print(f"{cmd}ned {args[0]}" + (f"  {AMBER}{problem}{RESET}" if problem else ""))
    elif cmd == "mark" and len(args) == 2:
        if args[1] not in STATUSES + ["none"]:
            sys.exit(f"no status {args[1]}: {', '.join(STATUSES)} or none")
        problem = mark(*args)
        if problem.startswith("not listed"):
            sys.exit(problem)
        print(f"{args[0]}: {args[1]}" + (f"  {AMBER}{problem}{RESET}" if problem else ""))
    elif cmd == "move" and len(args) == 2:
        ok, msg = move(*args)
        print(msg) if ok else sys.exit(msg)
    elif cmd == "delete-github" and args:
        rel = args[0].strip("/")
        repo = github_repo(remotes(f"{ROOT}/{rel}").get("origin", "")) if is_repo(f"{ROOT}/{rel}") else None
        if not repo:
            sys.exit(f"{rel} has no GitHub origin")
        if "-y" not in args and input(f"delete {repo} on GitHub? type its name: ").strip() != repo.split("/")[1]:
            return
        ok, msg, scope = delete_on_github(rel)
        print(msg) if ok else sys.exit(msg + ("\n(gh auth refresh -h github.com -s delete_repo)" if scope else ""))
    elif cmd in ("delete", "delete-git") and args:
        rel = args[0].strip("/")
        if not os.path.exists(f"{ROOT}/{rel}"):
            sys.exit(f"no folder {rel} in {ROOT}")
        if "-y" not in args:
            risk = at_risk(rel)
            what = "its .git (history, branches)" if cmd == "delete-git" else "the whole folder"
            print(f"deletes {what} of {rel}" + (f"; only here: {', '.join(risk)}" if risk else ""))
            if input("sure? [y/N] ").strip().lower() != "y":
                return
        ok, msg = (delete_git if cmd == "delete-git" else delete)(rel)
        print(msg) if ok else sys.exit(msg)
    elif cmd == "init":
        ok, msg = init_list()
        print(msg) if ok else sys.exit(msg)
    elif cmd == "env":
        sub, rest = (args[0] if args else "status"), [a.strip("/") for a in args[1:]]
        if sub == "passphrase":
            import getpass
            phrase = getpass.getpass("passphrase for the .env copies: ")
            if not phrase or (not os.path.isdir(ENV_DIR) and getpass.getpass("again: ") != phrase):
                sys.exit("not set")
            problem = set_passphrase(phrase)
            print(problem or "kept in the keyring") if not problem else sys.exit(problem)
        elif sub in ("push", "pull"):
            ok, msg = (env_push if sub == "push" else env_pull)(rest or None)
            print(msg) if ok else sys.exit(msg)
        else:
            colour = {"synced": GREEN, "changed here": AMBER, "newer there": AMBER, "both changed": RED,
                      "not synced": AMBER, "only there": AMBER, "": DIM}
            for st in env_status(rest or None):
                print(f"{colour[st['state']]}{st['state'] or 'no passphrase':13}{RESET} {st['key']}" +
                      (f"  {RED}missing: {', '.join(st['missing'])}{RESET}" if st["missing"] else ""))
    elif cmd in ("up", "down") and args:
        ok, msg = (up if cmd == "up" else down)(args[0], report=lambda m: print(f"{DIM}{m}{RESET}"))
        print(msg) if ok else sys.exit(msg)
    elif cmd == "running":
        rels = [a.strip("/") for a in args if a != "-j"] or [e["path"] for e in load()["projects"] + load()["local_only"]
                                                             if run_setup(e["path"])["compose"] or run_setup(e["path"])["commands"]]
        states = {r: running(r) for r in rels}
        if "-j" in args:
            print(json.dumps(states))
        for r, st in ([] if "-j" in args else states.items()):
            if st["compose"] or st["commands"]:
                print(f"{GREEN}▶{RESET} {r}: " + ", ".join(st["commands"] + [f"{s} (docker)" for s in st["compose"]]))
    elif cmd == "run-setup" and args:
        if "--reset" in args:
            problem = set_run_setup(args[0], None)
        elif "--json" in args:
            problem = set_run_setup(args[0], json.loads(args[args.index("--json") + 1]))
        else:
            problem = ""
        print(json.dumps(run_setup(args[0]), indent=1) + (f"\n{AMBER}{problem}{RESET}" if problem else ""))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
