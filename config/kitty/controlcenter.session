# Control Center (workspace 6): the waybar tools in one kitty window.
# Launched by `wsgroups launch 6` (see ~/.config/hypr/workspaces.conf). Quitting a tool restarts it.
#
# "splits" layout: every border belongs to one split, so dragging it (or ctrl+shift+r)
# resizes only the two panes next to it.
#
#   ┌──────────┬───────────┐
#   │ Groups   │ Shortcuts │
#   │          ├───────────┤
#   ├──────────┤ Network   │
#   │ Audio    ├───────────┤
#   │          │ System    │
#   └──────────┴───────────┘
layout splits
launch --title Groups    --var panel=groups                                        sh -c "exec ~/.config/hypr/scripts/panel.sh ~/.local/bin/wsgroups"
launch --title Shortcuts --var panel=shortcuts --location=vsplit                   sh -c "exec ~/.config/hypr/scripts/panel.sh ~/.config/hypr/scripts/keys.py"
launch --title Network   --var panel=network   --location=hsplit --bias=70         sh -c "exec ~/.config/hypr/scripts/panel.sh nmtui"
launch --title System    --var panel=system    --location=hsplit --bias=55         sh -c "exec ~/.config/hypr/scripts/panel.sh ~/.config/hypr/scripts/sysmon.py"
focus_matching_window title:^Groups$
launch --title Audio     --var panel=audio     --location=hsplit            sh -c "exec ~/.config/hypr/scripts/panel.sh wiremix"
focus_matching_window title:^Groups$
