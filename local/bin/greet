#!/usr/bin/env python3
"""greet — the terminal greeting (fish_greeting): a slowly spinning 3D bagel beside a system
summary, laid out for the terminal it opens in.

The bagel is a torus drawn as text (after Andy Sloane's donut.c): rotated, lit from above-behind and
shaded cell by cell in Tokyo Night blues. It turns slowly until you press a key; that key still
reaches the shell (it is never read here), so you can just start typing. A resize stops it too.
The spin is a seamless loop of LOOP frames. Drawing one costs tens of ms of Python, so each loop is
drawn once per bagel size, as it plays, and kept in ~/.cache/greet/: after that a frame is a copy.
Only the bagel's rows are redrawn, and a colour is only sent where it changes.

The summary comes from fastfetch's JSON (fastfetch --format json). Layout, by the terminal's width:
  from BAGEL   the bagel (about 36 % of the width, as tall as the window allows) beside the summary
  from NARROW  the summary alone, full width
  below        nothing (agentmux's terminal column, a VS Code kitty: it would only wrap)
The sections (a heading and its rows, no border) fill the width they get: system and desktop side by
side when both fit, hardware below; the bars grow with them, a value too long is cut with "…".

  greet            animated (a still frame when the output isn't a terminal)
  greet --still    no animation
"""
import json, math, os, select, shutil, signal, subprocess, sys, termios, time, unicodedata

FPS = 10              # slow and calm; also what an uncached first loop can afford to draw
LOOP = 120            # frames per full turn (12 s): the cache holds one loop
SHADES = " .,-~:;=!*#$@"    # blank, then dim to bright
NARROW, BAGEL = 60, 90      # columns: below NARROW nothing, from BAGEL the bagel too
GAP = 4                     # columns between the bagel and the summary, and between two sections
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "greet")

sys.path.insert(0, os.path.expanduser("~/.local/lib/theme"))
try:   # the colour theme (local/bin/theme): the colours below are Tokyo Night's, recolored to the active theme's
    from themelib import recolor
except ImportError:
    def recolor(text, tid=None):
        return text

# Tokyo Night (AGENTS.md "Colours")
LINE, MUTED, SUB, TEXT, ACCENT = (recolor(c) for c in ("#3b4261", "#565f89", "#a9b1d6", "#c0caf5", "#6b8fe0"))
GREEN, AMBER, RED, MAGENTA, CYAN = (recolor(c) for c in ("#9ece6a", "#e0af68", "#f7768e", "#bb9af7", "#7dcfff"))
RESET, BOLD = "\x1b[0m", "\x1b[1m"


def fg(hexcolour):
    h = hexcolour.lstrip("#")
    return f"\x1b[38;2;{int(h[0:2], 16)};{int(h[2:4], 16)};{int(h[4:6], 16)}m"


def mix(a, b, t):
    pa, pb = [int(a[i:i + 2], 16) for i in (1, 3, 5)], [int(b[i:i + 2], 16) for i in (1, 3, 5)]
    return "#" + "".join(f"{round(x + (y - x) * t):02x}" for x, y in zip(pa, pb))


# a shade's colour, dim to bright: the line colour, through the accent blue, to the text white
RAMP = [""] + [fg(mix(LINE, ACCENT, i / 6)) for i in range(7)] + [fg(mix(ACCENT, TEXT, i / 5)) for i in range(1, 6)]


def width(s):
    """Cells a string takes (escapes skipped; Nerd Font icons one cell, wide CJK two)."""
    w, esc = 0, False
    for ch in s:
        if esc:
            esc = ch != "m"
        elif ch == "\x1b":
            esc = True
        else:
            w += 2 if unicodedata.east_asian_width(ch) in "WF" else 0 if unicodedata.combining(ch) else 1
    return w


def cut(s, n):
    """s (plain text) in at most n cells, "…" where it was cut."""
    if width(s) <= n:
        return s
    out = ""
    for ch in s:
        if width(out + ch) > n - 1:
            break
        out += ch
    return out + "…"


# ---- the bagel ---------------------------------------------------------------------------------
class Bagel:
    """A torus in w x h cells: frame k of a loop, as h strings of shade characters (colour comes at
    drawing). Its sample points scale with the size; their sines are worked out once."""
    R1, R2, K2 = 1.0, 2.0, 5.0

    def __init__(self, w, h):
        self.w, self.h = w, h
        # a cell is about twice as tall as wide: the vertical scale is halved; fit both ways
        self.k1 = min(w, 2 * h) * self.K2 * 3 / (8 * (self.R1 + self.R2)) * 0.82
        steps = max(w, 2 * h)
        self.thetas = [(math.cos(t), math.sin(t)) for t in frange(0, 2 * math.pi, 3.6 / steps)]
        self.phis = [(math.cos(p), math.sin(p)) for p in frange(0, 2 * math.pi, 1.5 / steps)]
        self.path = os.path.join(CACHE, f"bagel-{w}x{h}-{LOOP}.json")
        try:
            self.frames = json.load(open(self.path))
        except (OSError, ValueError):
            self.frames = []
        self.frames = self.frames if len(self.frames) == LOOP else []

    def get(self, k):
        """Frame k (0 … LOOP-1): from the cache, else drawn now; the whole loop is saved once done."""
        if len(self.frames) > k:
            return self.frames[k]
        frame = self.draw(2 * math.pi * k / LOOP)
        if len(self.frames) == k:
            self.frames.append(frame)
            if len(self.frames) == LOOP:
                try:
                    os.makedirs(CACHE, exist_ok=True)
                    with open(self.path + ".tmp", "w") as f:
                        json.dump(self.frames, f)
                    os.replace(self.path + ".tmp", self.path)
                    # one loop per window size seen: keep the 8 most recent (~200 KB each)
                    kept = sorted((os.path.join(CACHE, n) for n in os.listdir(CACHE) if n.startswith("bagel-")),
                                  key=os.path.getmtime, reverse=True)
                    for old in kept[8:]:
                        os.remove(old)
                except OSError:
                    pass
        return frame

    def draw(self, t):
        """The torus at loop phase t (0 … 2π): turned once about x and twice about z per loop, so the
        last frame meets the first."""
        w, h, k1, R1, R2, K2 = self.w, self.h, self.k1, self.R1, self.R2, self.K2
        a, b = t + 1.0, 2 * t + 0.6
        zbuf = [0.0] * (w * h)
        lum_at = [0.0] * (w * h)
        ca, sa, cb, sb = math.cos(a), math.sin(a), math.cos(b), math.sin(b)
        for ct, st in self.thetas:
            cx, cy = R2 + R1 * ct, R1 * st
            for cp, sp in self.phis:
                x = cx * (cb * cp + sa * sb * sp) - cy * ca * sb
                y = cx * (sb * cp - sa * cb * sp) + cy * ca * cb
                ooz = 1 / (K2 + ca * cx * sp + cy * sa)
                xp = int(w / 2 + k1 * ooz * x)
                yp = int(h / 2 - k1 * ooz * y / 2)
                if 0 <= xp < w and 0 <= yp < h:
                    i = yp * w + xp
                    if ooz > zbuf[i]:
                        zbuf[i] = ooz
                        lum_at[i] = cp * ct * sb - ca * ct * sp - sa * st + cb * (ca * st - ct * sa * sp)
        top = len(SHADES) - 1
        rows = []
        for y in range(h):
            row = []
            for x in range(w):
                i = y * w + x
                # lit from above-behind: lum runs about -√2…√2; the far side stays faint, never blank
                row.append(SHADES[max(1, min(top, int((lum_at[i] + 1.2) / 2.6 * (top - 1) + 1.5)))]
                           if zbuf[i] else " ")
            rows.append("".join(row))
        return rows


def paint(row):
    """A row of shade characters in colour; a colour code only where it changes."""
    out, last = [], None
    for ch in row:
        i = SHADES.index(ch)
        if i and i != last:
            out.append(RAMP[i])
            last = i
        out.append(ch)
    return "".join(out) + RESET


def frange(start, stop, step):
    while start < stop:
        yield start
        start += step


# ---- the facts ---------------------------------------------------------------------------------
def facts():
    """{module type: result} from fastfetch's JSON."""
    mods = "Title:OS:Kernel:Packages:Uptime:WM:Terminal:Shell:TerminalFont:Theme:CPU:GPU:Display:Memory:Swap:Disk:LocalIp"
    try:
        out = subprocess.run(["fastfetch", "--format", "json", "-s", mods], capture_output=True, text=True, timeout=5).stdout
        return {m["type"]: m.get("result") for m in json.loads(out)}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}


def get(f, kind, *path, default=None):
    v = f.get(kind)
    for p in path:
        v = v.get(p) if isinstance(v, dict) else None
    return v if v not in (None, "") else default


def shell():
    """The shell that runs this greeting (its parent) and its version. Not fastfetch's: its parent
    is this script."""
    try:
        name = open(f"/proc/{os.getppid()}/comm").read().strip()
        out = subprocess.run([name, "--version"], capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    version = next((w for w in out.replace(",", " ").split() if w[:1].isdigit()), "")
    return f"{name} {version}".strip()


def sections(f):
    """[(title, icon, [(icon, key, value)])]: value is text, or ("bar", used, total) for a level."""
    up = (get(f, "Uptime", "uptime", default=0) or 0) // 1000
    days, hours, mins = up // 86400, up % 86400 // 3600, up % 3600 // 60
    uptime = (f"{days} d " if days else "") + (f"{hours} h " if hours or days else "") + f"{mins} min"
    pkgs = get(f, "Packages", default={}) or {}
    font = get(f, "TerminalFont", "font", default={}) or {}
    cpu = get(f, "CPU", default={}) or {}
    freq = (cpu.get("frequency") or {}).get("max")
    gpus = [g["name"] for g in (get(f, "GPU", default=[]) or []) if g.get("type") != "Integrated" and g.get("name")]
    shows = [f"{d['output']['width']}x{d['output']['height']} @ {round(d['output']['refreshRate'])} Hz"
             for d in (get(f, "Display", default=[]) or []) if d.get("output")]
    mem = get(f, "Memory", default={}) or {}
    swaps = get(f, "Swap", default=[]) or []
    disks = [d for d in (get(f, "Disk", default=[]) or [])
             if d.get("mountpoint") == "/" or str(d.get("mountpoint", "")).startswith("/mnt/")]
    ip = next((i.get("ipv4") for i in (get(f, "LocalIp", default=[]) or []) if i.get("ipv4")), None)
    theme = ", ".join(t for t in (get(f, "Theme", "theme2"), get(f, "Theme", "theme1")) if t)
    joined = lambda *parts: " ".join(str(p) for p in parts if p) or None

    system = [("", "os", joined(get(f, "OS", "name"), get(f, "Kernel", "architecture"))),
              ("", "kernel", get(f, "Kernel", "release")),
              ("\U000f03d7", "packages", f"{pkgs['all']} (pacman)" if pkgs.get("all") else None),
              ("\U000f0954", "uptime", uptime)]
    desktop = [("", "wm", joined(get(f, "WM", "prettyName"), get(f, "WM", "version"))),
               ("", "terminal", joined(get(f, "Terminal", "prettyName"), get(f, "Terminal", "version"))),
               ("", "shell", shell()),
               ("", "font", font.get("pretty") or joined(font.get("name"), font.get("size") and f"{font['size']}pt")),
               ("\U000f03d8", "theme", theme or None)]
    hardware = [("", "cpu", joined(cpu.get("cpu"), cpu.get("cores") and f"({cpu['cores'].get('logical')})",
                                         freq and f"@ {freq / 1000:.2f} GHz") if cpu.get("cpu") else None),
                *[("\U000f0379", "gpu", g) for g in gpus],
                *[("\U000f0379", "display", d) for d in shows],
                ("", "memory", ("bar", mem["used"], mem["total"]) if mem.get("total") else None),
                ("\U000f04b9", "swap", ("bar", sum(s["used"] for s in swaps), sum(s["total"] for s in swaps))
                 if sum(s.get("total", 0) for s in swaps) else None),
                *[("\U000f02ca", d["mountpoint"], ("bar", d["bytes"]["used"], d["bytes"]["total"])) for d in disks],
                ("\U000f0200", "network", ip)]
    return [(t, icon, [r for r in rows if r[2]]) for t, icon, rows in
            (("system", "", system), ("desktop", "", desktop), ("hardware", "", hardware))]


# ---- the sections ---------------------------------------------------------------------------------
def section(title, icon, rows, w, key_w):
    """A section exactly w cells wide, no border: a heading (icon, bold title, a thin rule to the
    right edge, as on the GTK panels), then a row per fact (icon, the key in grey, the value in
    white; a level is a bar and aligned numbers), then a blank line."""
    head = f"{fg(ACCENT)}{icon}  {fg(SUB)}{BOLD}{title}{RESET} "
    out = [head + f"{fg(LINE)}{'─' * max(w - width(head), 0)}{RESET}"]
    room = w - (2 + 1 + 2 + key_w)   # after "  icon  key"
    levels = [v for _, _, v in rows if isinstance(v, tuple)]
    num_w = max((len(f"{v[1] / 2 ** 30:.1f}") for v in levels), default=0)
    tot_w = max((len(f"{v[2] / 2 ** 30:.1f}") for v in levels), default=0)
    tail_w = num_w + 3 + tot_w + 4 + 6            # "used / total GiB  100%"
    cells = max(6, min(36, room - tail_w - 2))
    for icon_, key, value in rows:
        lead = f"  {fg(ACCENT)}{icon_}  {fg(MUTED)}{key:<{key_w}}"
        if isinstance(value, tuple):
            _, used, total = value
            pct = used / total if total else 0
            colour = GREEN if pct < .6 else AMBER if pct < .85 else RED
            n = round(pct * cells)
            text = (f"{fg(colour)}{'━' * n}{fg(LINE)}{'━' * (cells - n)}{RESET}  "
                    f"{fg(TEXT)}{used / 2 ** 30:>{num_w}.1f}{fg(MUTED)} / {fg(TEXT)}{total / 2 ** 30:>{tot_w}.1f}"
                    f"{fg(MUTED)} GiB  {fg(colour)}{pct * 100:>3.0f}%{RESET}")
        else:
            text = f"{fg(TEXT)}{cut(value, room)}{RESET}"
        body = lead + text
        out.append(body + " " * max(w - width(body), 0))
    return out + [" " * w]


def panel(f, w):
    """The summary, w cells wide: a header, then the sections (two side by side when they fit)."""
    secs = sections(f)
    key_w = max(len(k) for _, _, rows in secs for _, k, _ in rows) + 2
    t = f.get("Title") or {}
    user, host = t.get("userName", os.environ.get("USER", "")), t.get("hostName", os.uname().nodename)
    sub = " · ".join(x for x in (get(f, "OS", "prettyName"), joined_wm(f)) if x)
    left = (f"{fg(ACCENT)}{BOLD}{user}{RESET}{fg(MUTED)}@{fg(ACCENT)}{BOLD}{host}{RESET}"
            + (f"  {fg(MUTED)}{sub}{RESET}" if sub else ""))
    when = time.strftime("%A %d %B")
    if width(left) + len(when) + 2 > w:
        when = ""
    out = [left + " " * max(w - width(left) - len(when), 1) + f"{fg(MUTED)}{when}{RESET}", ""]
    half = (w - GAP) // 2
    first, second, hardware = secs
    if half >= key_w + 38:   # each of the two still holds a whole line
        a, b = section(*first, half, key_w), section(*second, w - GAP - half, key_w)
        for i in range(max(len(a), len(b))):
            out.append((a[i] if i < len(a) else " " * half) + " " * GAP
                       + (b[i] if i < len(b) else " " * (w - GAP - half)))
    else:
        out += section(*first, w, key_w) + section(*second, w, key_w)
    return out + section(*hardware, w, key_w)[:-1]


def joined_wm(f):
    name, version = get(f, "WM", "prettyName"), get(f, "WM", "version")
    return f"{name} {version}" if name and version else name


# ---- layout and drawing ------------------------------------------------------------------------
def layout(cols, rows):
    """(bagel w, h, panel w) for this terminal; bagel w 0 when there's no room for it."""
    margin = 2
    if cols < BAGEL:
        return 0, 0, cols - 2 * margin
    bw = max(28, min(int(cols * 0.36), 76))
    bh = min(bw // 2, max(rows - 4, 12))   # leaves the prompt room below it
    bw = min(bw, bh * 2 + 2)               # a short window: a narrower bagel, still round
    return bw, bh, cols - 2 * margin - bw - GAP


def main():
    cols, rows = shutil.get_terminal_size((120, 40))
    if cols < NARROW:
        return
    bw, bh, pw = layout(cols, rows)
    right = panel(facts(), pw)
    bagel = Bagel(bw, bh) if bw else None
    h = max(len(right), bh)
    top = max((h - bh) // 2, 0)                    # the bagel's first row in the block
    rtop = max((h - len(right)) // 2, 0)           # the panel's, if the bagel is the taller
    first = bagel.get(0) if bagel else []
    lines = []
    for i in range(h):
        b = paint(first[i - top]) if bagel and 0 <= i - top < bh else " " * bw
        r = right[i - rtop] if 0 <= i - rtop < len(right) else ""
        lines.append("  " + (b + " " * GAP if bw else "") + r)
    sys.stdout.write("\n".join(lines) + "\n")
    if (not bagel or h >= rows or "--still" in sys.argv   # h >= rows: it scrolled, the rows aren't where they were
            or not (sys.stdout.isatty() and sys.stdin.isatty())):
        sys.stdout.write("\n")
        return

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    new = termios.tcgetattr(fd)
    new[3] &= ~(termios.ICANON | termios.ECHO)   # keys readable one by one (left unread), no echo
    termios.tcsetattr(fd, termios.TCSANOW, new)
    resized = []
    signal.signal(signal.SIGWINCH, lambda *_: resized.append(1))
    out = sys.stdout
    out.write("\x1b[?25l")
    start, n = time.time(), 0
    try:
        while not resized:
            n += 1
            frame = bagel.get(n % LOOP)
            # up to the bagel's first row, then each of its rows in place (the panel stays as it is)
            out.write(f"\x1b[{h - top}F" + "".join(f"\x1b[3G{paint(r)}\x1b[1E" for r in frame)
                      + (f"\x1b[{h - top - bh}E" if h - top - bh else ""))
            out.flush()
            wait = start + n / FPS - time.time()
            if select.select([fd], [], [], max(wait, 0))[0]:
                break                                  # a key: stop here, the key is the shell's
    except KeyboardInterrupt:
        pass
    finally:
        out.write("\x1b[?25h\n")
        out.flush()
        termios.tcsetattr(fd, termios.TCSANOW, old)


if __name__ == "__main__":
    main()
