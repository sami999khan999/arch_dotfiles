# Theme: bloodborne — palette taken from the wallpaper

# Main bg
theme[main_bg]="#0f0c0c"

# Main text color
theme[main_fg]="#d8cbb8"

# Title color for boxes
theme[title]="#d8cbb8"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#a3302a"

# Background color of selected item in processes box
theme[selected_bg]="#3d2f2c"

# Foreground color of selected item in processes box
theme[selected_fg]="#ece2d3"

# Color of inactive/disabled text
theme[inactive_fg]="#7a6a5c"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#9a4a38"

# Cpu box outline color
theme[cpu_box]="#4a3a36"

# Memory/disks box outline color
theme[mem_box]="#4a3a36"

# Net up/down box outline color
theme[net_box]="#4a3a36"

# Processes box outline color
theme[proc_box]="#4a3a36"

# Box divider line and small boxes line color
theme[div_line]="#4a3a36"

# Temperature graph colors
theme[temp_start]="#7d8b65"
theme[temp_mid]="#c9a25e"
theme[temp_end]="#7d1a14"

# CPU graph colors
theme[cpu_start]="#7d8b65"
theme[cpu_mid]="#c9a25e"
theme[cpu_end]="#7d1a14"

# Mem/Disk free meter
theme[free_start]="#7d8b65"
theme[free_mid]="#c9a25e"
theme[free_end]="#7d1a14"

# Mem/Disk cached meter
theme[cached_start]="#7d8b65"
theme[cached_mid]="#c9a25e"
theme[cached_end]="#7d1a14"

# Mem/Disk available meter
theme[available_start]="#7d8b65"
theme[available_mid]="#c9a25e"
theme[available_end]="#7d1a14"

# Mem/Disk used meter
theme[used_start]="#7d8b65"
theme[used_mid]="#c9a25e"
theme[used_end]="#7d1a14"

# Download graph colors
theme[download_start]="#7d8b65"
theme[download_mid]="#c9a25e"
theme[download_end]="#7d1a14"

# Upload graph colors
theme[upload_start]="#7d8b65"
theme[upload_mid]="#c9a25e"
theme[upload_end]="#7d1a14"

