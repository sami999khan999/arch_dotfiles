#!/usr/bin/env python3
"""codesync — keep ~/code (fast SSD) backed up to /mnt/data/code (HDD), in the background.

  codesync status     last sync, whether the service is running, what's configured
  codesync now        sync right away (the service does this by itself a few seconds after changes)
  codesync pause      stop syncing until resumed (changes are still noticed, and synced on resume)
  codesync resume
  codesync setup      choose this PC's code folder and backup folder (asked by enable the first time;
                      the Code Sync panel can change them too)
  codesync move <from> <to>
                      move a folder inside the code folder (paths relative to it), and its backup copy
                      with it, so the next sync finds it in place: no copying it all again, no old copy
                      in the trash. `projects move` (the Projects panel's Move) uses it
  codesync restore    copy the backup into the code folder (never deletes; skips the ignore list).
                      Needed when the code folder is empty: syncing is held until then. Alias: pull
  codesync enable     install and start the background service (systemd --user), also at login
  codesync disable    stop it and remove it from login
  codesync log        follow the service log
  codesync ignore     open the ignore list in $EDITOR
  codesync bar        waybar module (one JSON line)
  codesync watch      the service itself: watch ~/code, sync after changes settle

How it syncs: rsync mirrors the SSD onto the HDD. Files deleted or overwritten on the HDD are not
lost: they are moved to /mnt/data/.code-trash/<date>/ and cleaned after trash_days days.
Ignored files (~/.config/codesync/ignore, plus any .syncignore inside ~/code) are never copied, and
if they already exist on the HDD they are left alone there.

An empty code folder next to a non-empty backup is never mirrored (that would empty the backup):
the service holds with status "restore" until `codesync restore` fills the code folder back up.

Timing lives in ~/.config/codesync/settings.json (the panel edits it; the service rereads it live).
Live status for waybar and the panel: ~/.local/state/codesync.json.
"""
import ctypes, datetime, fcntl, json, os, re, select, shutil, signal, struct, subprocess, sys, time
from fnmatch import fnmatch

CONF_DIR = os.path.expanduser("~/.config/codesync")
IGNORE = f"{CONF_DIR}/ignore"
SETTINGS = f"{CONF_DIR}/settings.json"   # shared by every PC (in git)
MACHINE = f"{CONF_DIR}/machine.json"     # this PC's folders (gitignored): written by `codesync setup`


def mount_of(path):
    """The mount point that holds path (or would, for a folder that doesn't exist yet)."""
    path = os.path.realpath(os.path.expanduser(path))
    while not os.path.ismount(path):
        path = os.path.dirname(path)
    return path


def machine():
    try:
        return json.load(open(MACHINE))
    except (OSError, json.JSONDecodeError):
        return {}


_m = machine()
SRC = os.path.expanduser(_m.get("src", "~/code"))           # the code, on the fast drive
DST = os.path.expanduser(_m.get("dst", "/mnt/data/code"))   # the backup, on the other drive
MOUNT = _m.get("mount", "/mnt/data")                        # the drive DST lives on


def trash_of(dst):
    return os.path.join(os.path.dirname(dst), ".code-trash")  # old versions, next to the backup


TRASH = trash_of(DST)
STATE_DIR = os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state"))
STATE = f"{STATE_DIR}/codesync.json"
PAUSED = f"{STATE_DIR}/codesync.paused"  # exists = paused (not in settings.json: that one is in git)
LOCK = f"{STATE_DIR}/codesync.lock"     # held by every rsync run: a sync waits for a restore to finish
RESTORING = f"{STATE_DIR}/codesync.restoring"  # pid of a running restore
UNIT = os.path.expanduser("~/.config/systemd/user/codesync.service")
WAYBAR_SIGNAL = 11
RECENT = 200  # changed paths remembered for the panel

DEFAULTS = {
    "quiet": 3,          # seconds without changes before syncing
    "max_wait": 30,      # ...but never wait longer than this while changes keep coming
    "full_every": 900,   # a full sync this often anyway, in case a change was missed (seconds)
    "trash_days": 30,    # keep deleted / overwritten versions this many days
}


def log(msg):
    print(msg, flush=True)


def notify(msg, urgency="normal"):
    subprocess.run(["notify-send", "-u", urgency, "-a", "codesync", "Code sync", msg], capture_output=True)


def settings():
    s = dict(DEFAULTS)
    try:
        s.update({k: v for k, v in json.load(open(SETTINGS)).items() if k in DEFAULTS})
    except (OSError, json.JSONDecodeError):
        pass
    return s


# ---- state (read by waybar and the panel) --------------------------------------------------------
def load_state():
    try:
        return json.load(open(STATE))
    except (OSError, json.JSONDecodeError):
        return {}


def save_state(**kw):
    os.makedirs(STATE_DIR, exist_ok=True)
    state = load_state()
    before = state.get("status")
    state.update(kw)
    with open(STATE + ".tmp", "w") as f:
        json.dump(state, f)
    os.replace(STATE + ".tmp", STATE)  # readers never see half a file
    if kw.get("status", before) != before or "last_sync" in kw:
        subprocess.run(["pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "-x", "waybar"])


def status(s, detail=""):
    save_state(status=s, detail=detail, status_at=time.time())


# ---- ignore list ---------------------------------------------------------------------------------
def ignore_patterns():
    """(folder patterns, file patterns) from the ignore list, for Python-side matching."""
    dirs, files = [], []
    try:
        for line in open(IGNORE):
            line = line.strip()
            if not line or line.startswith("#") or line.startswith("/"):
                continue
            (dirs if line.endswith("/") else files).append(line.rstrip("/"))
    except OSError:
        pass
    return dirs, files


def rsync_filters():
    # --chmod: a read-only folder (e.g. copied from Windows) would otherwise be created read-only on
    # the NTFS drive, and rsync copies that mode onto the matching .code-trash folders — after which
    # it can't create anything inside them, and every sync with a deletion fails
    args = ["--chmod=Du+w", "--filter=:- .syncignore"]  # per-folder ignore files
    if os.path.exists(IGNORE):
        args.append(f"--exclude-from={IGNORE}")
    return args


# ---- safety checks -------------------------------------------------------------------------------
def has_entries(path):
    try:
        return bool(os.listdir(path))
    except OSError:
        return False


def needs_restore(src=None, dst=None):
    """The code folder is empty (or missing) but the backup isn't: mirroring would empty the backup."""
    return not has_entries(src or SRC) and has_entries(dst or DST)


def restoring():
    """True while a `codesync restore` is running."""
    try:
        os.kill(int(open(RESTORING).read()), 0)
        return True
    except (OSError, ValueError):
        return False


def restore_detail():
    tot = load_state().get("totals") or {}
    if tot.get("files"):
        return f"code folder is empty; the backup has {tot['files']:,} files ({human(tot['size'])})"
    try:
        n = len(os.listdir(DST))
    except OSError:
        n = 0
    return f"code folder is empty; the backup has {n} folder(s)"


def problem():
    """Why a sync must not run right now, or None."""
    if not os.path.exists(MACHINE):
        return "not set up on this PC yet (run `codesync setup`)"
    if not os.path.ismount(MOUNT):
        return f"the backup drive is not mounted at {MOUNT}"
    if needs_restore():
        # an empty code folder would mirror as "delete everything" — hold until it's restored
        return restore_detail()
    if not os.path.isdir(SRC):
        return f"{SRC} does not exist"
    return None


def report_problem(why):
    """Show why nothing syncs: "restore" (amber, fixable from the panel) or "error"."""
    if restoring():
        return  # the restore owns the status while it runs
    status("restore" if needs_restore() and os.path.ismount(MOUNT) else "error", why)


def check_folders(src, dst):
    """(error, warning) for using src as the code folder and dst as the backup."""
    src, dst = (os.path.abspath(os.path.expanduser(p)) for p in (src, dst))
    if src == dst or dst.startswith(src + os.sep) or src.startswith(dst + os.sep):
        return "the code folder and the backup folder must be separate (neither inside the other)", None
    mount = mount_of(dst)
    if mount == mount_of(src):
        return None, (f"{dst} is on the same drive as {src} ({mount}): that protects against deleted "
                      "files, but not against that drive failing")
    if mount == "/":
        return None, f"{dst} is on the system drive, not a separate mount. Is the other drive mounted?"
    return None, None


def save_machine(src, dst):
    """Save this PC's two folders (machine.json, not in git) and point the running service at them."""
    src, dst = (os.path.abspath(os.path.expanduser(p)) for p in (src, dst))
    os.makedirs(CONF_DIR, exist_ok=True)
    with open(MACHINE, "w") as f:
        json.dump({"src": src.replace(os.path.expanduser("~"), "~", 1), "dst": dst, "mount": mount_of(dst)},
                  f, indent=2)
        f.write("\n")
    save_state(totals={}, last_error=None)  # the old totals describe the old backup
    if service_pid():
        subprocess.run(["systemctl", "--user", "restart", "codesync.service"])


# ---- syncing -------------------------------------------------------------------------------------
ITEM = re.compile(r"^(\*deleting|[<>ch.*][fdLDS][^ ]{9}) +(.*)$")


def num(pattern, text):
    m = re.search(pattern, text)
    return int(m.group(1).replace(",", "")) if m else 0


def mirror_cmd(src, dst):
    """rsync that makes dst an exact copy of src; replaced/deleted files go to the trash folder."""
    day = datetime.date.today().isoformat()
    return ["rsync", "-rlt", "--delete", "--backup", f"--backup-dir={trash_of(dst)}/{day}",
            "--itemize-changes", "--stats", *rsync_filters(), f"{src}/", f"{dst}/"]


def parse_changes(out):
    """[(op, path)] from rsync --itemize-changes: + new, ~ updated, - deleted."""
    changes = []
    for line in out.splitlines():
        m = ITEM.match(line)
        if not m or m.group(1).startswith(".d"):
            continue  # folder timestamp touch-ups aren't worth showing
        flags, path = m.groups()
        changes.append(("-" if flags == "*deleting" else "+" if "+++" in flags else "~", path))
    return changes


def preview(src, dst):
    """What mirroring src onto dst would do, without doing it: {"new", "updated", "removed"} counts,
    or {"error": …}. For the panel, before it switches folders."""
    src, dst = (os.path.abspath(os.path.expanduser(p)) for p in (src, dst))
    r = subprocess.run([*mirror_cmd(src, dst), "-n"], capture_output=True, text=True)
    if r.returncode not in (0, 24):
        return {"error": (r.stderr.strip().splitlines() or [f"rsync exit {r.returncode}"])[-1]}
    changes = [(op, p) for op, p in parse_changes(r.stdout) if not p.endswith("/")]  # files, not folders
    return {"new": sum(op == "+" for op, _ in changes), "updated": sum(op == "~" for op, _ in changes),
            "removed": sum(op == "-" for op, _ in changes)}


def sync(reason="manual"):
    why = problem()
    if why:
        log(f"skipped ({reason}): {why}")
        save_state(last_error=why, last_error_at=time.time())
        report_problem(why)
        return False
    os.makedirs(STATE_DIR, exist_ok=True)
    lock = open(LOCK, "w")
    fcntl.flock(lock, fcntl.LOCK_EX)  # one rsync at a time (service and a manual `codesync now`)
    try:
        status("syncing", reason)
        os.makedirs(DST, exist_ok=True)
        start = time.time()
        r = subprocess.run(mirror_cmd(SRC, DST), capture_output=True, text=True)
        took = time.time() - start
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
    if r.returncode not in (0, 24):  # 24: a file vanished mid-sync — fine, the next sync catches up
        lines = r.stderr.strip().splitlines()
        # when the receiving side dies, the last line is only the sender's "Broken pipe" or
        # "rsync error: ..." trailer: show the first line that says what actually went wrong
        err = next((l for l in lines if not re.search(r"Broken pipe|^rsync error:|connection unexpectedly", l)),
                   lines[-1] if lines else f"rsync failed (exit {r.returncode})")
        log(f"FAILED ({reason}): {err}" + "".join(f"\n  {l}" for l in lines[-15:]))
        save_state(last_error=err, last_error_at=time.time())
        status("error", err)
        return False

    now = time.time()
    changes = parse_changes(r.stdout)
    out = r.stdout
    totals = {"files": num(r"reg: ([\d,]+)", out), "dirs": num(r"dir: ([\d,]+)", out),
              "size": num(r"Total file size: ([\d,]+)", out)}
    sent = num(r"Total transferred file size: ([\d,]+)", out)

    state = load_state()
    today = state.get("today", {})
    if today.get("date") != datetime.date.today().isoformat():
        today = {"date": datetime.date.today().isoformat(), "syncs": 0, "files": 0, "bytes": 0,
                 "added": 0, "updated": 0, "deleted": 0}
    counts = {op: sum(1 for o, _ in changes if o == op) for op in "+~-"}
    today.update(syncs=today["syncs"] + 1, files=today["files"] + len(changes), bytes=today["bytes"] + sent,
                 added=today["added"] + counts["+"], updated=today["updated"] + counts["~"],
                 deleted=today["deleted"] + counts["-"])
    recent = ([[now, op, p] for op, p in reversed(changes)] + state.get("recent", []))[:RECENT]
    last = {"at": now, "reason": reason, "took": round(took, 2), "changes": len(changes), "bytes": sent,
            "added": counts["+"], "updated": counts["~"], "deleted": counts["-"]}
    save_state(last_sync=now, last=last, today=today, totals=totals, recent=recent, last_error=None,
               last_full=now)
    status("ok")
    log(f"synced ({reason}): {len(changes)} change(s), {sent} bytes in {took:.1f}s"
        + "".join(f"\n  {op} {p}" for op, p in changes[:20]) + ("\n  …" if len(changes) > 20 else ""))
    return True


def clean_trash(days):
    cutoff = datetime.date.today() - datetime.timedelta(days=days)
    try:
        for name in os.listdir(TRASH):
            try:
                if datetime.date.fromisoformat(name) < cutoff:
                    shutil.rmtree(os.path.join(TRASH, name))
                    log(f"trash: removed {name}")
            except ValueError:
                pass
    except OSError:
        pass


# ---- inotify (via libc, no extra packages) -------------------------------------------------------
IN_ATTRIB, IN_CLOSE_WRITE, IN_MOVED_FROM, IN_MOVED_TO = 0x4, 0x8, 0x40, 0x80
IN_CREATE, IN_DELETE, IN_DELETE_SELF, IN_ISDIR, IN_Q_OVERFLOW = 0x100, 0x200, 0x400, 0x40000000, 0x4000
MASK = IN_ATTRIB | IN_CLOSE_WRITE | IN_MOVED_FROM | IN_MOVED_TO | IN_CREATE | IN_DELETE | IN_DELETE_SELF


class Watcher:
    def __init__(self, root):
        self.libc = ctypes.CDLL("libc.so.6", use_errno=True)
        self.fd = self.libc.inotify_init1(os.O_CLOEXEC)
        if self.fd < 0:
            raise OSError(ctypes.get_errno(), "inotify_init1 failed")
        self.paths = {}  # watch descriptor -> directory
        self.skip = ignore_patterns()[0]
        self.add_tree(root)
        self.ignore_seen = None   # the ignore list's mtime when its file patterns were read

    def ignored(self, d, name):
        """An event not worth a sync: a file the ignore list leaves out (*.pyc, .DS_Store…), or one of
        git's short-lived *.lock files (a status in an editor or a sidebar made them every few seconds)."""
        try:
            seen = os.stat(IGNORE).st_mtime
        except OSError:
            seen = 0
        if seen != self.ignore_seen:   # the list takes effect without a restart
            self.ignore_seen, self.files = seen, ignore_patterns()[1]
        if name.endswith(".lock") and "/.git/" in d + "/":
            return True
        return any(fnmatch(name, p) for p in self.files)

    def skipped(self, name):
        return any(fnmatch(name, p) for p in self.skip)

    def add_tree(self, top):
        for d, dirs, _ in os.walk(top):
            dirs[:] = [x for x in dirs if not self.skipped(x)]
            wd = self.libc.inotify_add_watch(self.fd, os.fsencode(d), MASK)
            if wd >= 0:
                self.paths[wd] = d
            elif ctypes.get_errno() == 28:  # ENOSPC: out of watches
                log("warning: inotify watch limit reached; relying on the periodic full sync")
                return

    def read(self):
        """Handle waiting events; True if anything relevant changed."""
        data, i, relevant = os.read(self.fd, 65536), 0, False
        while i < len(data):
            wd, mask, _, size = struct.unpack_from("iIII", data, i)
            name = data[i + 16:i + 16 + size].rstrip(b"\0").decode(errors="replace")
            i += 16 + size
            if mask & IN_ISDIR and mask & (IN_CREATE | IN_MOVED_TO) and wd in self.paths:
                if not self.skipped(name):
                    self.add_tree(os.path.join(self.paths[wd], name))  # watch new folders too
            if not name or not self.ignored(self.paths.get(wd, ""), name):
                relevant = True
            if mask & IN_DELETE_SELF:
                self.paths.pop(wd, None)
        return relevant


def watch():
    wake_r, wake_w = os.pipe()
    for fd in (wake_r, wake_w):
        os.set_blocking(fd, False)
    signal.set_wakeup_fd(wake_w)       # a signal wakes the select() below
    asked = set()
    signal.signal(signal.SIGUSR1, lambda *_: asked.add("now"))     # codesync now / the panel
    signal.signal(signal.SIGUSR2, lambda *_: asked.add("reload"))  # settings or pause changed
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))

    log(f"watching {SRC} -> {DST}")
    told = False
    while problem():  # wait for the HDD, or for the code folder to be restored, instead of failing
        why = problem()
        report_problem(why)
        if needs_restore() and not told:
            notify("Your code folder is empty but the backup isn't, so nothing is synced. "
                   "Open Code Sync and press r to restore it.")
            told = True
        if select.select([wake_r], [], [], 30)[0]:
            try:
                os.read(wake_r, 512)
            except BlockingIOError:
                pass
    w = Watcher(SRC)
    save_state(watched=len(w.paths), started=time.time())
    sync("start")
    last_full = last_clean = time.time()
    clean_trash(settings()["trash_days"])
    pending_since = last_event = None
    failures = 0

    while True:
        cfg, paused = settings(), os.path.exists(PAUSED)
        now = time.time()
        if pending_since and not paused:
            timeout = min(cfg["quiet"] - (now - last_event), cfg["max_wait"] - (now - pending_since))
        else:
            timeout = min(cfg["full_every"] - (now - last_full), 60)
        ready = select.select([w.fd, wake_r], [], [], max(timeout, 0))[0]
        if wake_r in ready:
            try:
                os.read(wake_r, 512)
            except BlockingIOError:
                pass
        now = time.time()
        if w.fd in ready and w.read():
            last_event = now
            if not pending_since:
                pending_since = now
                status("paused" if paused else "pending", "changes waiting")
        if "reload" in asked:
            asked.discard("reload")
            cur = load_state().get("status")
            if paused and cur != "paused":
                status("paused", "changes waiting" if pending_since else "")
            elif not paused and cur == "paused":
                status("pending" if pending_since else "ok")

        run = None
        if "now" in asked:
            asked.discard("now")
            run = "manual"
        elif pending_since and not paused and (now - last_event >= cfg["quiet"]
                                               or now - pending_since >= cfg["max_wait"]):
            run = "change"
        elif not paused and now - last_full >= cfg["full_every"]:
            run = "periodic"
        if run:
            if sync(run):
                pending_since = last_event = None
                last_full, failures = time.time(), 0
                if paused:
                    status("paused")
            else:
                failures += 1
                if failures == 3:
                    notify(f"Backup to the HDD is failing: {problem() or 'see codesync log'}", "critical")
                until = time.time() + min(10 * failures, 120)  # don't hammer a missing HDD...
                while "now" not in asked and time.time() < until:  # ...but "sync now" still works
                    if select.select([wake_r], [], [], max(until - time.time(), 0))[0]:
                        try:
                            os.read(wake_r, 512)
                        except BlockingIOError:
                            pass
        if time.time() - last_clean > 86400:
            clean_trash(cfg["trash_days"])
            last_clean = time.time()


# ---- commands ------------------------------------------------------------------------------------
def service_pid():
    out = subprocess.run(["systemctl", "--user", "show", "codesync", "-p", "MainPID", "--value"],
                         capture_output=True, text=True).stdout.strip()
    return int(out) if out.isdigit() and out != "0" else None


def now_cmd():
    pid = service_pid()
    if not pid:
        return sync("manual")
    before, asked_at = load_state().get("last_sync", 0), time.time()
    os.kill(pid, signal.SIGUSR1)  # let the service do it: it owns the watcher and the state
    for _ in range(600):
        time.sleep(0.2)
        s = load_state()
        if s.get("last_sync", 0) > before:
            last = s.get("last", {})
            log(f"synced: {last.get('changes', 0)} change(s) in {last.get('took', 0)}s")
            return True
        if s.get("status") == "error" and s.get("status_at", 0) > asked_at:  # not an older failure
            log(f"failed: {s.get('detail')}")
            return False
    log("still syncing — see `codesync log`")
    return True


def set_paused(on):
    os.makedirs(STATE_DIR, exist_ok=True)
    if on:
        open(PAUSED, "w").close()
    elif os.path.exists(PAUSED):
        os.remove(PAUSED)
    pid = service_pid()
    if pid:
        os.kill(pid, signal.SIGUSR2)
    if not on and pid:
        os.kill(pid, signal.SIGUSR1)  # resume: catch up right away
    log("paused" if on else "resumed")


def restore():
    """Copy the backup into the code folder. Never deletes. Holds LOCK throughout, so the service's
    first sync waits for a complete code folder (a half-restored one would mirror as deletions)."""
    if not os.path.exists(MACHINE):
        if not sys.stdin.isatty():
            sys.exit("not set up on this PC yet (run `codesync setup`)")
        setup()
        os.execv(sys.argv[0], [sys.argv[0], "restore"])
    if not os.path.ismount(MOUNT) or not has_entries(DST):
        sys.exit(f"nothing to restore: {DST} is empty or missing (is the backup drive mounted?)")
    if restoring():
        sys.exit("a restore is already running")
    os.makedirs(SRC, exist_ok=True)
    os.makedirs(STATE_DIR, exist_ok=True)
    lock = open(LOCK, "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    open(RESTORING, "w").write(str(os.getpid()))
    try:
        status("restoring", "starting…")
        log(f"copying {DST} -> {SRC} (skipping ignored folders; nothing is deleted)…")
        p = subprocess.Popen(["rsync", "-rlt", "--info=progress2", "--no-inc-recursive", *rsync_filters(),
                              f"{DST}/", f"{SRC}/"], stdout=subprocess.PIPE, text=True)
        shown = None
        for line in p.stdout:  # progress2 ends its updates with \r; text mode splits on those too
            m = re.search(r"(\d+)%", line)
            if m and m.group(1) != shown:
                shown = m.group(1)
                status("restoring", f"{shown}% copied")
                if sys.stdout.isatty():
                    print(f"\r  {line.strip()}", end="", flush=True)
        rc = p.wait()
    finally:
        try:
            os.remove(RESTORING)
        except OSError:
            pass
        fcntl.flock(lock, fcntl.LOCK_UN)
    if sys.stdout.isatty():
        print()
    if rc not in (0, 24):
        status("error", f"restore failed (rsync exit {rc}); see `codesync restore` in a terminal")
        sys.exit(rc)
    status("ok", "restored")
    log(f"restored {DST} -> {SRC}")
    pid = service_pid()
    if pid:
        os.kill(pid, signal.SIGUSR1)  # the service was holding: sync now


def ask(question, default):
    answer = input(f"{question}\n  [{default}] › ").strip()
    return os.path.expanduser(answer or default)


def setup():
    """Ask this PC's two folders and save them to machine.json (not in git)."""
    print("codesync setup — this PC's folders (other settings are shared through the dotfiles)\n")
    src = os.path.abspath(ask("Where is your code, on the fast drive?", _m.get("src", "~/code")))
    dst = os.path.abspath(ask("Where should the backup go, on the other drive?",
                              _m.get("dst", "/mnt/data/code")))
    error, warning = check_folders(src, dst)
    if error:
        sys.exit(error)
    if warning:
        print(f"\n! {warning}")
        if input("  Use it anyway? [y/N] › ").strip().lower() != "y":
            sys.exit("not saved")
    running = service_pid()
    save_machine(src, dst)
    print(f"\nsaved: {src} → {dst}  (drive: {mount_of(dst)})")
    if needs_restore(src, dst):
        print("next: `codesync restore` copies the backup's code to the fast drive, then `codesync enable`")
    if running:
        print("the running service now uses the new folders")


SERVICE = """[Unit]
Description=codesync: back up the code folder to the other drive (see codesync status)
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/codesync watch
Restart=on-failure
RestartSec=10
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
"""


def enable():
    if not os.path.exists(MACHINE):
        setup()
        os.execv(sys.argv[0], [sys.argv[0], "enable"])  # start over with the new folders
    if problem():
        sys.exit(f"not enabling: {problem()}")
    os.makedirs(os.path.dirname(UNIT), exist_ok=True)
    open(UNIT, "w").write(SERVICE)
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    subprocess.run(["systemctl", "--user", "enable", "--now", "codesync.service"], check=True)
    log("codesync is running in the background (and will start at every login)")


def disable():
    subprocess.run(["systemctl", "--user", "disable", "--now", "codesync.service"])
    status("off", "service stopped")
    log("codesync stopped")


def ago(t):
    d = time.time() - t
    if d < 60: return f"{int(d)}s ago"
    if d < 3600: return f"{int(d // 60)} min ago"
    if d < 86400: return time.strftime("%H:%M", time.localtime(t))
    return time.strftime("%d %b %H:%M", time.localtime(t))


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def status_cmd():
    active = subprocess.run(["systemctl", "--user", "is-active", "codesync.service"],
                            capture_output=True, text=True).stdout.strip()
    s = load_state()
    print(f"service      {active}{'  (paused)' if os.path.exists(PAUSED) else ''}")
    print(f"status       {s.get('status', '?')} {s.get('detail', '')}")
    print(f"code         {SRC}")
    print(f"backup       {DST}   (drive {MOUNT}: {'mounted' if os.path.ismount(MOUNT) else 'NOT MOUNTED'})")
    print(f"this PC      {MACHINE}{'' if os.path.exists(MACHINE) else '  (missing: run codesync setup)'}")
    print(f"old versions {TRASH}/<date>  (kept {settings()['trash_days']} days)")
    print(f"ignore list  {IGNORE}")
    if s.get("last_sync"):
        last = s.get("last", {})
        print(f"last sync    {ago(s['last_sync'])} ({last.get('changes', 0)} changes)")
    if s.get("last_error"):
        print(f"last error   {s['last_error']} ({ago(s['last_error_at'])})")
    if needs_restore() and os.path.ismount(MOUNT):
        print("next         the code folder is empty: `codesync restore` copies the backup back")


ICONS = {"ok": "\U000f04e6", "pending": "\U000f04e6", "syncing": "\U000f04e6", "restoring": "\U000f04e6",
         "paused": "\U000f04e8", "error": "\U000f04e7", "restore": "\U000f04e7",
         "off": "\U000f04e8"}  # nf-md-sync / -off / -alert


def bar():
    if not os.path.exists(UNIT) or not os.path.exists(MACHINE):
        print(json.dumps({"text": ""}))  # not used on this PC: waybar hides the icon
        return
    s = load_state()
    st = s.get("status", "off")
    if st != "off" and not service_pid():
        st = "off"
    words = {"ok": "up to date", "pending": "changes waiting", "syncing": "syncing…",
             "paused": "paused", "error": "problem", "off": "service not running",
             "restore": "restore needed", "restoring": "restoring…"}
    tip = [f"Code backup · {words.get(st, st)}"]
    if st in ("error", "restore", "restoring") and s.get("detail"):
        tip.append(s["detail"])
    if s.get("last_sync"):
        last = s.get("last", {})
        tip.append(f"Last sync {ago(s['last_sync'])} · {last.get('changes', 0)} changes")
    t = s.get("today", {})
    if t.get("date") == datetime.date.today().isoformat():
        tip.append(f"Today: {t.get('syncs', 0)} syncs · {t.get('files', 0)} files · {human(t.get('bytes', 0))}")
    tot = s.get("totals")
    if tot:
        tip.append(f"Backed up: {tot['files']:,} files · {human(tot['size'])}")
    tip += ["", f"{SRC.replace(os.path.expanduser('~'), '~')} → {DST}", "Click: details · Right-click: sync now · Middle: pause/resume"]
    print(json.dumps({"text": ICONS.get(st, ICONS["ok"]), "class": st, "tooltip": "\n".join(tip)},
                     ensure_ascii=False))


def move_cmd(a, b):
    """codesync move: the folder and its backup copy, both under LOCK (no sync in between, which would
    trash the old copy and copy the new one in full). Without a usable backup (not set up, drive not
    mounted, no copy yet) only the folder moves; the next sync copies it as usual. Exits 1 on an error."""
    rel = lambda p: os.path.relpath(os.path.abspath(os.path.join(SRC, os.path.expanduser(p))), SRC)
    a, b = rel(a), rel(b)
    if a.startswith("..") or b.startswith("..") or a == "." or b == ".":
        sys.exit(f"both must be inside {SRC}")
    if not os.path.isdir(os.path.join(SRC, a)):
        sys.exit(f"no folder {a} in {SRC}")
    if os.path.exists(os.path.join(SRC, b)) or (b + os.sep).startswith(a + os.sep):
        sys.exit(f"{b} already exists, or is inside {a}")
    os.makedirs(STATE_DIR, exist_ok=True)
    lock = open(LOCK, "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        old, new = os.path.join(DST, a), os.path.join(DST, b)
        backup = (os.path.exists(MACHINE) and os.path.ismount(MOUNT) and os.path.isdir(old)
                  and not os.path.exists(new))
        if backup:   # the same drive: a rename, instant
            os.makedirs(os.path.dirname(new), exist_ok=True)
            os.rename(old, new)
        os.makedirs(os.path.dirname(os.path.join(SRC, b)), exist_ok=True)
        shutil.move(os.path.join(SRC, a), os.path.join(SRC, b))
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
    log(f"moved {a} → {b}" + (" (and its backup copy)" if backup else ""))


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd == "watch":
        watch()
    elif cmd == "now":
        sys.exit(0 if now_cmd() else 1)
    elif cmd == "pause":
        set_paused(True)
    elif cmd == "resume":
        set_paused(False)
    elif cmd == "toggle":
        set_paused(not os.path.exists(PAUSED))
    elif cmd == "bar":
        bar()
    elif cmd == "setup":
        setup()
    elif cmd in ("restore", "pull"):
        restore()
    elif cmd == "move" and len(argv) == 4:
        move_cmd(argv[2], argv[3])
    elif cmd == "enable":
        enable()
    elif cmd == "disable":
        disable()
    elif cmd == "status":
        status_cmd()
    elif cmd == "log":
        os.execvp("journalctl", ["journalctl", "--user", "-u", "codesync", "-f", "-o", "cat"])
    elif cmd == "ignore":
        editor = os.environ.get("EDITOR", "nano").split()
        os.execvp(editor[0], [*editor, IGNORE])
    else:
        print(__doc__)
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv)
