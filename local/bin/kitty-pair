#!/usr/bin/env python3
"""kitty-pair — the kitty that sits beside a VS Code window on workspace 1 (modules/codepair.lua).

  kitty-pair <VS Code window address>            open it
  kitty-pair --follow <VS Code window address>   that window opened another project: follow it

Open: waits for the window's title to name its folder ("file - cloud_track - Visual Studio Code"),
finds that folder under ~/code, focuses the VS Code window (a new column opens beside the focused
one) and starts kitty there as its own app (uwsm), with the class code-term-<address>: that's how
codepair.lua knows which VS Code window the kitty belongs to. An empty window, or a folder it can't
find, gets ~/code itself. Does nothing if that window already has its kitty.

Follow: if the shell is idle at its prompt it cd's into the new project; if something is running
there (a dev server, tests) that's left alone and a new kitty tab opens in the new project instead.
Talks to the kitty through its remote-control socket ($XDG_RUNTIME_DIR/kitty-pair-<address>).
"""
import json, os, shlex, subprocess, sys, time

ROOT = os.path.expanduser("~/code")
APP = " - Visual Studio Code"
SKIP = {"node_modules", ".git", ".next", "dist", "build", "out", ".venv", "venv", "target", "vendor"}
SHELLS = {"fish", "zsh", "bash", "sh"}
WAIT = 3.0  # seconds for the title to name a folder (an empty window never does)
RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")


def clients():
    out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return []


def root_name(title):
    """The folder part of a VS Code title, or None while it's still just "Visual Studio Code"."""
    if not title.endswith(APP):
        return None
    return title[:-len(APP)].split(" - ")[-1].lstrip("●").strip() or None


def find_folder(name, depth=5):
    """The folder called name under ROOT (the most recently changed one if there are several)."""
    if os.path.basename(ROOT) == name:
        return ROOT
    best = None
    for top, dirs, _ in os.walk(ROOT):
        if top[len(ROOT):].count(os.sep) >= depth:
            dirs[:] = []
            continue
        dirs[:] = [d for d in dirs if d not in SKIP and not d.startswith(".")]
        if name in dirs:
            p = os.path.join(top, name)
            if best is None or os.path.getmtime(p) > os.path.getmtime(best):
                best = p
    return best


def socket_of(addr):
    return f"{RUN}/kitty-pair-{addr}"


def remember(addr, folder):
    with open(socket_of(addr) + ".folder", "w") as f:
        f.write(folder)


def remembered(addr):
    try:
        return open(socket_of(addr) + ".folder").read()
    except OSError:
        return None


def kitty(addr, *args):
    return subprocess.run(["kitty", "@", "--to", f"unix:{socket_of(addr)}", *args], capture_output=True, text=True)


def open_pair(addr):
    term_class = f"code-term-{addr}"
    folder, end = None, time.time() + WAIT
    while time.time() < end:
        wins = clients()
        if any(c["class"] == term_class for c in wins):
            return  # already paired
        win = next((c for c in wins if c["address"] == addr), None)
        if win is None:
            return  # the VS Code window closed meanwhile
        name = root_name(win["title"])
        folder = find_folder(name) if name else None
        if folder:
            break
        time.sleep(0.2)
    folder = folder or ROOT
    remember(addr, folder)
    subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{addr}" }})'],
                   capture_output=True)
    os.execvp("uwsm", ["uwsm", "app", "--", "kitty", "--class", term_class, "--directory", folder,
                       "--listen-on", f"unix:{socket_of(addr)}", "-o", "allow_remote_control=socket-only"])


def follow(addr):
    win = next((c for c in clients() if c["address"] == addr), None)
    name = root_name(win["title"]) if win else None
    folder = find_folder(name) if name else None
    if not folder or folder == remembered(addr):
        return  # not a project we know, or the same one
    r = kitty(addr, "ls")
    if r.returncode != 0:
        return  # no kitty with a socket for this window (opened before this existed, or closed)
    # the tab and window shown in the kitty: "active" (not "focused" — the focus is in VS Code)
    tabs = json.loads(r.stdout)[0]["tabs"]
    tab = next((t for t in tabs if t["is_active"]), tabs[0])
    active = next((w for w in tab["windows"] if w["is_active"]), tab["windows"][0])
    fg = {os.path.basename(p["cmdline"][0]) for p in active["foreground_processes"] if p["cmdline"]}
    if fg and fg <= SHELLS:
        # idle at its prompt: clear whatever is half-typed (Ctrl+U), then cd there
        kitty(addr, "send-text", "--match", f"id:{active['id']}", f"\x15cd -- {shlex.quote(folder)}\r")
    else:
        kitty(addr, "launch", "--type=tab", "--cwd", folder)  # busy: keep it running, new tab
    remember(addr, folder)


def main():
    args = sys.argv[1:]
    if len(args) == 2 and args[0] == "--follow":
        follow(args[1])
    elif len(args) == 1:
        open_pair(args[0])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
