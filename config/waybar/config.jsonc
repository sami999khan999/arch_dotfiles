// Omarchy classic waybar (v3.8), omarchy-* actions swapped for plain tools
{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 27,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": [
    "custom/logo",
    "custom/wsbar",
    "group/wsbuttons",
    "custom/visualizer"
  ],
  // no centre section at all: an (even empty) centre stops a shrinkable left module at the middle
  // of the bar, and a module in the centre gets placed overlapping an off-centre right side
  "no-center": true,
  "modules-right": [
    "mpris",
    "custom/wsgroups",
    "custom/window",
    "custom/divider",
    "custom/codesync",
    "custom/sysagent",
    "custom/keys",
    "custom/settings",
    "bluetooth",
    "network",
    "pulseaudio",
    "group/stats",
    "custom/clock",
    "custom/notifications",
    "custom/load",
    "custom/idle-indicator",
    "custom/power"
  ],
  "group/stats": {
    "orientation": "inherit",
    "modules": [
      "cpu",
      "memory",
      "temperature",
      "battery"
    ]
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "System menu (Super + Escape)",
    "on-click": "~/.config/hypr/scripts/power-menu.sh"
  },
  // workspace buttons: hyprland/workspaces' click sends a legacy dispatch the Lua config rejects,
  // so each button is a custom module that reads its state from wsbar.py and dispatches in Lua
  // (click: goOrCycle in binds.lua). No tooltip: GTK hides it on every click, so it blinked while
  // clicking to cycle windows. exec-on-event off: wsbar.py's signal updates them on real changes
  // code backup (~/code -> HDD): status icon, details on hover, panel on click
  // the divider after the group count + title block: a module of its own, so it stays when the
  // codesync icon after it is hidden (codesync off, or not set up on this PC)
  "custom/divider": {
    "format": "\u200b",
    "tooltip": false
  },
  "custom/codesync": {
    "exec": "~/.local/bin/codesync bar",
    "return-type": "json",
    "interval": 20,
    "signal": 11,
    "on-click": "~/.local/lib/panels/syncgui.py",
    "on-click-right": "~/.local/bin/codesync now",
    "on-click-middle": "~/.local/bin/codesync toggle"
  },
  "custom/wsbar": {
    "exec": "~/.config/hypr/scripts/wsbar.py",
    "tooltip": false
  },
  "group/wsbuttons": {
    "orientation": "inherit",
    "modules": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10"]
  },
  "custom/ws1": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/1.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "exec-on-event": false,
    "tooltip": false,
    "on-click": "hyprctl eval 'goOrCycle(\"1\")'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws2": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/2.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "exec-on-event": false,
    "tooltip": false,
    "on-click": "hyprctl eval 'goOrCycle(\"2\")'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws3": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/3.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "exec-on-event": false,
    "tooltip": false,
    "on-click": "hyprctl eval 'goOrCycle(\"3\")'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws4": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/4.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "exec-on-event": false,
    "tooltip": false,
    "on-click": "hyprctl eval 'goOrCycle(\"4\")'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws5": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/5.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "exec-on-event": false,
    "tooltip": false,
    "on-click": "hyprctl eval 'goOrCycle(\"5\")'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws6": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/6.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "exec-on-event": false,
    "tooltip": false,
    "on-click": "hyprctl eval 'goOrCycle(\"6\")'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws7": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/7.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "exec-on-event": false,
    "tooltip": false,
    "on-click": "hyprctl eval 'goOrCycle(\"7\")'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws8": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/8.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "exec-on-event": false,
    "tooltip": false,
    "on-click": "hyprctl eval 'goOrCycle(\"8\")'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws9": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/9.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "exec-on-event": false,
    "tooltip": false,
    "on-click": "hyprctl eval 'goOrCycle(\"9\")'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/ws10": {
    "exec": "cat \"$XDG_RUNTIME_DIR/wsbar/10.json\" 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "exec-on-event": false,
    "tooltip": false,
    "on-click": "hyprctl eval 'goOrCycle(\"10\")'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/window": {
    "exec": "~/.config/hypr/scripts/wintitle.py",
    "return-type": "json",
    "escape": true
  },
  // bars that move with whatever is playing (cava), filling the gap between the workspace buttons
  // and the right section; hidden while it's silent. Styles: bars, solid, mirror, dots, wave, off
  // (Super + Alt + B or a right click: the next). Click: play/pause.
  // max-length lets it shrink: when the bar runs out of room GTK shrinks it rather than push the
  // right section, so the clock and power button stay put whatever happens (needs "no-center")
  "custom/visualizer": {
    "exec": "~/.config/hypr/scripts/visualizer.py",
    "return-type": "json",
    "restart-interval": 5,
    "tooltip": false,
    "max-length": 400,
    "on-click": "playerctl play-pause",
    "on-click-right": "~/.config/hypr/scripts/visualizer.py cycle"
  },
  "mpris": {
    "format": "{status_icon}",
    "tooltip-format": "{title}\n{artist}\n\n{player} · {status}\nclick: play/pause · scroll: next/prev",
    "format-stopped": "",
    "status-icons": {
      "playing": "󰏤",
      "paused": "󰐊"
    },
    "max-length": 40,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  // the stats keep one width (the number takes 3 places, the space after the icon included): at
  // 100 % a "{usage:>2}" grew the right side by a character, and the gap's contents, sized to the
  // pixel, got cut off ("…")
  "memory": {
    "interval": 5,
    "format": "󰘚{percentage:>3}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
    "on-click": "~/.local/lib/panels/sysgui.py"
  },
  "temperature": {
    "interval": 5,
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "󰔏{temperatureC:>3}°",
    "tooltip-format": "CPU package {temperatureC}°C"
  },
  "cpu": {
    "interval": 5,
    "format": "󰍛{usage:>3}%",
    "states": {
      "critical": 90
    },
    "on-click": "~/.local/lib/panels/sysgui.py"
  },
  // the clock is a script (scripts/clock.py) so the visualizer can know which view is on: the long
  // one (click) is wider. Scroll: the tooltip calendar's month
  "custom/clock": {
    "exec": "~/.config/hypr/scripts/clock.py",
    "return-type": "json",
    "on-click": "~/.config/hypr/scripts/clock.py toggle",
    "on-scroll-up": "~/.config/hypr/scripts/clock.py scroll up",
    "on-scroll-down": "~/.config/hypr/scripts/clock.py scroll down"
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)",
    "tooltip-format-ethernet": "Connected",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "~/.local/lib/panels/netgui.py"
  },
  "battery": {
    "format": "{icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "{icon}",
    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "~/.config/hypr/scripts/power-menu.sh",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "~/.local/lib/panels/btgui.py"
  },
  // as wide as its number (the visualizer recounts its gap when the volume gains or loses a digit).
  // Each icon carries its own spacing: the speakers draw past their 7 px cell (8 px with no waves,
  // 14 with three), so plain spaces left a wide gap at a low volume; spaces + 1 px hair spaces
  // start the number 7 px after each one as drawn
  "pulseaudio": {
    "format": "{icon}{volume}%",
    "on-click": "~/.local/lib/panels/audiogui.py",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "\ueee8 \u200a\u200a\u200a\u200a\u200a\u200a{volume}%",
    "format-icons": {
      "headphone": "\uf025 \u200a\u200a\u200a\u200a\u200a",
      "headset": "\uf025 \u200a\u200a\u200a\u200a\u200a",
      "default": [
        "\uf026 \u200a",
        "\uf027 \u200a\u200a\u200a",
        "\uf028  "
      ]
    }
  },
  "custom/wsgroups": {
    "exec": "~/.local/bin/wsgroups bar",
    "return-type": "json",
    "escape": true,
    "on-click": "~/.local/bin/wsgroups"
  },
  "custom/sysagent": {
    "format": "󰙴",
    "tooltip-format": "System agent: ask about this PC, read-only (Super + Ctrl + S)",
    "on-click": "~/.local/lib/panels/sysagentgui.py"
  },
  "custom/keys": {
    "format": "",
    "tooltip-format": "Shortcuts (Super + K)",
    "on-click": "~/.local/lib/panels/keysgui.py"
  },
  "custom/settings": {
    "format": "\uf013",
    "tooltip-format": "Settings (Super + I)",
    "on-click": "~/.local/lib/panels/settingsgui.py"
  },
  // shows only while the CPU stays busy, with what's causing it (scripts/loadwatch.py: /proc and the
  // cgroups, no process). Click: the System panel on its Apps tab
  "custom/load": {
    "exec": "~/.config/hypr/scripts/loadwatch.py",
    "return-type": "json",
    "on-click": "~/.local/lib/panels/sysgui.py --tab Apps"
  },
  "custom/idle-indicator": {
    "on-click": "~/.config/hypr/scripts/toggle.sh idle",
    "exec": "~/.config/hypr/scripts/indicator.sh idle",
    "signal": 9,
    "interval": 10,
    "return-type": "json"
  },
  // the bell beside the clock: new notifications (a dot), do not disturb (crossed out). Click: the
  // notification panel; right-click: do not disturb. Refreshed by mako's on-notify (signal 10)
  "custom/notifications": {
    "exec": "~/.config/hypr/scripts/notifications.py bar",
    "on-click": "~/.local/lib/panels/notifgui.py",
    "on-click-right": "~/.config/hypr/scripts/toggle.sh notifications",
    "signal": 10,
    "interval": "once",
    "return-type": "json"
  },
  "custom/logo": {
    "format": "",
    "on-click": "walker",
    "on-click-right": "~/.config/hypr/scripts/power-menu.sh",
    "tooltip-format": "Apps: Super + Space\nSystem: Super + Escape"
  }
}
