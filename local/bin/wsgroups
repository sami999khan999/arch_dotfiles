#!/usr/bin/env python3
# wsgroups — the command; what it does is in local/lib/hypr/wsgroups.py (`wsgroups help`). Only a
# launcher: Python caches a module's compiled code but compiles a script on every run, and this one runs
# on every workspace key.
import os, sys

sys.path.insert(0, os.path.expanduser("~/.local/lib/hypr"))
import wsgroups

wsgroups.main(sys.argv[1:])
