#!/usr/bin/env python3
"""kitty-pair — the kitty that sits beside a VS Code window on workspace 1 (modules/codepair.lua).

  kitty-pair <VS Code window address>            open it
  kitty-pair --follow <VS Code window address>   that window opened another project: follow it

Open: starts kitty right away (a new VS Code window shows alone until its kitty is there), as its
own app (uwsm), with the class code-term-<address>: that's how codepair.lua knows which VS Code
window the kitty belongs to. It starts in the folder the window's title names
("file - cloud_track - Visual Studio Code") if it already does, else in ~/code; once VS Code shows
its project, codepair.lua runs --follow and the kitty cd's there. Does nothing if that window
already has its kitty. The VS Code window is focused first: a new column opens beside the focused one.

Follow: if the shell is idle at its prompt it cd's into the new project; if something is running
there (a dev server, tests) that's left alone and a new kitty tab opens in the new project instead.
Talks to the kitty through its remote-control socket ($XDG_RUNTIME_DIR/kitty-pair-<address>).
"""
import json, os, shlex, shutil, subprocess, sys, time

ROOT = os.path.expanduser("~/code")
APP = " - Visual Studio Code"
SKIP = {"node_modules", ".git", ".next", "dist", "build", "out", ".venv", "venv", "target", "vendor"}
SHELLS = {"fish", "zsh", "bash", "sh"}
STARTUP = 5.0  # seconds --follow waits for a kitty that's still starting
RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")


def clients():
    out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return []


def root_name(title):
    """The folder part of a VS Code title, or None while it's still just "Visual Studio Code"."""
    if not title.endswith(APP):
        return None
    return title[:-len(APP)].split(" - ")[-1].lstrip("●").strip() or None


def find_folder(name, depth=5):
    """The folder called name under ROOT (the most recently changed one if there are several)."""
    if os.path.basename(ROOT) == name:
        return ROOT
    best = None
    for top, dirs, _ in os.walk(ROOT):
        if top[len(ROOT):].count(os.sep) >= depth:
            dirs[:] = []
            continue
        dirs[:] = [d for d in dirs if d not in SKIP and not d.startswith(".")]
        if name in dirs:
            p = os.path.join(top, name)
            if best is None or os.path.getmtime(p) > os.path.getmtime(best):
                best = p
    return best


def socket_of(addr):
    return f"{RUN}/kitty-pair-{addr}"


def remember(addr, folder):
    with open(socket_of(addr) + ".folder", "w") as f:
        f.write(folder)


def remembered(addr):
    try:
        return open(socket_of(addr) + ".folder").read()
    except OSError:
        return None


def kitty(addr, *args):
    return subprocess.run(["kitty", "@", "--to", f"unix:{socket_of(addr)}", *args], capture_output=True, text=True)


def open_pair(addr):
    term_class = f"code-term-{addr}"
    wins = clients()
    if any(c["class"] == term_class for c in wins):
        return  # already paired
    win = next((c for c in wins if c["address"] == addr), None)
    if win is None:
        return  # the VS Code window closed meanwhile
    name = root_name(win["title"])
    folder = (find_folder(name) if name else None) or ROOT
    remember(addr, folder)
    subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{addr}" }})'],
                   capture_output=True)
    cmd = ["uwsm", "app", "--", "kitty", "--class", term_class, "--directory", folder,
           "--listen-on", f"unix:{socket_of(addr)}", "-o", "allow_remote_control=socket-only"]
    thread = agentmux_thread(folder)
    os.execvp("uwsm", cmd + (["--", *thread] if thread else []))


def agentmux():
    """agentmux's lib (local/lib/agentmux), or None without tmux: then the kitty runs a plain shell."""
    if not shutil.which("tmux"):
        return None
    sys.path.insert(0, os.path.expanduser("~/.local/lib/agentmux"))
    try:
        import lib
        return lib
    except ImportError:
        return None


def agentmux_thread(folder):
    """With tmux: a new agentmux thread in folder, and the command that attaches the kitty to it, so
    an agent started there also shows (live) in agentmux (Super + A)."""
    lib = agentmux()
    if lib is None:
        return None
    name = lib.next_name(folder)
    lib.new_session(name, folder, "agent")
    return lib.AGENTS + ["attach", "-t", f"={name}"]


def tmux_thread(lib, window):
    """The agentmux thread a kitty window is attached to: the agents server's client whose pid is the
    window's process (kitty's foreground_processes can come back empty for a tmux client, which once
    left a thread behind in the old project), else the attach command line."""
    _, out = lib.agents("list-clients", "-F", "#{client_pid}\t#{client_session}")
    for line in out.splitlines():
        pid, _, session = line.partition("\t")
        if pid.isdigit() and int(pid) == window.get("pid"):
            return session
    for p in [{"cmdline": window.get("cmdline")}] + window.get("foreground_processes", []):
        cmd = p.get("cmdline") or []
        if cmd and os.path.basename(cmd[0]) == "tmux" and "-t" in cmd:
            return cmd[cmd.index("-t") + 1].lstrip("=")
    return None


def follow(addr):
    win = next((c for c in clients() if c["address"] == addr), None)
    name = root_name(win["title"]) if win else None
    folder = find_folder(name) if name else None
    if not folder or folder == remembered(addr):
        return  # not a project we know, or the same one
    end = time.time() + STARTUP
    while True:   # a new window's title can name its project before its kitty is up
        r = kitty(addr, "ls")
        if r.returncode == 0 or time.time() > end:
            break
        time.sleep(0.25)
    if r.returncode != 0:
        return  # no kitty with a socket for this window (opened before this existed, or closed)
    # the tab and window shown in the kitty: "active" (not "focused" — the focus is in VS Code)
    tabs = json.loads(r.stdout)[0]["tabs"]
    tab = next((t for t in tabs if t["is_active"]), tabs[0])
    active = next((w for w in tab["windows"] if w["is_active"]), tab["windows"][0])
    fg = {os.path.basename(p["cmdline"][0]) for p in active["foreground_processes"] if p["cmdline"]}
    lib = agentmux()
    thread = tmux_thread(lib, active) if lib else None
    if lib and thread:
        # an agentmux thread: its own shell decides; the thread moves to the new project with it
        _, cmd = lib.agents("display-message", "-p", "-t", f"={thread}:", "#{pane_current_command}")
        if cmd in lib.SHELLS:   # not "sh": an agent runs under that wrapper
            lib.agents("send-keys", "-t", f"={thread}:", "C-u", f"cd -- {shlex.quote(folder)}", "Enter")
            lib.agents("set-option", "-t", f"={thread}:", "@project", folder)
            lib.agents("rename-session", "-t", f"={thread}", lib.next_name(folder))
        else:   # busy: keep it running, a new thread in a new tab
            new = lib.next_name(folder)
            lib.new_session(new, folder, "agent")
            kitty(addr, "launch", "--type=tab", "--cwd", folder, *lib.AGENTS, "attach", "-t", f"={new}")
        remember(addr, folder)
        return
    if fg and fg <= SHELLS:
        # idle at its prompt: clear whatever is half-typed (Ctrl+U), then cd there
        kitty(addr, "send-text", "--match", f"id:{active['id']}", f"\x15cd -- {shlex.quote(folder)}\r")
    else:
        kitty(addr, "launch", "--type=tab", "--cwd", folder)  # busy: keep it running, new tab
    remember(addr, folder)


def main():
    args = sys.argv[1:]
    if len(args) == 2 and args[0] == "--follow":
        follow(args[1])
    elif len(args) == 1:
        open_pair(args[0])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
