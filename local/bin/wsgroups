#!/usr/bin/env python3
"""wsgroups — one workspace per kind of app, every window maximized, Alt + N to switch.

  wsgroups                    open the manager UI (also Super + Ctrl + G, or click it in waybar)
  wsgroups focus N            focus window N (1-10) of the current workspace, in the order opened
  wsgroups go N               go to workspace N; launch its apps if none are open there yet
  wsgroups launch N|all [-f]  launch a group's programs (-f: even if some are already open;
                              --background: return to the current workspace afterwards)
  wsgroups tidy               move already-open windows to their group's workspace
  wsgroups list               show the groups and the numbered windows in each
  wsgroups bar                waybar module: follows Hyprland events, prints JSON lines

Groups are stored in ~/.config/hypr/workspaces.conf.
"""
import json, os, re, select, shlex, shutil, socket, subprocess, sys, termios, time, tty

CONF = os.path.expanduser("~/.config/hypr/workspaces.conf")
ICON = "\U000f0570"  # nf-md-view_carousel


# ---- hyprland ----------------------------------------------------------------------------------
def hypr(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def query(what):
    try:
        return json.loads(hypr(what, "-j") or "null")
    except json.JSONDecodeError:
        return None


def dispatch(lua):
    hypr("dispatch", lua)


def notify(msg):
    subprocess.run(["notify-send", "-t", "1500", "Workspaces", msg], capture_output=True)


def windows(ws, clients=None):
    """Windows on workspace ws, oldest first — that order is what Alt + N counts."""
    clients = query("clients") if clients is None else clients
    wins = [c for c in clients or [] if c["workspace"]["id"] == ws and c["mapped"]
            and c["class"] != "TUI.float"]  # popups (this UI, sysmon, shortcut list) don't count
    return sorted(wins, key=lambda c: c.get("stableId", 0))


def matches(win, cls):
    try:
        return re.fullmatch(cls, win["class"]) is not None
    except re.error:
        return False


# ---- workspaces.conf ---------------------------------------------------------------------------
def read_conf():
    """(header lines, {ws: {"name", "cls", "launch": [cmd]}})"""
    header, groups = [], {}
    try:
        lines = open(CONF).read().splitlines()
    except OSError:
        return header, groups
    body = False
    for line in lines:
        s = line.strip()
        parts = [p.strip() for p in s.split("|", 3)]
        if s and not s.startswith("#") and len(parts) >= 3 and parts[0].isdigit():
            body = True
            launch = [c.strip() for c in parts[3].split(";")] if len(parts) > 3 else []
            groups[int(parts[0])] = {"name": parts[1], "cls": parts[2], "launch": [c for c in launch if c]}
        elif not body:
            header.append(line)
    return header, groups


def groups():
    return read_conf()[1]


def write_conf(groups_):
    header, _ = read_conf()
    while header and not header[-1].strip():
        header.pop()
    rows = []
    for ws in sorted(groups_):
        g = groups_[ws]
        rows.append(f"{ws} | {g['name']:<8} | {g['cls']:<13} | {' ; '.join(g['launch'])}".rstrip())
    with open(CONF, "w") as f:           # write in place: the file is a symlink into ~/dotfiles
        f.write("\n".join(header) + "\n\n" + "\n".join(rows) + "\n")
    hypr("reload")


# ---- actions -----------------------------------------------------------------------------------
def focus(n):
    ws = query("activeworkspace")["id"]
    wins = windows(ws)
    if n > len(wins):
        notify(f"No window {n} here ({len(wins)} open)")
        return
    target = wins[n - 1]
    dispatch(f'hl.dsp.focus({{ window = "address:{target["address"]}" }})')
    if ws in groups():
        active = query("activewindow") or {}
        if active.get("address") == target["address"] and active.get("fullscreen", 0) == 0:
            dispatch('hl.dsp.window.fullscreen({ mode = "maximized" })')


def launch(ws, force=False):
    g = groups().get(ws)
    if not g or not g["launch"]:
        return False
    if not force and any(matches(w, g["cls"]) for w in windows(ws)):
        return False
    for i, cmd in enumerate(g["launch"]):
        if i:
            time.sleep(0.8)  # keep the opening order = the Alt + N order
        argv = [os.path.expanduser(a) for a in shlex.split(cmd)]
        subprocess.Popen(["uwsm", "app", "--", *argv], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True


def wait_for(ws, timeout=10):
    """Wait until one of the group's windows has opened on ws."""
    g = groups().get(ws)
    end = time.time() + timeout
    while g and time.time() < end:
        if any(matches(w, g["cls"]) for w in windows(ws)):
            return True
        time.sleep(0.25)
    return False


def go(ws):
    dispatch(f'hl.dsp.focus({{ workspace = "{ws}" }})')
    launch(ws)


def tidy():
    moved = 0
    gs = groups()
    for win in query("clients") or []:
        for ws, g in gs.items():
            if matches(win, g["cls"]) and win["workspace"]["id"] != ws and win["workspace"]["id"] > 0:
                dispatch(f'hl.dsp.window.move({{ workspace = "{ws}", follow = false, '
                         f'window = "address:{win["address"]}" }})')
                moved += 1
                break
    return moved


def show():
    gs = groups()
    clients = query("clients")
    active = query("activeworkspace")["id"]
    for ws in sorted(set(gs) | {active}):
        g = gs.get(ws, {"name": "(no group)", "cls": "-", "launch": []})
        mark = "*" if ws == active else " "
        print(f"{mark}{ws:>2}  {g['name']:<10} class: {g['cls']}")
        for i, w in enumerate(windows(ws, clients), 1):
            state = " [max]" if w.get("fullscreen") else ""
            print(f"      Alt+{i % 10}  {w['class']}: {w['title'][:50]}{state}")


# ---- waybar module -----------------------------------------------------------------------------
def bar_status():
    ws = (query("activeworkspace") or {}).get("id", 0)
    g = groups().get(ws)
    wins = windows(ws)
    active = (query("activewindow") or {}).get("address")
    pos = next((i for i, w in enumerate(wins, 1) if w["address"] == active), 0)
    lines = [f"Alt+{i % 10}  {w['class']}: {w['title'][:40]}" for i, w in enumerate(wins, 1)]
    tip = (f"{g['name']} · workspace {ws}" if g else f"Workspace {ws} (no group)")
    tip += "\n" + ("\n".join(lines) if lines else "no windows") + "\n\nClick: manage groups"
    text = f"{ICON} {g['name']} {pos}/{len(wins)}" if g and wins else (f"{ICON} {g['name']}" if g else ICON)
    return {"text": text, "tooltip": tip, "class": "group" if g else "none"}


def bar():
    sock = os.path.join(os.environ.get("XDG_RUNTIME_DIR", ""), "hypr",
                        os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""), ".socket2.sock")
    wanted = ("workspace>>", "activewindow>>", "openwindow>>", "closewindow>>",
              "movewindow>>", "focusedmon>>", "configreloaded>>")
    last = None
    def emit():
        nonlocal last
        out = json.dumps(bar_status(), ensure_ascii=False)
        if out != last:
            print(out, flush=True)
            last = out
    while True:
        emit()
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(sock)
            buf = b""
            while True:
                data = s.recv(4096)
                if not data:
                    break
                buf += data
                *events, buf = buf.split(b"\n")
                if any(e.decode(errors="ignore").startswith(wanted) for e in events):
                    time.sleep(0.05)  # let hyprland settle (e.g. maximize after focus)
                    emit()
        except OSError:
            time.sleep(2)


# ---- manager UI --------------------------------------------------------------------------------
def rgb(h): return f"\033[38;2;{int(h[1:3],16)};{int(h[3:5],16)};{int(h[5:7],16)}m"
FG, DIM, ACCENT, KEY, TRACK, GOOD, BAD = (rgb("#c0caf5"), rgb("#565f89"), rgb("#7aa2f7"), rgb("#e0af68"),
                                          rgb("#292e42"), rgb("#9ece6a"), rgb("#f7768e"))
SELBG, BOLD, RESET = "\033[48;2;41;46;66m", "\033[1m", "\033[0m"


def read_key(fd):
    ch = os.read(fd, 1)
    if ch != b"\x1b":
        return ch.decode(errors="ignore")
    if not select.select([fd], [], [], 0.03)[0]:
        return "ESC"
    seq = os.read(fd, 16).decode(errors="ignore")
    return {"[A": "UP", "[B": "DOWN", "[C": "RIGHT", "[D": "LEFT"}.get(seq, "")


class UI:
    def __init__(self, fd):
        self.fd, self.sel, self.msg = fd, 1, ""
        self.mode = "main"            # main | pick
        self.pick_sel = 0
        self.sel = (query("activeworkspace") or {}).get("id", 1)
        if not 1 <= self.sel <= 10:
            self.sel = 1

    # -- data --
    def load(self):
        self.groups = groups()
        self.clients = query("clients") or []
        self.active_ws = (query("activeworkspace") or {}).get("id", 1)

    def apps(self):
        """Open apps, one row per class, with the workspace they're on."""
        seen = {}
        for c in sorted(self.clients, key=lambda c: c["class"].lower()):
            if c["class"] and c["workspace"]["id"] > 0 and c["class"] not in seen:
                seen[c["class"]] = c
        return list(seen.values())

    # -- drawing --
    @staticmethod
    def highlight(row):
        return SELBG + row.replace(RESET, RESET + SELBG) + " " * 4 + RESET

    def frame(self, lines, footer):
        cols, rows = shutil.get_terminal_size()
        w = min(cols - 4, 92)
        pad = " " * max((cols - w) // 2, 0)
        out = [pad + f"{FG}{BOLD}Workspace groups{RESET}   {DIM}Alt + 1…0 switches windows inside a workspace{RESET}", ""]
        out += [pad + l for l in lines]
        out += [""] * max(rows - len(out) - 3, 0)
        out.append(pad + (f"{GOOD}{self.msg}{RESET}" if self.msg else ""))
        out.append(pad + f"{DIM}{footer}{RESET}")
        sys.stdout.write("\033[H\033[2J" + "\n".join(out[:rows]))
        sys.stdout.flush()
        return w

    def draw_main(self):
        lines = []
        for ws in range(1, 11):
            g = self.groups.get(ws)
            n = len(windows(ws, self.clients))
            here = f"{ACCENT}●{RESET}" if ws == self.active_ws else " "
            name = f"{FG}{BOLD}{g['name']:<10}{RESET}" if g else f"{DIM}{'—':<10}{RESET}"
            cls = f"{KEY}{g['cls'][:22]:<22}{RESET}" if g else f"{DIM}{'no group':<22}{RESET}"
            count = f"{DIM}{n} window{'s' if n != 1 else ''}{RESET}" if n else f"{DIM}empty{RESET}"
            row = f" {here} {ACCENT}{ws % 10}{RESET}  {name}  {cls}  {count}"
            lines.append(self.highlight(row) if ws == self.sel else row)
        lines += ["", f"{TRACK}{'─' * 60}{RESET}"]
        g = self.groups.get(self.sel)
        if g:
            lines.append(f"{DIM}launch   {RESET}{FG}{' ; '.join(g['launch']) or '(nothing)'}{RESET}")
        wins = windows(self.sel, self.clients)
        for i, win in enumerate(wins[:6], 1):
            lines.append(f"{KEY}Alt+{i % 10}{RESET}    {FG}{win['class']}{RESET} {DIM}{win['title'][:52]}{RESET}")
        if len(wins) > 6:
            lines.append(f"{DIM}         … {len(wins) - 6} more{RESET}")
        self.frame(lines, "↑↓ select   a add app   e edit   d delete   l launch   g go   t tidy   esc close")

    def draw_pick(self):
        apps = self.apps()
        lines = [f"{FG}Pick an open app to put on workspace {ACCENT}{self.sel % 10}{RESET}{FG}:{RESET}", ""]
        for i, c in enumerate(apps):
            owner = next((ws for ws, g in self.groups.items() if matches(c, g["cls"])), None)
            where = f"{DIM}group {owner}{RESET}" if owner else f"{DIM}on {c['workspace']['id']}{RESET}"
            row = f"  {KEY}{c['class'][:26]:<26}{RESET}  {DIM}{c['title'][:36]:<36}{RESET}  {where}"
            lines.append(self.highlight(row) if i == self.pick_sel else row)
        lines += ["", f"{DIM}  or press {RESET}{KEY}c{RESET}{DIM} to type a class yourself{RESET}"]
        self.frame(lines, "↑↓ select   enter add   c type class   esc back")

    # -- input --
    def prompt(self, label, value=""):
        """One-line editor on the bottom row. Returns None on Esc."""
        cols, rows = shutil.get_terminal_size()
        while True:
            sys.stdout.write(f"\033[{rows};1H\033[2K  {ACCENT}{label}{RESET} {FG}{value}▏{RESET}"
                             f"   {DIM}enter ok · esc cancel{RESET}")
            sys.stdout.flush()
            k = read_key(self.fd)
            if k == "ESC":
                return None
            if k in ("\r", "\n"):
                return value.strip()
            if k in ("\x7f", "\b"):
                value = value[:-1]
            elif k == "\x15":
                value = ""
            elif len(k) == 1 and k.isprintable():
                value += k

    def confirm(self, question):
        cols, rows = shutil.get_terminal_size()
        sys.stdout.write(f"\033[{rows};1H\033[2K  {BAD}{question}{RESET} {DIM}y / n{RESET}")
        sys.stdout.flush()
        return read_key(self.fd) in ("y", "Y")

    def save(self, msg):
        write_conf(self.groups)
        self.msg = msg

    @staticmethod
    def guess_launch(cls, pid=None):
        """The app's command from its .desktop entry (matched by StartupWMClass or file name)."""
        dirs = [os.path.expanduser("~/.local/share/applications"), "/usr/share/applications"]
        for d in dirs:
            try:
                names = sorted(os.listdir(d))
            except OSError:
                continue
            for n in names:
                if not n.endswith(".desktop"):
                    continue
                try:
                    text = open(os.path.join(d, n), errors="ignore").read()
                except OSError:
                    continue
                wm = re.search(r"^StartupWMClass=(.+)$", text, re.M)
                exe = re.search(r"^Exec=(.+)$", text, re.M)
                if exe and ((wm and wm.group(1).strip().lower() == cls.lower())
                            or n[:-8].lower() == cls.lower()):
                    cmd = re.sub(r"\s*%[a-zA-Z]", "", exe.group(1)).strip()
                    return os.path.basename(cmd.split()[0]) + cmd[len(cmd.split()[0]):]
        try:
            return os.path.basename(os.readlink(f"/proc/{pid}/exe"))
        except (OSError, TypeError):
            return cls.lower()

    def add_class(self, cls, pid=None):
        """Put cls on the selected workspace; a class belongs to one workspace only."""
        try:
            re.compile(cls)
        except re.error:
            self.msg = f"not a valid class pattern: {cls}"
            return
        for ws, g in list(self.groups.items()):
            if ws == self.sel:
                continue
            parts = [p for p in g["cls"].split("|") if p != cls]
            if len(parts) != len(g["cls"].split("|")):
                if parts:
                    g["cls"] = "|".join(parts)
                else:
                    del self.groups[ws]
        g = self.groups.get(self.sel)
        if g:
            if cls not in g["cls"].split("|"):
                g["cls"] = f"{g['cls']}|{cls}"
        else:
            name = cls.split(".")[-1].split("-")[-1].capitalize()
            self.groups[self.sel] = {"name": name, "cls": cls, "launch": [self.guess_launch(cls, pid)]}
        self.save(f"{cls} now opens on workspace {self.sel % 10}")

    def edit(self):
        g = self.groups.get(self.sel, {"name": "", "cls": "", "launch": []})
        name = self.prompt("Name:", g["name"])
        if name is None: return
        cls = self.prompt("Window class (regex, a|b for several):", g["cls"])
        if cls is None: return
        launch = self.prompt("Launch (commands separated by ;):", " ; ".join(g["launch"]))
        if launch is None: return
        if not name or not cls:
            self.msg = "name and class are required"
            return
        self.groups[self.sel] = {"name": name, "cls": cls,
                                 "launch": [c.strip() for c in launch.split(";") if c.strip()]}
        self.save(f"saved workspace {self.sel % 10}")

    def run(self):
        while True:
            self.load()
            if self.mode == "pick":
                self.draw_pick()
            else:
                self.draw_main()
            k = read_key(self.fd)
            if self.mode == "pick":
                apps = self.apps()
                if k == "ESC":                       self.mode = "main"
                elif k in ("UP", "k"):               self.pick_sel = max(self.pick_sel - 1, 0)
                elif k in ("DOWN", "j"):             self.pick_sel = min(self.pick_sel + 1, len(apps) - 1)
                elif k in ("\r", "\n") and apps:
                    c = apps[self.pick_sel]
                    self.add_class(c["class"], c.get("pid")); self.mode = "main"
                elif k == "c":
                    cls = self.prompt("Window class:")
                    if cls: self.add_class(cls)
                    self.mode = "main"
                continue
            self.msg = "" if k not in ("",) else self.msg
            if k in ("ESC", "q"):                    return
            elif k in ("UP", "k"):                   self.sel = (self.sel - 2) % 10 + 1
            elif k in ("DOWN", "j"):                 self.sel = self.sel % 10 + 1
            elif k.isdigit():                        self.sel = int(k) or 10
            elif k == "a":                           self.mode, self.pick_sel = "pick", 0
            elif k in ("e", "\r", "\n"):             self.edit()
            elif k == "d" and self.sel in self.groups:
                if self.confirm(f"Remove the {self.groups[self.sel]['name']} group?"):
                    del self.groups[self.sel]
                    self.save(f"removed group from workspace {self.sel % 10}")
            elif k == "l":
                self.msg = "launched" if launch(self.sel, force=True) else "nothing to launch"
            elif k == "g":
                go(self.sel); return
            elif k == "t":
                self.msg = f"moved {tidy()} window(s) to their workspaces"


def ui():
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    sys.stdout.write("\033[?1049h\033[?25l\033[?7l")  # no wrap: clip long lines
    try:
        UI(fd).run()
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\033[?7h\033[?25h\033[?1049l")
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


# ---- entry -------------------------------------------------------------------------------------
def main(argv):
    if not argv or argv[0] == "ui":
        ui()
        return
    if argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, rest = argv[0], argv[1:]
    force = "-f" in rest or "--force" in rest
    background = "--background" in rest
    rest = [a for a in rest if a not in ("-f", "--force", "--background")]
    if cmd == "focus" and rest:
        focus(int(rest[0]))
    elif cmd == "go" and rest:
        go(int(rest[0]))
    elif cmd == "launch" and rest:
        targets = sorted(groups()) if rest[0] == "all" else [int(rest[0])]
        home = (query("activeworkspace") or {}).get("id")
        for ws in targets:
            started = launch(ws, force)
            print(f"workspace {ws}: {'launched' if started else 'already open (use -f)'}")
            if started and background:
                wait_for(ws)
        if background and home:   # the group rules follow new windows; go back to where we were
            dispatch(f'hl.dsp.focus({{ workspace = "{home}" }})')
    elif cmd == "tidy":
        print(f"moved {tidy()} window(s)")
    elif cmd == "list":
        show()
    elif cmd == "bar":
        bar()
    else:
        print(__doc__.strip())
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv[1:])
